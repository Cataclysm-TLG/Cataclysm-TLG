{
  "name": "ctlg-vcpkg-dependencies",
  "version-string": "1.0",
  "port-version": 1,
  "dependencies": [
    { "name": "pdcurses", "version>=": "3.9#4", "platform": "windows" },
    "sdl3",
    { "name": "sdl3-image", "features": [ "jpeg", "png" ] },
    "sdl3-ttf",
    { "name": "sdl3-mixer",
      "features": [ "libflac", "mpg123", "wavpack", "libvorbis" ],
      "default-features": false
    },
    { "name": "glslang", "features": [ "tools" ] },
    "sdl3-shadercross"
  ],
  "builtin-baseline": "a1cae005c39be7b18ba319fced856b68d7276271",
  "vcpkg-configuration": {
    "overlay-ports": [ "../.github/vcpkg_overlay_ports" ]
  }
}
