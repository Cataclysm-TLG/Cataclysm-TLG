msgstr "记下位置。"

#. ~ Response to NPC dialogue
#: data/json/npcs/computers/TALK_COMPUTER.json
msgid "Press any key."
msgstr "请按任意键。"

#. ~ NPC dialogue line
#: data/json/npcs/computers/TALK_COMPUTER.json
