msgstr "甲板涂层"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "forest floor"
msgstr "林地地面"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
