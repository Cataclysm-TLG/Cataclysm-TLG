#: src/player_hardcoded_effects.cpp:380
msgid "You lose some blood."
msgstr "你流了一些血。"

#: src/player_hardcoded_effects.cpp:384
msgid "<npcname> loses some blood."
msgstr "<npcname> 流了一些血。"

#: src/player_hardcoded_effects.cpp:390
msgid "You could reduce the bleeding by emptying your hands and pausing to apply pressure."
msgstr "你可以空出双手并停下来压迫血管来减少出血。"

#: src/player_hardcoded_effects.cpp:393
msgid "You could reduce the bleeding by pausing to apply pressure."
msgstr "你可以停下来压迫血管来减少出血。"

#: src/player_hardcoded_effects.cpp:414
msgid "You feel a little strange."
msgstr "你觉得有点奇怪。"

#: src/player_hardcoded_effects.cpp:418
msgid "The world takes on a dreamlike quality."
msgstr "整个世界就像在梦中一样虚幻。"

#: src/player_hardcoded_effects.cpp:420
msgid "You have a sudden nostalgic feeling."
msgstr "你突然有种怀旧的感觉。"

#: src/player_hardcoded_effects.cpp:422
msgid "Everything around you is starting to breathe."
msgstr "你感觉周围所有的东西都有了呼吸。"

#: src/player_hardcoded_effects.cpp:424
msgid "Something feels very, very wrong."
msgstr "有什么东西特别，特别不对劲。"

#: src/player_hardcoded_effects.cpp:428
msgid "You feel sick to your stomach."
msgstr "你感觉一阵胃痛。"

#: src/player_hardcoded_effects.cpp:436
msgid "\"I think it's starting to kick in.\""
msgstr "\"我想它开始起效了。\""

#: src/player_hardcoded_effects.cpp:437
msgid "\"Oh God, what's happening?\""
msgstr "哦，天啊！发生什么事了？"

#: src/player_hardcoded_effects.cpp:438
msgid "\"Of course… it's all fractals!\""
msgstr "\"当然……全是花花绿绿的！\""

#: src/player_hardcoded_effects.cpp:439
msgid "\"Huh?  What was that?\""
msgstr "\"呃，那是什么？\""

#: src/player_hardcoded_effects.cpp:455
msgid "Fractal patterns dance across your vision."
msgstr "你眼前仿佛有无数万花筒的图案。"

#: src/player_hardcoded_effects.cpp:462
msgid "Dancing fractals distract you."
msgstr "万花筒的图案让你无法集中精力。"

#: src/player_hardcoded_effects.cpp:469
msgid "Everything looks SO boring now."
msgstr "现在这一切都看起来都\"太\"无聊了。"

#: src/player_hardcoded_effects.cpp:471
msgid "Things are returning to normal."
msgstr "所有事物回归平常。"

#: src/player_hardcoded_effects.cpp:515
msgid "Your thoughts are unclear."
msgstr "你的思维开始混乱。"

#: src/player_hardcoded_effects.cpp:517
msgid "Your face is stiff from the cold."
msgstr "你的脸部被冻僵了。"

#: src/player_hardcoded_effects.cpp:519
msgid "You quiver from the cold."
msgstr "你冷的发抖。"

#: src/player_hardcoded_effects.cpp:519
msgid "Your torso is freezing cold.  You should put on a few more layers."
msgstr "你的躯干冻僵了，你需要在身上多穿点。"

#: src/player_hardcoded_effects.cpp:520
msgid "Your shivering makes you unsteady."
msgstr "你的身体不受控制的颤抖着。"

#: src/player_hardcoded_effects.cpp:521 src/player_hardcoded_effects.cpp:522
msgid "Your left arm is shivering."
msgstr "你的左臂正在不停地颤抖。"

#: src/player_hardcoded_effects.cpp:521 src/player_hardcoded_effects.cpp:522
msgid "Your left arm trembles from the cold."
msgstr "你的左臂冷的发抖。"

#: src/player_hardcoded_effects.cpp:523 src/player_hardcoded_effects.cpp:524
msgid "Your right arm is shivering."
msgstr "你的右臂正在不停地颤抖。"

#: src/player_hardcoded_effects.cpp:523 src/player_hardcoded_effects.cpp:524
msgid "Your right arm trembles from the cold."
msgstr "你的右臂冷的发抖。"

#: src/player_hardcoded_effects.cpp:525 src/player_hardcoded_effects.cpp:526
msgid "Your left hand feels like ice."
msgstr "你的左手感觉冰冻刺骨。"

#: src/player_hardcoded_effects.cpp:525 src/player_hardcoded_effects.cpp:526
msgid "Your left hand quivers in the cold."
msgstr "你的左手冻得发抖。"

#: src/player_hardcoded_effects.cpp:527 src/player_hardcoded_effects.cpp:528
msgid "Your right hand feels like ice."
msgstr "你的右手感觉冰冻刺骨。"

#: src/player_hardcoded_effects.cpp:527 src/player_hardcoded_effects.cpp:528
msgid "Your right hand quivers in the cold."
msgstr "你的右手冻得发抖。"

#: src/player_hardcoded_effects.cpp:529 src/player_hardcoded_effects.cpp:530
msgid "Your left leg trembles against the relentless cold."
msgstr "你抖动左腿来对抗严寒。"

#: src/player_hardcoded_effects.cpp:529 src/player_hardcoded_effects.cpp:530 src/player_hardcoded_effects.cpp:531 src/player_hardcoded_effects.cpp:532
msgid "Your legs uncontrollably shake from the cold."
msgstr "你双腿严重冻伤，在不受控制的抖动着。"

#: src/player_hardcoded_effects.cpp:531 src/player_hardcoded_effects.cpp:532
msgid "Your right leg trembles against the relentless cold."
msgstr "你抖动右腿来对抗严寒。"

#: src/player_hardcoded_effects.cpp:533 src/player_hardcoded_effects.cpp:534
msgid "Your left foot feels frigid."
msgstr "你感到左脚冰冷刺骨。"

#: src/player_hardcoded_effects.cpp:533
msgid "Your left foot is as nimble as a block of ice."
msgstr "你的左脚完全冻僵麻木了，有如一大块冰块。"

#: src/player_hardcoded_effects.cpp:534
msgid "Your freezing left foot messes up your balance."
msgstr "你冻僵的左脚让你站立不稳。"

#: src/player_hardcoded_effects.cpp:535 src/player_hardcoded_effects.cpp:536
msgid "Your right foot feels frigid."
msgstr "你感到右脚冰冷刺骨。"

#: src/player_hardcoded_effects.cpp:535
msgid "Your right foot is as nimble as a block of ice."
msgstr "你的右脚完全冻僵麻木了，有如一大块冰块。"

#: src/player_hardcoded_effects.cpp:536
msgid "Your freezing right foot messes up your balance."
msgstr "你冻僵的右脚让你站立不稳。"

#: src/player_hardcoded_effects.cpp:549
msgid "Your head is pounding from the heat."
msgstr "你的头部感到一阵阵热流冲击。"

#: src/player_hardcoded_effects.cpp:551
msgid "You are sweating profusely."
msgstr "你满头大汗。"

#: src/player_hardcoded_effects.cpp:553 src/player_hardcoded_effects.cpp:554
msgid "Your left hand's too sweaty to grip well."
msgstr "你的左手汗水太多，让你握不住东西了。"

#: src/player_hardcoded_effects.cpp:555 src/player_hardcoded_effects.cpp:556
msgid "Your right hand's too sweaty to grip well."
msgstr "你的右手汗水太多，让你握不住东西了。"

#: src/player_hardcoded_effects.cpp:557
msgid "Your left leg is cramping up."
msgstr "你的左腿抽筋了。"

#: src/player_hardcoded_effects.cpp:559
msgid "Your right leg is cramping up."
msgstr "你的右腿抽筋了。"

#: src/player_hardcoded_effects.cpp:561
msgid "Your left foot is swelling in the heat."
msgstr "你的左脚感到很热。"

#: src/player_hardcoded_effects.cpp:563
msgid "Your right foot is swelling in the heat."
msgstr "你的右脚感到很热。"

#: src/player_hardcoded_effects.cpp:582
msgid "The heat is making you see things."
msgstr "你热得看到了幻觉。"

#: src/player_hardcoded_effects.cpp:591 src/player_hardcoded_effects.cpp:592
msgid "You have trouble grasping with your numb fingers."
msgstr "你冻僵的手指造成你抓握非常困难。"

#: src/player_hardcoded_effects.cpp:593 src/player_hardcoded_effects.cpp:594 src/player_hardcoded_effects.cpp:595 src/player_hardcoded_effects.cpp:596
msgid "Your foot has gone numb."
msgstr "你的脚感到麻木。"

#: src/player_hardcoded_effects.cpp:597 src/player_hardcoded_effects.cpp:598
msgid "Your face feels numb."
msgstr "你的面部感到麻木。"

#: src/player_hardcoded_effects.cpp:626
msgid "Glowing lights surround you, and you teleport."
msgstr "几道光芒在你身边闪烁，你被传送了。"

#: src/player_hardcoded_effects.cpp:655 src/player_hardcoded_effects.cpp:716 src/player_hardcoded_effects.cpp:1333
msgid "A monster appears nearby!"
msgstr "有敌对生物出现在附近！"

#: src/player_hardcoded_effects.cpp:656
msgid "Space folds impossibly around itself!"
msgstr "空间不可思议地在自我折叠！"

#: src/player_hardcoded_effects.cpp:666 src/player_hardcoded_effects.cpp:726
msgid "You shudder suddenly."
msgstr "你突然颤抖。"

#: src/player_hardcoded_effects.cpp:682
msgid "You pass out."
msgstr "你失去了意识。"

#: src/player_hardcoded_effects.cpp:717 src/player_hardcoded_effects.cpp:1334
msgid "A portal opens nearby, and a monster crawls through!"
msgstr "一道传送门在你附近开启了，一个怪物从中爬了出来！"

#: src/player_hardcoded_effects.cpp:741
msgid "Your vision is filled with bright lights…"
msgstr "你的视野内充满了亮光……"

#: src/player_hardcoded_effects.cpp:757
msgid "You're suddenly covered in ectoplasm."
msgstr "你突然被一层灵能物质所覆盖。"

#: src/player_hardcoded_effects.cpp:792
msgid "You're experiencing loss of basic motor skills and blurred vision.  Your mind recoils in horror, unable to communicate with your spinal column."
msgstr "你感到肌肉无力与视觉模糊，你的意识被巨大的恐惧淹没，完全不知所措，无法和脊柱沟通。"

#: src/player_hardcoded_effects.cpp:793
msgid "You stagger and fall!"
msgstr "你失足跌倒！"

#: src/player_hardcoded_effects.cpp:808
msgid "There's some kind of big machine in the sky."
msgstr "天空出现一些巨大的飞行器。（注：《赌城风情画》，1998）"

#: src/player_hardcoded_effects.cpp:811
msgid "It's some kind of electric snake, coming right at you!"
msgstr "像是一条电蛇一样，向我们直奔过来！（注：《赌城风情画》，1998）"

#: src/player_hardcoded_effects.cpp:818
msgid "Order us some golf shoes, otherwise we'll never get out of this place alive."
msgstr "要一些高尔夫球鞋，否则我们不能活着离开这个地方了。（注：《赌城风情画》，1998）"

#: src/player_hardcoded_effects.cpp:822
msgid "The possibility of physical and mental collapse is now very real."
msgstr "身理和心理崩溃的可能性，现在已经很真实了。（注：《赌城风情画》，1998）"

#: src/player_hardcoded_effects.cpp:824
msgid "No one should be asked to handle this trip."
msgstr "没有一个人能处理我们这一次的行程。（注：《赌城风情画》，1998）"

#: src/player_hardcoded_effects.cpp:834
msgid "Your heart spasms painfully and stops, dragging you back to reality as you die."
msgstr "你的心脏痛苦地痉挛……之后，停止了跳动，让你不得不接受你即将死亡的现实。"

#: src/player_hardcoded_effects.cpp:837
msgid "You dissolve into beautiful paroxysms of energy.  Life fades from your nebulae and you are no more."
msgstr "你融化到了这份美丽而温暖的能量之中。生命在你身上逐渐消逝，你不再存在了。"

#: src/player_hardcoded_effects.cpp:859
msgid "You bleed to death!"
msgstr "你流血至死了!"

#: src/player_hardcoded_effects.cpp:860
msgid "<npcname> bleeds to death!"
msgstr "<npcname> 流血至死了!"

#: src/player_hardcoded_effects.cpp:865
msgid "Your heart can't keep up the pace and fails!"
msgstr "你的心脏供血不足，引发了心力衰竭！"

#: src/player_hardcoded_effects.cpp:866
msgid "<npcname> has a sudden heart attack!"
msgstr "<npcname> 突然心脏病发作！"

#: src/player_hardcoded_effects.cpp:892
msgid "Your skin looks pale and you feel anxious and thirsty.  Blood loss?"
msgstr "你看起来皮肤苍白并感到口渴焦躁。失血过多？"

#: src/player_hardcoded_effects.cpp:894
msgid "Your pale skin is sweating, your heart is beating fast, and you feel restless.  Maybe you lost too much blood?"
msgstr "你皮肤发白、不断出汗、心跳加速并感到一阵阵心慌。也许你失血过多？"

#: src/player_hardcoded_effects.cpp:896
msgid "You're unsettlingly white, but your fingertips are bluish.  You are agitated and your heart is racing.  Your blood loss must be serious."
msgstr "你的脸色苍白得令人不安，但你的指尖有些青紫。你焦躁不安，心跳加速。你的失血一定很严重。"

#: src/player_hardcoded_effects.cpp:898
msgid "You are pale as a ghost, dripping wet from the sweat, and sluggish - despite your heart racing like a train.  You are on the brink of collapse from the effects of blood loss."
msgstr "你脸色苍白，大汗淋漓。尽管你的心脏像火车一样急速跳动，但你却感觉自己很迟钝。你正因失血过多而处于昏迷的边缘。"

#: src/player_hardcoded_effects.cpp:906
msgid "You feel dizzy and lightheaded."
msgstr "你觉得头昏眼花。"

#: src/player_hardcoded_effects.cpp:910
msgid "You feel tired and you breathe heavily."
msgstr "你感到十分疲倦，呼吸沉重。"

#: src/player_hardcoded_effects.cpp:915
msgid "You are anxious and cannot collect your thoughts."
msgstr "你感到十分焦躁，无法集中精神。"

#: src/player_hardcoded_effects.cpp:919
msgid "You are sweating profusely, but you feel cold."
msgstr "你满头大汗，却感到浑身发冷。"

#: src/player_hardcoded_effects.cpp:928
msgid "You huff and puff.  Your breath is rapid and shallow."
msgstr "你气喘吁吁。你的呼吸又急又浅。"

#: src/player_hardcoded_effects.cpp:933
msgid "You drop to the ground, fighting to keep yourself conscious."
msgstr "你摔倒在地上，挣扎着保持清醒。"

#: src/player_hardcoded_effects.cpp:937
msgid "Your mind slips away."
msgstr "你的思维模糊了。"

#: src/player_hardcoded_effects.cpp:968
msgid "You cannot breathe and your body gives out!"
msgstr "你无法呼吸，你的身体衰竭了！"

#: src/player_hardcoded_effects.cpp:969
msgid "<npcname> gasps for air and dies!"
msgstr "<npcname> 喘不过气而死了！"

#: src/player_hardcoded_effects.cpp:977
msgid "Your extremities feel unusually cold."
msgstr "你的双脚感到异常寒冷。"

#: src/player_hardcoded_effects.cpp:984
msgid "Your skin looks very pale."
msgstr "你的皮肤看起来很苍白。"

#: src/player_hardcoded_effects.cpp:987
msgid "You feel weak."
msgstr "你在梦中感到十分温暖。"

#: src/player_hardcoded_effects.cpp:990
msgid "You really want to just sit and do nothing for a while."
msgstr "在这个新世界里，你的治愈速度和大多数人一样快。"

#: src/player_hardcoded_effects.cpp:993
msgid "You're having trouble catching your breath."
msgstr "你们有食物问题吗？"

#: src/player_hardcoded_effects.cpp:1008
msgid "You feel dizzy!"
msgstr "你觉得头昏眼花。"

#: src/player_hardcoded_effects.cpp:1012
msgid "Your weakness gives way to tremors."
msgstr "你的武器是个低贱的叛徒！"

#: src/player_hardcoded_effects.cpp:1016
msgid "You have the strangest craving for ice."
msgstr "你的相机焦距不对。"

#: src/player_hardcoded_effects.cpp:1019
msgid "Your whole mouth feels sore, and your tongue is swollen."
msgstr "你整个嘴都很酸痛，舌头也肿了。"

#: src/player_hardcoded_effects.cpp:1022
msgid "You feel lightheaded, and a headache pounds in your temples."
msgstr "你感到腹部灼热，嘴中反酸。"

#: src/player_hardcoded_effects.cpp:1035
msgid "Your legs are restless.  The urge to move them is so strong."
msgstr "你的双腿坐立不安。想要走动的冲动非常强烈。"

#: src/player_hardcoded_effects.cpp:1038
msgid "You feel drained of life, you just want to lie down."
msgstr "你感到生活被耗尽，你只想躺下来。"

#: src/player_hardcoded_effects.cpp:1042
msgid "You gasp for air!"
msgstr "你喘不过气来。"

#: src/player_hardcoded_effects.cpp:1047
msgid "Can't breathe.  Must rest."
msgstr "没法呼吸。必须休息一会。"

#: src/player_hardcoded_effects.cpp:1052
msgid "You can't take it any more.  Rest first; everything else later."
msgstr "你再也受不了了。先休息一下，其他的事以后再说。"

#: src/player_hardcoded_effects.cpp:1057
msgid "You must sit down for a moment.  Just a moment."
msgstr "你必须坐下来休息一会儿。就一会。"

#: src/player_hardcoded_effects.cpp:1097
msgid "You feel well rested."
msgstr "你觉得精神焕发。"

#: src/player_hardcoded_effects.cpp:1100
msgid "You feel physically rested, but you haven't been able to catch up on your missed sleep yet."
msgstr "你感觉身体已经得到了休息，但还没有补足之前所缺乏的睡眠。"

#: src/player_hardcoded_effects.cpp:1158 src/player_hardcoded_effects.cpp:1167 src/player_hardcoded_effects.cpp:1174
msgid "It's too bright to sleep."
msgstr "太亮了，无法入眠。"

#: src/player_hardcoded_effects.cpp:1182
#, c-format
msgid "You see %s approaching!"
msgstr "你看到 %s 正在逼近！"

#: src/player_hardcoded_effects.cpp:1200
msgid "You toss and turn trying to keep warm."
msgstr "你辗转反侧，试图保暖。"

#: src/player_hardcoded_effects.cpp:1204
msgid "It's too cold to sleep."
msgstr "你感到太冷了，无法睡眠。"

#: src/player_hardcoded_effects.cpp:1212
msgid "You toss and turn in the heat."
msgstr "你热得辗转反侧。"

#: src/player_hardcoded_effects.cpp:1216
msgid "It's too hot to sleep."
msgstr "你感到太热了，无法睡眠。"

#: src/player_hardcoded_effects.cpp:1284
#, c-format
msgid "You start scratching your %s."
msgstr "你开始疯狂抓挠自己的 %s！"

#: src/player_hardcoded_effects.cpp:1287
#, c-format
msgid "%1$s starts scratching their %2$s."
msgstr "%1$s 开始疯狂抓挠自己的 %2$s！"

#: src/player_hardcoded_effects.cpp:1309
msgid "Why waste your time on that insignificant speck?"
msgstr "为什么要把你的时间浪费在这个不起眼的斑点上？"

#: src/player_hardcoded_effects.cpp:1341
msgid "Too fast.  You're too fast!  Everything's too fast!"
msgstr "太快了。你太快了！一切东西都太快了！"

#: src/player_hardcoded_effects.cpp:1343
msgid "You feel paranoid."
msgstr "你感觉有点偏执。"

#: src/player_hardcoded_effects.cpp:1348 src/player_hardcoded_effects.cpp:1452
msgid "You can't stop clenching your jaw."
msgstr "你不能移动你的%s。"

#: src/player_hardcoded_effects.cpp:1352
msgid "The bugs are back."
msgstr "这里的真菌萎缩死亡了。"

#: src/player_hardcoded_effects.cpp:1354
msgid "It feels like there are tiny bugs crawling over your body."
msgstr "你感觉似乎眼里进了沙子。"

#: src/player_hardcoded_effects.cpp:1363
msgid "You are beset by a vision of a prowling beast."
msgstr "一只潜行的怪兽的异象困扰着你。"

#: src/player_hardcoded_effects.cpp:1365
msgid "Something is tracking you from a direction you can't perceive."
msgstr "有东西从你无法感知的方向跟踪你。"

#: src/player_hardcoded_effects.cpp:1368
msgid "Something stalks you across the angles of spacetime.  It will come from the corners!"
msgstr "有东西穿过时空的角度跟踪你。  它将来自角落！"

#: src/player_hardcoded_effects.cpp:1373
msgid "Your surroundings are permeated with a foul scent."
msgstr "你的周围弥漫着一股难闻的气味。"

#: src/player_hardcoded_effects.cpp:1380
msgid "Your asthma attack stops."
msgstr "你的哮喘停止发作了。"

#: src/player_hardcoded_effects.cpp:1383
msgid ""
"Your asthma overcomes you.\n"
"You asphyxiate."
msgstr ""
"你的哮喘击垮了你。\n"
"你窒息而死。"

#: src/player_hardcoded_effects.cpp:1388
msgid "You wheeze and gasp for air."
msgstr "你努力的呼吸着空气，发出呼啦呼啦的哮喘声。"

#: src/player_hardcoded_effects.cpp:1393
msgid "Your head aches faintly."
msgstr "你的头隐隐作痛。"

