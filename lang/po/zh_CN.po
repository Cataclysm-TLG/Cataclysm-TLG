#. ~ Foot steps of species "SLIME"
#: data/json/species.json
msgid "plop."
msgstr "扑通声。"

#. ~ Foot steps of species "WORM"
#: data/json/species.json
msgid "rustle."
msgstr "地下摩擦声。"

#. ~ Foot steps of species "NETHER_BURROWING"
#: data/json/species.json
msgid "rustling"
msgstr "锈蚀的"

#. ~ Foot steps of species "ZOMBIE"
#. ~ Foot steps of species "FERAL"
#: data/json/species.json data/mods/classic_zombies/monsters/species.json
msgid "shuffling."
msgstr "蹒跚蹭地声。"

#. ~ Foot steps of species "CENTIPEDE"
#: data/json/species.json
msgid "skittering."
msgstr "匆匆爬行声。"

#. ~ Foot steps of species "KRAKEN"
#: data/json/species.json
msgid "slithering."
msgstr "滑行声。"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Affirmative.\""
msgstr "\"收到。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"And that's supposed to comfort me?\""
msgstr "\"你觉得这能够安慰我吗？\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"And what if all the backups fail?\""
msgstr "\"那如果所有的备用发电机都失效了呢？\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Anything else?\""
msgstr "\"还有别的吗？\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you alone?\""
msgstr "\"你单身吗？\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you busy at the moment?\""
msgstr "\"你现在忙不？\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you busy later?\""
msgstr "\"过会你忙吗？\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you busy tonight?\""
msgstr "\"今晚你忙吗？\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you feeling all right?\""
msgstr "\"你没事吧？\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you free tonight?\""
msgstr "\"今晚你有空吗？\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you going to help them?\""
msgstr "\"你打算帮它们？\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you going to the party tonight?\""
msgstr "\"今晚你去派对吗？\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you hungry?\""
msgstr "\"你饿吗？\""

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor,
#. mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Are you my mommy?\""
msgstr "\"你是妈妈吗？\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you seeing anyone?\""
msgstr "\"看见其他人了么？\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you sure?\""
msgstr "\"你确定？\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Area nineteen has a few in cold storage.\""
msgstr "\"十九区里有几只被放在冷库里。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"At least we know they can die.\""
msgstr "\"起码我们知道它们也会死。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Be careful out there.\""
msgstr "\"外出小心。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Be quiet.\""
msgstr "\"安静！\""

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Big Brother is watching you…\""
msgstr "\"老大哥正在看着你……\""

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor,
#. mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Blood… delicious.\""
msgstr "\"鲜血……美味。\""

#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go,
#. mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Burning… from the inside…\""
