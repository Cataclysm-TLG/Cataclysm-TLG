#: src/monattack.cpp:3534
msgid "\"Stop it please.\""
msgstr "\"请停下来。\""

#: src/monattack.cpp:3537
msgid "\"Let us help you.\""
msgstr "\"让我们帮你吧。\""

#: src/monattack.cpp:3540
msgid "\"We wish you no harm.\""
msgstr "\"希望你没有恶意。\""

#: src/monattack.cpp:3543
msgid "\"Do not fear.\""
msgstr "\"别害怕。\""

#: src/monattack.cpp:3546
msgid "\"We can help you.\""
msgstr "\"我们能帮你。\""

#: src/monattack.cpp:3549
msgid "\"We are friendly.\""
msgstr "\"让我们友好相处。\""

#: src/monattack.cpp:3552
msgid "\"Please don't.\""
msgstr "\"请别这样。\""

