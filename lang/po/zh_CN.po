#. ~ Description of vehicle part ""
#: data/json/vehicleparts/rotor.json
msgid "A set of aerofoil helicopter rotors, when spun at high speed, they generate thrust via lift."
msgstr "一套旋翼型直升机旋翼桨叶，通过高速旋转，提供升力和推力。"

#. ~ Description of vehicle part "heavy-duty military rotors"
#. ~ Description of vehicle part "small helicopter rotors"
#: data/json/vehicleparts/rotor.json
msgid "A set of four military-grade helicopter rotor blades, used to provide lift by rotation."
msgstr "一套四翼军用级直升机旋翼桨叶，通过高速旋转，提供升力和推力。"

#. ~ Description of vehicle part "heavy-duty military Osprey rotors"
#: data/json/vehicleparts/rotor.json
msgid "A set of three military-grade helicopter rotor blades, used to provide lift by rotation."
msgstr "一套三翼军用级直升机旋翼桨叶，通过高速旋转，提供升力和推力。"

#. ~ Vehicle part name
#: data/json/vehicleparts/rotor.json
msgid "heavy-duty military Blackhawk rotors"
msgstr "重型军用黑鹰直升机旋翼"

#. ~ Vehicle part name
#: data/json/vehicleparts/rotor.json
msgid "heavy-duty military Osprey rotors"
msgstr "重型军用鱼鹰直升机旋翼"

#. ~ Vehicle part name
