#: data/json/item_spell_effects.json
msgid "Creates a short-lived inflatable."
msgstr "创造出一个持续时间很短的充气玩具。"

#. ~ Description of spell "Debug Kill Creature"
#: data/json/item_spell_effects.json
#, c-format
msgid "Deal damage equal to 100% of monster's HP."
msgstr "造成相当于怪物生命值 100% o 的伤害。"

#. ~ Spell name
#: data/json/item_spell_effects.json
msgid "Debug Kill Creature"
msgstr "调试杀死生物"

#. ~ Spell name
#: data/json/item_spell_effects.json
msgid "Fog Ex Machina"
msgstr "造雾机"

#. ~ Spell name
#: data/json/item_spell_effects.json
msgid "Inflatable Dragon"
msgstr "充气龙"

#. ~ Spell name
#: data/json/item_spell_effects.json
msgid "Inflatable Ghost"
msgstr "充气幽灵"

#. ~ Description of spell "Fog Ex Machina"
#: data/json/item_spell_effects.json
msgid "You see fog bubbling out of the device."
msgstr "你看到雾气从设备里冒出来。"

#. ~ Item name
#: data/json/items/ammo.json
msgid "120mm HEAT"
msgid_plural "120mm HEAT"
msgstr[0] "120mm 破甲弹"

#. ~ Description of "120mm HEAT"
#: data/json/items/ammo.json
msgid "A 120mm high-explosive anti-tank round.  It could ruin anyone's whole day."
msgstr ""
"一枚120mm破甲弹。它能结束任何人悲催的一生。\n"
"\"真男人从不回头看爆炸。\""

#. ~ Description of "albuterol"
#: data/json/items/ammo.json
msgid "A bronchodilator that relaxes muscles in the airways and increases air flow to the lungs."
msgstr "学名为沙丁胺醇，属于支气管扩张剂，能使呼吸道的肌肉放松并增加流入肺部的空气量。"

#. ~ Description of "solid hydrogen canister"
#: data/json/items/ammo.json
msgid "A canister of pressurized hydrogen so heavily compressed it has turned solid.  With proper equipment, it could be heated into plasma."
msgstr "一罐被加压成固态的氢气。用合适的设备可以将其加热成等离子态发射出去。"

#. ~ Description of "chunk of rubber"
#: data/json/items/ammo.json
msgid "A chunk of useful rubber that can be molded easily."
msgstr "一块用途广泛的易塑型橡胶。"

#. ~ Description of "soap bar"
#: data/json/items/ammo.json
msgid "A cleansing agent shaped into a bar."
msgstr ""
"一份切成条的肥皂，可以用来清洗衣物或者制作其他物品。\n"
"\"哎呀，我的肥皂掉了，能帮我捡一下吗？\""

#. ~ Description of "butane"
#: data/json/items/ammo.json
msgid "A common flammable liquid, used in lighters."
msgstr "一种用于打火机的常见的易燃液体。"

#. ~ Description of "moisturizer"
#: data/json/items/ammo.json
msgid "A cosmetic preparation used for protecting, moisturizing, and lubricating the skin."
msgstr "一种用于保护、保湿和润滑皮肤的化妆品。"

#. ~ Description of "extinguishing agent"
#: data/json/items/ammo.json
msgid "A dry chemical solution effective at extinguishing fires."
msgstr "一种能够有效灭火的干粉状化学溶剂。"

#. ~ Description of "feather"
#: data/json/items/ammo.json
msgid "A feather from a bird.  Useful for fletching arrows."
msgstr "一根禽类的羽毛，可以用来制作箭矢。"

#. ~ Description of "charcoal"
#: data/json/items/ammo.json
msgid "A flammable carbon-based material produced by slowly burning wood.  Utilized in recipes requiring a pure, hot flame.  Can also be used in filters to remove contaminants from air and water."
msgstr "一种易燃的碳基材料，由缓慢燃烧的木材产生。可以在制造中提供纯净的高温火焰，也可用于过滤空气和水中的污染物。"

#. ~ Description of "down feather"
#: data/json/items/ammo.json
msgid "A fluffy down feather from a bird.  Useful for making cozy bedclothes."
msgstr "一根禽类的羽绒，可用于制作舒适的床上用品。"

#. ~ Description of "marble"
#: data/json/items/ammo.json
msgid "A glass marble, useful as ammunition for a slingshot."
msgstr "一颗玻璃弹珠，很适合当弹弓的弹药。"

#. ~ Description of "fish bait"
#: data/json/items/ammo.json
msgid "A handful of bait, used in traps to lure fish."
msgstr ""
"一把鱼饵，用来放在捕鱼用具里捕鱼。\n"
"\"无法吸引一个宝箱。\""

#. ~ Description of "raw copper wire"
#: data/json/items/ammo.json
msgid "A length of copper wire ready to be covered with plastic."
msgstr "一段准备好被用塑料胶皮覆盖的裸铜线。"

#. ~ Description of "copper wire"
#: data/json/items/ammo.json
msgid "A length of plastic-jacketed copper cable, of the type used in small electronics."
msgstr "一段包裹着塑料外皮的铜芯电线，常用于小型电子设备中。"

#. ~ Description of "yarn"
#: data/json/items/ammo.json
msgid "A length of wool yarn that could be used to knit wool clothing."
msgstr "一团可用于编织羊毛衣物的羊毛纱线。"

#. ~ Description of "gas mask cartridge"
#. ~ Description of magazine "gas mask cartridge"
#: data/json/items/ammo.json data/json/items/magazine/filter.json
msgid "A medium-sized, replaceable filter cartridge for an air filtration mask."
msgstr "一个防毒面具使用的中型滤芯。"

#. ~ Description of "metal RPG die"
#: data/json/items/ammo.json
msgid "A metal die used to play various role-playing games."
msgstr "一个用来玩各类桌游的金属骰子。"

#. ~ Description of "glowstick juice"
#: data/json/items/ammo.json
msgid "A mix of blue dye, base catalyst, and diphenyl oxalate used in glowsticks."
msgstr "一种由蓝色染料、碱性催化剂和草酸二苯酯组成的混合物，用于荧光棒。"

#. ~ Description of "nitrox"
#: data/json/items/ammo.json
msgid "A mixture of oxygen and nitrogen in proportions suitable for sustaining divers."
msgstr "一种氧气和氮气的混合物，其比例适合潜水员维持生命。"

#. ~ Description of "notch"
#: data/json/items/ammo.json
msgid "A notch used with a fire drill to create an ember."
msgstr "火种凹槽，对准凹槽使用钻木取火器就可以生火了。"

#. ~ Description of "tear gas spray"
#: data/json/items/ammo.json
msgid "A noxious aerosolized irritant used to fend off attackers both human and bear alike."
msgstr "雾化的有毒刺激性液体，用来驱赶像人和熊这样的大体型入侵者。"

#. ~ Description of "pebble"
#: data/json/items/ammo.json
msgid "A palm-sized stone about the right shape to be used as ammunition for a sling."
msgstr "一块巴掌大的石头，形状刚好适合用作投石索的弹药。"

#. ~ Description of "RPG die"
#: data/json/items/ammo.json
msgid "A plastic die used to play various role-playing games."
msgstr "一个用来玩各类桌游的塑料骰子。"

#. ~ Description of "liquid bandage"
#: data/json/items/ammo.json
msgid "A polymer dissolved in solvent, with antiseptic added, for topical treatment of minor cuts and scrapes."
msgstr "一种溶解在溶剂中并添加了防腐剂的聚合物，用于局部治疗轻微割伤和擦伤。"

#. ~ Description of "RA10K stimulant module"
#: data/json/items/ammo.json
msgid "A pressurized multi-chamber glass vial filled with powerful chemical stimulants which can only be activated by a Rivtech stimulant delivery system."
msgstr "一个具有数个单独内腔、装满了强力兴奋剂的加压玻璃瓶。里面的兴奋剂只能用Rivtech公司专用的注射器来激活使用。"

#. ~ Description of "large pistol primer"
#: data/json/items/ammo.json
msgid "A primer from a large-caliber pistol round."
msgstr "一些大口径手枪子弹使用的底火。"

#. ~ Description of "large rifle primer"
#: data/json/items/ammo.json
msgid "A primer from a large-caliber rifle round."
msgstr "一些大口径步枪子弹使用的底火。"

#. ~ Description of "shotgun primer"
#: data/json/items/ammo.json
msgid "A primer from a shotgun shell."
msgstr "一些霰弹所使用的子弹底火。"

#. ~ Description of "small pistol primer"
#: data/json/items/ammo.json
msgid "A primer from a small-caliber pistol round."
msgstr "一些小口径手枪子弹使用的底火。"

#. ~ Description of "small rifle primer"
#: data/json/items/ammo.json
msgid "A primer from a small-caliber rifle round."
msgstr "一些小口径步枪子弹使用的底火。"

#. ~ Description of "flare pyrotechnic"
#: data/json/items/ammo.json
msgid "A pyrotechnic chemical used in flares."
msgstr "照明弹中使用的燃烧时产生强烈发光效应的烟火药剂。"

#. ~ Description of "duct tape"
#: data/json/items/ammo.json
msgid "A roll of incredibly strong tape.  Its uses are innumerable."
msgstr "一卷十分牢固的强力胶带。用途非常广泛。"

#. ~ Description of "medical tape"
#: data/json/items/ammo.json
msgid "A roll of semi-opaque medical tape, intended to hold bandages in place.  Not as versatile as duct tape."
msgstr "一卷半透明的医用胶带，用于固定绷带。不如强力胶带万能。"

#. ~ Description of "rubber slug"
#: data/json/items/ammo.json
msgid "A rubber slug from a shotgun beanbag round.  You could use it to make a new beanbag round."
msgstr ""
"一些从霰弹沙包弹里拆出来的橡胶弹头，用来制造暴力镇压示威分子们的新沙包弹。\n"
"\"大灾变前维持人类社会公序良俗的必备品。\""

#. ~ Description of "chainmail link"
#: data/json/items/ammo.json
msgid "A set of small metal rings, suitable for constructing chainmail."
msgstr "一串小型金属锁链，可以用来制造锁环甲。"

#. ~ Description of "aluminum foil"
#: data/json/items/ammo.json
msgid "A sheet of thin foil made of aluminum.  Sometimes called 'tin foil' due to being made of tin in the past."
msgstr "一片由铝制成的箔纸。由于过去是用锡做的，有时被人称为\"锡箔\"。"

#. ~ Description of "thread"
#: data/json/items/ammo.json
msgid "A small quantity of thread that could be used for sewing."
msgstr "一小团可用于缝纫的细线。"

#. ~ Description of "BB"
#: data/json/items/ammo.json
msgid "A small steel ball that can be fired from a BB gun.  Deals virtually no damage."
msgstr "一颗BB枪用的小钢球。没什么杀伤力。"

#. ~ Description of "match"
#: data/json/items/ammo.json
msgid "A small stick with a red part at the end.  Strike it against a matchbook to light it."
msgstr "一根红头小木棍。在火柴盒上划一下可以点燃它。"

#. ~ Description of "filter mask cartridge"
#: data/json/items/ammo.json
msgid "A small, replaceable filter cartridge for an air filtration mask."
msgstr "一个过滤面罩使用的小型滤芯。"

#. ~ Description of "candle wax"
#: data/json/items/ammo.json
msgid "A solid flammable substance, used to make candles."
msgstr "一种用于制作蜡烛的固体易燃物质。"

#. ~ Description of "ball bearing"
#: data/json/items/ammo.json
msgid "A steel ball bearing, useful as ammunition for a slingshot."
msgstr "一颗钢制的滚珠轴承，很适合当弹弓的弹药。"

#. ~ Description of "rock"
#: data/json/items/ammo.json
msgid "A stone about the size of a baseball."
msgstr "一块棒球大小的石头。"

#. ~ Description of "rolling paper"
#: data/json/items/ammo.json
msgid "A thin paper strip intended for the rolling of cigarettes or other smokeables."
msgstr "一种用于卷制香烟或其他可吸烟物品的薄纸条。"

#. ~ Description of "air rifle hunting pellet"
#: data/json/items/ammo.json data/mods/Generic_Guns/ammo/rifle_pellet.json
msgid "A tin of small cone-shaped pellets meant to be used in an air rifle.  Suitable for hunting small game."
msgstr "一罐用于气步枪的圆锥形小弹丸，一般用于狩猎小型动物。"

#. ~ Description of "air rifle target pellet"
#: data/json/items/ammo.json data/mods/Generic_Guns/ammo/rifle_pellet.json
msgid "A tin of small cone-shaped pellets meant to be used in an air rifle.  Suitable for plinking."
msgstr "一罐用于气步枪的圆锥形小弹丸，一般用于娱乐射击。"

#. ~ Description of "RA21E medical ampoule"
#: data/json/items/ammo.json
msgid "A tiny glass vial filled with advanced fast-healing chemicals which can only be activated by a Rivtech jet injector device.  The packaged instructions describe its efficacy in dealing with infections, wounds, intoxications, envenomations, and general tiredness in enthusiastic detail.  A short safety section at the end warns - in much smaller typeface - against using more than two doses per hour."
msgstr "一个装满了帮助伤口快速愈合的先进化合物的小玻璃瓶，必须和Rivtech公司专用的注射器配合使用。包装说明详细介绍了它在处理感染、伤口、中毒、毒液螫入和一般疲劳等方面的功效。最后的安全警告部分用更小的字体简短的写着\"不要每小时使用超过两剂\"。"

#. ~ Description of "sinew"
#: data/json/items/ammo.json
msgid "A tough sinew cut from a corpse, usable as thread."
msgstr "一小段从尸体上截下来的筋腱，可作为缝衣线使用。"

#. ~ Description of "cent"
#: data/json/items/ammo.json
msgid "A unit of currency equivalent to 0.01 US dollars."
msgstr "等效于0.01美元的货币单位。"

#. ~ Description of "insecticidal gas"
#: data/json/items/ammo.json
msgid "Aerosolized pesticides formulated to kill all sorts of arthropods."
msgstr "气雾型杀虫剂，专用于消灭各类节肢动物。"

#. ~ Description of "clay sling bullet"
#: data/json/items/ammo.json
msgid "An oblong piece of hardened clay, designed for use as sling ammunition."
msgstr "一块椭圆形的硬化黏土块，专为投石索弹药而设计。"

#. ~ Description of "lead sling bullet"
#: data/json/items/ammo.json
msgid "An oblong piece of lead, designed for use as sling ammunition.  As sling ammo goes, these are about as accurate as it gets, and in the right hands can be surprisingly effective."
msgstr "一块椭圆形的铅块，专为投石索弹药而设计。在投石索弹药中，这种弹丸的精度算是顶级的，在合适的人手中能发挥出惊人的威力。"

#. ~ Item name
#: data/json/items/ammo.json
msgid "BB"
msgid_plural "BBs"
msgstr[0] "BB弹"

#. ~ Description of "black pen ink"
#: data/json/items/ammo.json
msgid "Carbon black pigment infused with polymers, stabilizers, and water to help the ink flow properly."
msgstr "一些碳黑颜料，加入了聚合物、稳定剂和水以帮助油墨正常流动。"

#. ~ Description of "green pen ink"
#: data/json/items/ammo.json
msgid "Chlorophyll pigment infused with polymers, stabilizers, and water to help the ink flow properly."
msgstr "一些绿色颜料，加入了聚合物、稳定剂和水以帮助油墨正常流动。"

#. ~ Description of "hydrogen"
#: data/json/items/ammo.json
msgid "Compressed hydrogen."
msgstr "高压氢气。"

#. ~ Description of "oxygen"
#: data/json/items/ammo.json
msgid "Compressed medical oxygen."
msgstr "医用高压氧气。"

#. ~ Description of "nitrogen"
#: data/json/items/ammo.json
msgid "Compressed nitrogen."
msgstr "高压氮气。"

#. ~ Description of "radioisotope thermoelectric generator"
#: data/json/items/ammo.json
msgid "Did your neighbors brag about their cool beta-decay-powered nightlights?  Do them one better!  The CuppaTech 4 radioisotope thermoelectric generator is a three kilogram chunk of metal - mostly lead - with a slug of cerium-244 encased within.  It is capable of generating somewhere between 100-150 Watts of thermal energy, although its electrical generation capacity is minimal at only 2 Watts.  Careful!  Curium is great at making heat, and also releases deadly gamma radiation.  Keep away from cellular life forms."
msgstr "你的邻居有没有向你吹嘘他们那炫酷的贝塔衰变原子灯？我们能做得更好！CuppaTech 4型放射性同位素热能发电机是一块三千克重的金属，大部分是铅，内部包裹着一段锔-244。它能够产生100-150瓦的热能，但发电功率只有2瓦。小心！锔除了会释放出大量热量，也会释放致命的伽马射线，把它放置在远离生物的地方。"

#. ~ Description of "red pen ink"
#: data/json/items/ammo.json
msgid "Eosin dye infused with polymers, stabilizers, and water to help the ink flow properly."
msgstr "一些曙红颜料，加入了聚合物、稳定剂和水以帮助油墨正常流动。"

#. ~ Description of "smokeless overbore rifle powder"
#: data/json/items/ammo.json
msgid "Firearm-quality gunpowder intended for use in large rifle ammunition."
msgstr "火器级品质的火药，可以用于制造大口径步枪弹药。"

#. ~ Description of "smokeless magnum powder"
#: data/json/items/ammo.json
msgid "Firearm-quality gunpowder intended for use in magnum pistol ammunition."
msgstr "火器级品质的火药，可以用于制造马格南手枪弹药。"

#. ~ Description of "smokeless pistol powder"
#: data/json/items/ammo.json
msgid "Firearm-quality gunpowder intended for use in pistol ammunition."
msgstr "火器级品质的火药，可以用于制造手枪弹药。"

#. ~ Description of "smokeless rifle powder"
#: data/json/items/ammo.json
msgid "Firearm-quality gunpowder intended for use in rifle ammunition."
msgstr "火器级品质的火药，可以用于制造步枪弹药。"

#. ~ Description of "smokeless shotgun powder"
#: data/json/items/ammo.json
msgid "Firearm-quality gunpowder intended for use in shotgun shells."
msgstr "火器级品质的火药，可以用于制造霰弹。"

#. ~ Description of "mixed smokeless gunpowder"
#: data/json/items/ammo.json
msgid "Firearm-quality gunpowder, mixed without concern for composition, burn rate, or shape, making it thoroughly useless for reloading ammunition.  It has been slightly ground to make its properties more uniform."
msgstr "火器级品质的火药，制造者在完全不考虑组分、燃烧速率和形状的前提下将它混合起来，并稍稍碾碎以使其性质更加统一。这种火药无法用于弹药复装。"

#. ~ Description of "coal"
#: data/json/items/ammo.json
msgid "Flammable black chunks of carbon-based material, commonly used for cooking and heating."
msgstr ""
"一些黑色易燃的碳化物，常用于烹饪和取暖。\n"
"\"远古的孢子、裸子与被子植物尸体的最终形态。\""

#. ~ Description of "tinder"
#: data/json/items/ammo.json
msgid "Flammable material, finely divided for easy combustion."
msgstr "易燃材料，经过研磨之后，更加易于燃烧。"

#. ~ Description of "rebreather scrubbing filler"
#: data/json/items/ammo.json
msgid "Granulated mixture of slaked lime, potassium hydroxide and/or sodium hydroxide that is used as CO2 scrubbing agent in rebreathers."
msgstr "由熟石灰、氢氧化钾和/或氢氧化钠混合而成的颗粒物，用于在呼吸器中吸收CO2。"

#. ~ Description of "graphite"
#: data/json/items/ammo.json
msgid "Graphite powder mixed with a clay binder.  Produces gray or black marks that are easily erased, but otherwise resistant to moisture, most chemicals, ultraviolet radiation, and natural aging."
msgstr "混合有黏土粘结剂的石墨粉，能够产生灰色或黑色痕迹，易于擦除，但又能抵御湿气、大多数化学物质、紫外线辐射和自然老化。"

#. ~ Description of "betavoltaic cell"
#: data/json/items/ammo.json
msgid "Harness the power of radiation in your own home!  It looks similar to a D-cell battery, but actually contains folded layers of radioactive material inside.  It can produce electricity for several years at a steady voltage… but it's barely enough to power a small LED, and these batteries were worth hundreds of dollars.  Mostly they're a good way to brag to your neighbors that you have a nuclear power source in your house."
msgstr "在家中就能轻易使用的核能辐射电池！它看起来像一个一号电池，但实际上包含了很多层放射性物质，能在稳定的电压下使用很多年。问题在于，它最多只能驱动一个小型LED，而它的价格高达数百美元。因此大多数情况下，拥有这种电池的唯一好处就是可以向邻居炫耀你家里有核能。"

#. ~ Description of "plutonium slurry"
#. ~ Description of "watery plutonium slurry"
#: data/json/items/ammo.json
msgid "Highly-radioactive slurry.  It is probably best to get far away from this."
msgstr "具有高度放射性的钚浆。也许你该离它远一些。"

#. ~ Description of "permanent ink"
#: data/json/items/ammo.json
msgid "Ink comprised of a main carrier solvent, a glyceride, a pyrrolidone, a resin, and a colorant, making it water resistant."
msgstr "一种防水油墨，主要成分有主载体溶剂、甘油、吡咯烷酮、树脂和着色剂。"

#. ~ Description of "quill ink"
#: data/json/items/ammo.json
msgid "Ink made from a variety of sources for use in quill style pens."
msgstr "由多种原料制成的墨水，适用于鹅毛笔。"

#. ~ Description of "nicotine liquid"
#: data/json/items/ammo.json
msgid "Liquid made up of propylene glycol, vegetable glycerin, flavorings, and nicotine.  Intended for use in an advanced electronic cigarette."
msgstr "由丙二醇、植物甘油、香料和尼古丁组成的液体。用于高级电子烟。"

#. ~ Description of "rubber sealant"
#: data/json/items/ammo.json
msgid "Liquid rubber that comes in a sealed, pressurized container and is released in an aerosol spray when a valve button is depressed.  It dries in air, and can be used to waterproof items or repair leaks."
msgstr "装在密封加压容器中的油漆，当按下阀门按钮时，会在气溶胶喷雾中释放出来。"

#. ~ Description of "aerosol paint"
#: data/json/items/ammo.json
msgid "Paint that comes in a sealed, pressurized container and is released in an aerosol spray when a valve button is depressed."
msgstr "装在密封加压容器中的油漆，当按下阀门按钮时，会在气溶胶喷雾中释放出来。"

#. ~ Description of "rebreather oxygen regenerator filler"
#: data/json/items/ammo.json
msgid "Potassium superoxide powder, used as oxygen regenerating agent in rebreathers.  Keep away from water."
msgstr "超氧化钾粉末，用于在呼吸器中再生氧气，请勿让其靠近任何水体。"

#. ~ Description of "lye powder"
#: data/json/items/ammo.json
msgid "Powdered caustic soda, also known as sodium hydroxide."
msgstr "粉末状的腐蚀性纯碱，也称为氢氧化钠。"

#. ~ Description of "blue pen ink"
#: data/json/items/ammo.json
msgid "Prussian blue, crystal violet, and phthalocyanine blue pigments infused with polymers, stabilizers, and water to help the ink flow properly."
msgstr "一些普鲁士蓝、结晶紫和酞菁蓝颜料，加入了聚合物、稳定剂和水以帮助油墨正常流动。"

