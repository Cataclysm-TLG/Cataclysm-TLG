msgstr "电热毯没电了。"

#. ~ "need_charges_msg" action message of item "shooter's earmuffs"
#: data/json/items/tool_armor.json
msgid "The earmuff's batteries are dead."
msgstr "护耳的电池耗尽了。"

#. ~ "need_charges_msg" action message of item "shooter's ear plugs"
#: data/json/items/tool_armor.json
msgid "The earplugs' batteries are dead."
msgstr "耳塞的电池耗尽了。"

#. ~ Description of "five-point anchor (on)"
#: data/json/items/tool_armor.json
msgid "The harness's shoulder-mounted LED glows with a soft green hue.  There's no further indication of anything happening."
msgstr "安全带的肩部安装 LED 发出柔和的绿色色调。  没有进一步的迹象表明发生了什么事。"

#. ~ "need_charges_msg" action message of item "headlamp"
#: data/json/items/tool_armor.json
msgid "The headlamp's batteries are dead."
msgstr "头灯的电池耗尽了。"

#. ~ "menu_text" action message of item "fedora"
#. ~ "menu_text" action message of item "straw fedora"
#: data/json/items/tool_armor.json
msgid "Tip"
msgstr "歪帽"

#. ~ "menu_text" action message of item "EOD helmet (on)"
#: data/json/items/tool_armor.json
msgid "Turn off headlamps"
msgstr "关闭头灯"

#. ~ "menu_text" action message of item "EOD helmet"
#: data/json/items/tool_armor.json
msgid "Turn on headlamps"
msgstr "开启头灯"

#. ~ "menu_text" action message of item "attached ear plugs (in)"
#. ~ "menu_text" action message of item "makeshift ear plugs (in)"
#: data/json/items/tool_armor.json
msgid "Unplug"
msgstr "取出"

#. ~ "need_charges_msg" action message of item "phase immersion suit"
#: data/json/items/tool_armor.json
msgid "Warning: Operating on minimal power.  Protection compromised."
msgstr "警告：正以最低功率运行。防护已失效。"

#. ~ "menu_text" action message of item "ski mask (collar)"
#: data/json/items/tool_armor.json
msgid "Wear around head"
msgstr "包裹头部"

#. ~ "menu_text" action message of item "ski mask"
#: data/json/items/tool_armor.json
msgid "Wear as collar"
msgstr "珍珠项链"

#. ~ "msg" action message of item "tourniquet (arm)"
#. ~ "msg" action message of item "tourniquet (leg)"
#: data/json/items/tool_armor.json
msgid "You adjust the tourniquet."
msgstr "你调节了止血带的尺寸。"

#. ~ "msg" action message of item "ski mask"
#: data/json/items/tool_armor.json
msgid "You adjust your ski mask for less warmth."
msgstr "你调整你的滑雪面罩来透透气儿。"

#. ~ "msg" action message of item "ski mask (collar)"
#: data/json/items/tool_armor.json
msgid "You adjust your ski mask for more warmth."
msgstr "你调整你的滑雪面罩来保暖。"

#. ~ "msg" action message of item "combo cover"
#: data/json/items/tool_armor.json
msgid "You bring your hand to your cover and issue a salute."
msgstr "你把手并拢，微接帽檐，敬礼。"

#. ~ "msg" action message of item "atomic headlamp"
#: data/json/items/tool_armor.json
msgid "You close the headlamp's cover."
msgstr "你关上了头灯的灯罩。"

#. ~ "msg" action message of item "makeshift blindfold (raised)"
#. ~ "msg" action message of item "blindfold (raised)"
#. ~ "msg" action message of item "duct tape blindfold (raised)"
#: data/json/items/tool_armor.json
msgid "You cover your eyes."
msgstr "你遮住了你的双眼。"

#. ~ "msg" action message of item "armet helm (raised)"
#: data/json/items/tool_armor.json
msgid "You lower the armet visor."
msgstr "你把面罩放低。"

#. ~ "msg" action message of item "sallet helm (raised)"
#: data/json/items/tool_armor.json
msgid "You lower the sallet visor over your eyes."
msgstr "你把面甲放低，遮住眼睛。"

#. ~ "msg" action message of item "crude welding mask (raised)"
#: data/json/items/tool_armor.json
msgid "You lower your crude welding mask over your face."
msgstr "你将你的简易焊接面罩降下，覆盖住面部。"

#. ~ "msg" action message of item "welding mask (raised)"
#: data/json/items/tool_armor.json
msgid "You lower your welding mask over your face."
msgstr "你将你的焊接面罩降下，覆盖住面部。"

#. ~ "msg" action message of item "atomic headlamp (covered)"
#: data/json/items/tool_armor.json
msgid "You open the headlamp's cover."
msgstr "你打开了头灯的灯罩。"

#. ~ "msg" action message of item "attached ear plugs (out)"
#. ~ "msg" action message of item "makeshift ear plugs (out)"
#: data/json/items/tool_armor.json
msgid "You plug up your ears."
msgstr "你塞住了你的耳朵。"

#. ~ "msg" action message of item "welding mask"
#. ~ "msg" action message of item "crude welding mask"
#: data/json/items/tool_armor.json
#, c-format
msgid "You push your %s up your head."
msgstr "你将%s推到头顶上。"

#. ~ "msg" action message of item "armet helm"
#: data/json/items/tool_armor.json
msgid "You raise the armet visor."
msgstr "你升起了面罩。"

#. ~ "msg" action message of item "sallet helm"
#: data/json/items/tool_armor.json
