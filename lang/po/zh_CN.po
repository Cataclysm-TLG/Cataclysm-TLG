msgstr "\"请杀了我吧！\"，一个电子声响起\"自我保护程序已启动\""

#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Please, take me with you.\""
msgstr "\"请带上我一起走！\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Police inbound.  Stay where you are!\""
msgstr "\"警察来了，待在原地！\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Positive.\""
msgstr "\"确实。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Problem solving, memory retention, that sort of thing.\""
msgstr "\"问题处理，记忆保留，诸如此类的事。\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Put it down!  We can talk about this…\""
msgstr "\"把它放下！我们可以谈谈……\""

