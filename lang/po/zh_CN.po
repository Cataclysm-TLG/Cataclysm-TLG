#: data/json/effects.json
msgid "The heat is crushing you."
msgstr "炎热使你不堪重负。"

#. ~ Description of effect type "Sweltering"
#: data/json/effects.json
msgid "The heat is really slowing you down."
msgstr "酷热确实让你行动迟缓。"

#. ~ Description of effect type "Hot"
#: data/json/effects.json
msgid "The heat slows you down."
msgstr "炎热减慢了你的行动。"

#. ~ Remove message of effect type "fungus"
#: data/json/effects.json
