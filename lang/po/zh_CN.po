#. ~ Description of "skeleton gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of black costume gloves with a skeletal hand pattern printed on them."
msgstr "一双印着骷髅手图案的黑色COS服装手套。"

#. ~ Description of "black gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of black cotton gloves."
msgstr "一双黑色棉布手套。"

#. ~ Description of "light gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of cloth gloves."
msgstr "一双棉手套，提供基础的手部保暖与防护。"

#. ~ Description of "wrist warmers"
#: data/json/items/armor/gloves.json
msgid "A pair of cloth mitts that cover the wrists and palms but leave the fingers free."
msgstr "一对布制露指手套，包裹手腕和掌心，手指完全暴露在外。"

#. ~ Description of "cut-resistant gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of cut-resistant gloves, useful for butchery or routine work with bladed objects."
msgstr "一双防切割的手套，用于屠宰以及使用锋利物品时的防护。"

#. ~ Description of "bag mitts"
#: data/json/items/armor/gloves.json
msgid "A pair of disposable plastic bags, adapted to be used as gloves."
msgstr "一副用可回收塑料袋稍加修改制成的手套。"

#. ~ Description of "biosilicified chitin gauntlets"
#: data/json/items/armor/gloves.json
msgid "A pair of fingerless gauntlets crafted from the carefully cleaned and pruned biosilicified exoskeletons of acidic ants.  Acid-resistant but brittle."
msgstr "一对由经过精心清理并裁剪过的酸蚁硅化甲壳制成的护手，防酸但很脆弱。"

#. ~ Description of "airsoft gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of fingerless gloves with hard plastic reinforcing the backs of the hands to protect against BB pellets and other light projectiles."
msgstr "一对无指手套，手背上有硬塑料加固，可以防止BB弹和其他轻型弹丸的伤害。"

#. ~ Description of "tactical gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of flame- and cut-resistant aramid fabric gloves.  Commonly used by police and military units."
msgstr "一双凯夫拉防割战术手套。通常供警察或军人使用。"

#. ~ Description of "EOD overhand protectors"
#: data/json/items/armor/gloves.json
msgid "A pair of fragmentation resistant pads for wearing over the backs of one's hands, providing protection from shrapnel in case things go wrong.  Sold as an accessory for explosive ordnance disposal suits, but not often used due to the difficulty in armoring the entire hand and retaining dexterity."
msgstr "一对防爆衬垫，戴在手背上，提供弹片防护。作为爆炸物处理服的配件出售，但由于对整只手的防护性与灵活性不能兼顾，较少被人使用。"

#. ~ Description of "chitin gauntlets"
#: data/json/items/armor/gloves.json
msgid "A pair of gauntlets made from arthropod exoskeleton.  Though intricately articulated and padded by unsclerotized material, they do not cover the tips of the fingers."
msgstr "一副由节肢动物外骨骼制成的护手。  尽管它们的铰接结构错综复杂，并由未硬化的材料填充，但它们并没有覆盖指尖。"

#. ~ Description of "chainmail gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of gloves made of interlocking rings of low-quality steel wire."
msgstr "一副由劣质钢丝互锁环制成的手套。"

#. ~ Description of "chainmail gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of gloves made of interlocking rings of steel wire."
msgstr "一对由昆虫甲壳制成的护手。"

#. ~ Description of "leather gauntlets"
#: data/json/items/armor/gloves.json
msgid "A pair of heavy fingerless leather gloves."
msgstr "一双厚重的露指皮手套"

#. ~ Description of "fingerless leather gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of leather gloves without fingers."
msgstr "一对无指皮革手套。"

#. ~ Description of "armored fingerless leather gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of leather gloves without fingers.  These have been crudely reinforced with sheet metal guards across the back."
msgstr "一对无指皮革装甲手套。手背部位用钢片加强了防护。"

#. ~ Description of "mittens"
#: data/json/items/armor/gloves.json
msgid "A pair of mittens sized for a preschooler."
msgstr "一副轮椅的轮毂。"

#. ~ Description of "snow mittens"
#: data/json/items/armor/gloves.json
msgid "A pair of mittens with a water-resistant nylon shell, perfect for skiing."
msgstr "一双带有防水尼龙外壳的连指手套，非常适合滑雪。"

#. ~ Description of "Nomex wrist warmers"
#: data/json/items/armor/gloves.json
msgid "A pair of mitts that cover the wrists and palms but leave the fingers free.  These are made from a fire-resistant aramid weave."
msgstr "一双覆盖手腕和手掌但手指自由的手套。  它们由阻燃芳纶织物制成。"

#. ~ Description of "winter gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of padded cotton gloves.  Toasty!"
msgstr "一双加了棉布内衬的手套。暖烘烘的！"

#. ~ Description of "army winter gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of padded gloves of the sort issued by the military."
msgstr "一对有衬垫的手套，深受军队欢迎。"

#. ~ Description of "Santa gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of red gloves with white faux fur trim.  Keeps your hands warm and your holiday spirit bright."
msgstr "一双装饰着白色人造毛皮的红色手套。让你的手更暖，节日气氛更热烈。"

#. ~ Description of "rubber gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of rubber gloves, often used while cleaning with caustic materials."
msgstr "一双橡胶手套，常用在需要接触腐蚀性物质的场合。"

#. ~ Description of "glove liners"
#: data/json/items/armor/gloves.json
msgid "A pair of thin cloth gloves.  Often used as a liner beneath other gloves."
msgstr "一双薄的棉手套，通常作为内衬穿戴在其他手部装备里。"

#. ~ Description of "medical gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of thin nitrile gloves, designed to limit the spread of disease.  Too fragile to protect you from much else."
msgstr "一双轻薄的橡胶手套，能够隔绝病原体，降低疾病传染几率。除此之外，它过于脆弱，完全无法保护你免受其它伤害。"

#. ~ Description of "mittens"
#: data/json/items/armor/gloves.json
msgid "A pair of warm but cumbersome mittens."
msgstr "一双相当保暖的但十分累赘的连指手套。"

#. ~ Description of "faux fur gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of warm faux fur gloves."
msgstr "人造毛皮保暖手套"

#. ~ Description of "fur gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of warm fur gloves."
msgstr "一对十分保暖的毛皮手套。"

#. ~ Description of "wool wrist warmers"
