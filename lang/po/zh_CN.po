#: data/json/monsters/zed_children.json data/json/monsters/zed_dormant.json
msgid "zombie child"
msgid_plural "zombie childs"
msgstr[0] "儿童丧尸"

#. ~ Description of monster "skeletal master"
#: data/json/monsters/zed_command.json
msgid "A strange zombie covered in bone plates from face to toe.  Despite the added weight on its body, its movements are coordinated, almost as if capable of analyzing your movements."
msgstr "一个从头到脚被骨板覆盖的奇怪丧尸。尽管骨板让它的身体变得更加沉重，但它的动作是协调的，好像可以分析你的动作一样。"

#. ~ Description of monster "zombie lich"
#: data/json/monsters/zed_command.json
msgid "A twisted human figure armored head to toe in an overgrowth of rotten flesh and bone.  It stands upright, regarding its surroundings with a calculating demeanor."
msgstr "一个扭曲的人形从头到脚都被腐烂的肉和骨头包裹着。  它笔直地站着，带着一种精于算计的神态打量着周围的环境。"

#. ~ Monster name
#: data/json/monsters/zed_command.json
msgid "skeletal master"
msgid_plural "skeletal masters"
msgstr[0] "骸骨主宰"

#. ~ Monster name
#: data/json/monsters/zed_command.json
msgid "zombie lich"
msgid_plural "zombie liches"
msgstr[0] "丧尸巫妖"

#. ~ Message when player triggers trap "tr_dormant_corpse"
#. ~ Message when NPC triggers trap "tr_dormant_corpse"
#: data/json/monsters/zed_dormant.json
msgid "A zombie rises from the ground!"
msgstr "一只僵尸从地里升起！"

#. ~ Description of monster "zombie"
#. ~ Description of monster "decayed zombie"
