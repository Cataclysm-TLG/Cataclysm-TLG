#. ~ Conditional name for "kompot" when COMPONENT_ID matches wintergreen_berry
#: data/json/items/comestibles/drink.json
#, c-format
msgid "%s, wintergreen berry"
msgid_plural "%s, wintergreen berry"
msgstr[0] "%s（冬青浆果）"

#. ~ Description of "rehydration drink"
#: data/json/items/comestibles/drink.json
msgid "A basic oral rehydration therapy drink.  It will rehydrate you faster than water, but tastes like bottled sweat."
msgstr "一种口服补液疗法的基本饮品。补水效果比水更快，但味道有点像是瓶装汗水。"

#. ~ Description of "willowbark tea"
#: data/json/items/comestibles/drink.json
msgid "A bitter tea made by boiling willow bark in water, used since ancient times as a mild painkiller."
msgstr "柳树皮在水中煮制的苦茶，自古以来被人用作温和的止痛药。"

#. ~ Description of "cream soda"
#: data/json/items/comestibles/drink.json
msgid "A caffeine free carbonated beverage, flavorited with imitation vanilla."
msgstr "一种无咖啡因的碳酸饮料，含有人造香草味。"

#. ~ Description of "root beer"
#: data/json/items/comestibles/drink.json
msgid "A carbonated soft drink similar to cola, but without the caffiene."
msgstr "一种类似于可乐的碳酸软饮料，但不含咖啡因。"

#. ~ Description of "tonic water"
#: data/json/items/comestibles/drink.json
msgid "A carbonated soft drink which contains quinine, giving it a bitter flavor.  Originally used as a prophylactic against malaria, this modern variant is unsuitable for this purpose as it contains much less quinine and is also sweetened."
msgstr "一种碳酸软饮料，其中所含有的奎宁使其具有苦味。最初用作预防疟疾的药物，这款现代变种已经不适合用于此目的了，因为它含有的奎宁要少得多，而且还加了甜味剂。"

#. ~ Description of "chocolate drink"
#: data/json/items/comestibles/drink.json
msgid "A chocolate-flavored beverage made of artificial flavoring and milk byproducts.  Shelf stable and vaguely appetizing even when lukewarm."
msgstr "含有化学添加剂和乳制品的巧克力味饮料。储存期很长，就算没有加热也挺好喝的。"

#. ~ Description of "lemon-lime soda"
#: data/json/items/comestibles/drink.json
msgid "A clear, carbonated soft drink loaded with sugar and sour citrus flavor."
msgstr "一种透明的含糖碳酸软饮料，带有浓郁的酸柑橘味。"

#. ~ Description of "ayran"
#: data/json/items/comestibles/drink.json
msgid "A cold savory yogurt-based beverage popular across Western Asia, Central Asia, Southeastern Europe, North Asia and Eastern Europe."
msgstr "一种以酸奶为基础的冷味饮料，流行于西亚、中亚、东南欧、北亚和东欧。"

#. ~ Description of "coconut milk"
#: data/json/items/comestibles/drink.json
msgid "A dense, sweet, creamy sauce, often used in curries."
msgstr "又稠又甜的奶油酱，经常用来做咖喱。"

#. ~ Description of "sports drink"
#: data/json/items/comestibles/drink.json
msgid "A flavored drink consisting of a special blend of electrolytes and simple sugars.  It tastes vaguely like fruit with a slight chemical aftertaste."
msgstr "一种由电解质和单糖经过特殊混合制成的调味饮料。它尝起来有点像水果，带有轻微的化学品余味。"

#. ~ Description of "pine needle tea"
#: data/json/items/comestibles/drink.json
msgid "A fragrant and healthy beverage made from pine needles steeped in boiling water."
msgstr "有助健康且芳香无比的草药汤，把松针放入沸水中煮烂制成。"

#. ~ Description of "bee balm tea"
#: data/json/items/comestibles/drink.json
msgid "A healthy beverage made from bee balm steeped in boiling water.  Can be used to reduce negative effects of common cold or flu."
msgstr "香蜂草煮沸得来的有益软饮料。可以用来治疗流感或者普通感冒的不良反应。"

#. ~ Description of "chamomile tea"
#: data/json/items/comestibles/drink.json
msgid "A healthy beverage made from chamomile flowers steeped in boiling water.  Can be used to treat insomnia."
msgstr "洋甘菊煮沸得来的有益软饮料。可以用来治疗失眠。"

#. ~ Description of "dandelion tea"
#: data/json/items/comestibles/drink.json
msgid "A healthy beverage made from dandelion roots steeped in boiling water."
msgstr "有助健康的草药汤，把蒲公英根茎放入沸水中煮烂制成。"

#. ~ Description of "herbal tea"
#: data/json/items/comestibles/drink.json
msgid "A healthy beverage made from herbs steeped in boiling water."
msgstr "有助健康的草药汤，把草药放入沸水中煮烂制成。"

#. ~ Description of "lotus tea"
#: data/json/items/comestibles/drink.json
msgid "A healthy beverage made from lotus flowers steeped in boiling water."
msgstr "有助健康的草药汤，把荷花放入沸水中煮烂制成。"

#. ~ Description of "spurge tea"
#: data/json/items/comestibles/drink.json
msgid "A healthy beverage made from spurge flowers steeped in boiling water.  Can be used to prevent asthma attacks."
msgstr "有助健康的草药汤，把大戟花放入沸水中煮烂制成。可以用来预防哮喘发作。"

#. ~ Description of "diet energy drink"
#: data/json/items/comestibles/drink.json
msgid "A heavily-caffeinated soft drink spiked with artificial sweetener instead of the real thing."
msgstr "一种含高浓度咖啡因的软饮料，添加了人造甜味剂而非真正的糖。"

#. ~ Description of "energy drink"
#: data/json/items/comestibles/drink.json
msgid "A heavily-caffeinated soft drink, popular among those who need to stay up late or get up early."
msgstr "一种高咖啡因软饮料，在需要熬夜或早起的人群中很受欢迎。"

#. ~ Description of "grape drink"
#: data/json/items/comestibles/drink.json
msgid "A mass-produced grape flavored beverage of artificial origin.  Good for when you want something that tastes like fruit, but still don't care about your health."
msgstr "一个批量生产的普通葡萄味饮料，可以暂时解决对水果的饥渴，但过量饮用对健康不利。"

#. ~ Description of "horchata"
#: data/json/items/comestibles/drink.json
msgid "A sugary drink from Central America infused with rice, milk, and cinnamon."
msgstr "一种来自中美洲的含糖饮料，混入了大米、牛奶和肉桂。"

#. ~ Description of "pasteurized fruit juice"
#: data/json/items/comestibles/drink.json
msgid "A sweet liquid with a vaguely fruity taste.  Having been pasteurized, it will last for a long time."
msgstr "一份带有淡淡水果甜味的液体。经过巴氏杀菌后，可以保持很长一段时间不过期。"

#. ~ Description of "fruit tea"
#: data/json/items/comestibles/drink.json
msgid "A tasty beverage made with herbs and dried fruit from plants other than the tea plant.  While colloquially called 'tea', technically it's an infusion."
msgstr "一种美味的饮料，由草药和干果制成，没有用到茶叶。虽然被称为\"茶\"，但严格来说它只是一种冲泡饮料。"

#. ~ Description of "tomato juice"
#: data/json/items/comestibles/drink.json
msgid "A thick red liquid, made from tomatoes.  Not to everyone's taste, it is a healthy and refreshing drink when chilled."
msgstr "浓郁的红色液体，由番茄制成。并非适合所有人的口味，它冷藏后是一种健康而清新的饮料。"

#. ~ Description of "chai tea"
#: data/json/items/comestibles/drink.json
msgid "A traditional south Asian mixed-spice tea with milk."
msgstr "传统南亚奶茶，混有许多香料。"

#. ~ Description of "diet caffeinated citrus soda"
#: data/json/items/comestibles/drink.json
msgid "A zero-sugar energy drink with enough caffeine to keep you awake but none of the calories that keep you going."
msgstr "雾山“普埃布拉冲击”是一种流行的无糖能量饮料，含有足够的咖啡因让你保持清醒，但不含让你保持活力的卡路里。它的外观和味道都像蓝色的汽车冷却剂。"

#. ~ Description of "hot chocolate"
#: data/json/items/comestibles/drink.json
msgid "Also known as hot cocoa, this heated chocolate beverage is perfect for a cold winter day."
msgstr "也叫热可可。把巧克力加热融化，寒冬一杯，暖手暖心。"

#. ~ Description of "Virgin Mary cocktail"
#: data/json/items/comestibles/drink.json
msgid "An alcohol-free variant of the Bloody Mary cocktail; basically tomato juice mixed with some spices."
msgstr "一种无酒精版本的血腥玛丽鸡尾酒；基本上由番茄汁和一些香料混合调制而成。"

#. ~ Description of "pinita colada"
#: data/json/items/comestibles/drink.json
msgid "An alcohol-free variant of the pina colada cocktail, consisting of pineapple juice and coconut milk."
msgstr "一种无酒精版本的菠萝可乐达鸡尾酒，由菠萝汁和椰汁调制而成。"

#. ~ Description of "caffeinated citrus soda"
#: data/json/items/comestibles/drink.json
msgid "An astonishingly sweet fluorescent green concoction, carbonated and dosed with almost twice the caffeine of most soft drinks."
msgstr "一种甜得惊人的荧光绿色混合饮料，含碳酸，咖啡因含量几乎是大多数软饮料的两倍。"

#. ~ Description of "sweetened coffee"
#: data/json/items/comestibles/drink.json
msgid "Black coffee with sweetener added to taste."
msgstr "加甜味剂调味的黑咖啡。"

#. ~ Description of "orange soda"
#: data/json/items/comestibles/drink.json
msgid "Caffeine free, carbonated, and citrus-sweet, this neon orange beverage has never been anywhere near a real orange."
msgstr "无咖啡因、含碳酸、带有柑橘甜味，这种霓虹橙色的饮料从来没见过真正的橙子。"

#. ~ Description of "cola"
#: data/json/items/comestibles/drink.json
msgid "Carbonated water loaded with sugar, caffeine, caramel color, and preservatives."
msgstr "含糖、咖啡因、焦糖色和防腐剂的碳酸水。"

#. ~ Description of "kompot"
#: data/json/items/comestibles/drink.json
msgid "Clear juice obtained by cooking fruit in a large volume of water."
msgstr ""
"一些使用大量的水熬煮水果后得到的罐装果肉，保留了水果的营养并使口感更佳更易解渴。\n"
"\"黄桃党、山楂党与草莓党等各路诸侯群雄割据。\""

#. ~ Description of "sweetened coffee milk"
#: data/json/items/comestibles/drink.json
msgid "Coffee syrup mixed into milk.  It's been the state drink of Rhode Island since 1993.  With added sweetener for those who like it even sweeter.  Can also be served cold as iced coffee."
msgstr "一种将咖啡，糖混入牛奶中而成的饮品。自1993年起，它就一直是罗得岛州的州立饮品。额外加入了甜味剂，现在甜度更爆表了。也可作为冰咖啡冷饮。"

#. ~ Description of "coffee milk"
#: data/json/items/comestibles/drink.json
msgid "Coffee syrup or black coffee mixed into milk.  It's been the state drink of Rhode Island since 1993."
msgstr "一种将咖啡，糖混入牛奶中而成的饮品。自1993年起，它就一直是罗得岛州的州立饮品。"

#. ~ Description of "V8"
#: data/json/items/comestibles/drink.json
msgid "Contains up to eight vegetables!  Nutritious and tasty."
msgstr "含有共计8种蔬菜的田园蔬菜汁，营养又美味。"

#. ~ Description of "mineral water"
#: data/json/items/comestibles/drink.json
msgid "Fancy mineral water, so fancy it makes you feel fancy just holding it."
msgstr "高档矿泉水，非常高档，你光是握着瓶子就能感到它是那么的上档次。"

#. ~ Description of "clean water"
#: data/json/items/comestibles/drink.json
msgid "Fresh, clean water.  Truly the best thing to quench your thirst."
msgstr "一份新鲜且纯净的水。"

#. ~ Description of "fruit juice"
#: data/json/items/comestibles/drink.json
msgid "Freshly-squeezed from real fruit!  Tasty and nutritious."
msgstr "一些从水果中榨取的液体，富有营养且美味解渴。"

#. ~ Description of "pineapple juice"
#: data/json/items/comestibles/drink.json
msgid "Freshly-squeezed from real pineapples!  Tasty and nutritious."
msgstr "一份由菠萝压榨而成的果汁，美味且营养。"

#. ~ Description of "Mycus juice"
#: data/json/items/comestibles/drink.json
msgid "Freshly-squeezed from the fruit of the Mycus."
msgstr "一些从马卡斯果中榨取的果汁，富有营养且美味解渴。"

#. ~ Description of "coffee substitute"
#: data/json/items/comestibles/drink.json
msgid "Homemade not-coffee created from the Kentucky coffeetree, just like the Meskwaki tribe!  Doesn't actually have any caffeine, and is very bitter, but it'll pass in a pinch."
msgstr "由肯塔基咖啡树果实制成的自制非咖啡饮品，就像梅斯克瓦基部落做的一样！实际上它不含咖啡因，而且很苦，但在紧要关头还能用一用。"

#. ~ Description of "sweetened coffee substitute"
#: data/json/items/comestibles/drink.json
msgid "Homemade not-coffee created from the Kentucky coffeetree, just like the Meskwaki tribe!  It Doesn't actually have any caffeine, but it'll pass in a pinch.  The added sweetener neutralizes the bitterness somewhat."
msgstr "用肯塔基咖啡树自制的“非咖啡”，跟梅斯克瓦基部落做的一模一样！它其实不含任何咖啡因，但紧急情况下也能凑合。添加的甜味剂在一定程度上中和了苦味。"

#. ~ Description of "sweetened milk tea"
#: data/json/items/comestibles/drink.json
msgid "Hot tea with cold milk and added sweetener."
msgstr "一份热茶，加入了冷牛奶和甜味剂。"

#. ~ Description of "milk tea"
#: data/json/items/comestibles/drink.json
msgid "Hot tea with cold milk."
msgstr "一份热茶，加入了冷牛奶。"

#. ~ Description of "coffee substitute with milk"
#: data/json/items/comestibles/drink.json
msgid "Imitation coffee brewed from Kentucky coffeetree, this drink has no caffeine, no sweetener, and is still unpleasantly bitter even with the added milk."
msgstr "由肯塔基咖啡树果实制成的自制代咖啡饮品，它不含咖啡因，也没加甜味剂，即使加了牛奶，仍然苦涩难耐。"

#. ~ Description of "lemonade"
#: data/json/items/comestibles/drink.json
msgid "Lemon juice mixed with water and sugar to dull the sourness.  Delicious and refreshing."
msgstr "一份柠檬汁、糖、水的混合液体，美味爽口又解渴。"

#. ~ Description of "green tea"
#: data/json/items/comestibles/drink.json
msgid "Made from applying hot water to leaves of the tea plant \"Camellia sinensis\".  Green tea has a lighter, fresher taste than black and is traditionally preferred in Asian cultures."
msgstr "热水冲泡茶树树叶制成的饮品。绿茶比红茶味道更淡、更新鲜，在亚洲文化中传统上更受欢迎。"

#. ~ Description of "cranberry juice"
#: data/json/items/comestibles/drink.json
msgid "Made from real Massachusetts cranberries.  Quite sour, but nutritious."
msgstr "一份由马萨诸塞州蔓越莓制成的果汁，原汁原味。非常酸，但是营养丰富。"

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "Mexican hot chocolate"
msgid_plural "Mexican hot chocolate"
msgstr[0] "墨西哥热巧克力"

#. ~ Description of "sweetened fortified milk"
#: data/json/items/comestibles/drink.json
msgid "Milk enriched with protein powder, it's extra healthy and doesn't taste too bad.  It has sugar added, for those who like it sweeter."
msgstr "添加了蛋白粉的牛奶，特别健康，味道也不太差。它还加了糖，适合爱喝甜口的人。"

#. ~ Description of "crispy cranberry"
#: data/json/items/comestibles/drink.json
msgid "Mixing cranberry juice and lemon-lime soda works out quite well."
msgstr "一份蔓越莓果汁和柠檬苏打的混合液，味道非常不错。"

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "Mycus juice"
msgid_plural "Mycus juice"
msgstr[0] "马卡斯果汁"

#. ~ Description of "spring water"
#: data/json/items/comestibles/drink.json
msgid "Natural alpine spring water, bottled at the source."
msgstr "天然高山泉水，在源头瓶装。"

#. ~ Description of "bark tea"
#: data/json/items/comestibles/drink.json
msgid "Often regarded as folk medicine in some countries, bark tea tastes awful and tends to dry you out, but can help flush out stomach or other gut bugs."
msgstr "许多国家都不停实践的土药方，树皮茶难喝的一塌糊涂还会让你更渴，不过你需要洗洗肠子杀杀虫的时候就看它了。"

#. ~ Description of "orange juice"
#: data/json/items/comestibles/drink.json
msgid "Orange juice.  Refreshing, tasty, and a great source of Vitamin C."
msgstr "商店里贩卖的橙汁。清爽可口，富含维生素C。"

#. ~ Description of "sparkling water"
#: data/json/items/comestibles/drink.json
msgid "Plain, naturally carbonated mineral water with a subtle bitterness."
msgstr "自然碳酸化的平淡矿物质水，有淡淡的苦味。"

#. ~ Description of "apple cider"
#: data/json/items/comestibles/drink.json
msgid "Pressed from fresh apples, tasty and nutritious.  This is a non-alcoholic beverage, which sometimes confuses foreigners.  It's instead called 'hard cider' when alcohol is involved."
msgstr "新鲜苹果压榨而成，味道鲜美，营养丰富。有时\"apple cider\"会让外国人感到困惑，但这其实是一种无酒精饮料。当包含酒精时，它会被称为\"hard cider\"。"

#. ~ Description of "eggnog"
#: data/json/items/comestibles/drink.json
msgid "Smooth and rich, this spoon-coating mixture of milk, eggs, and cinnamon sugar is a popular traditional holiday drink.  This type isn't spiked with alcohol, but it is still delicious.  Meant to be stored cold, it will spoil rapidly."
msgstr "顺滑而浓厚，这份由牛奶、鸡蛋和肉桂混合而成的、能在勺子上挂住的香甜混合物是流行的传统节日饮品。这种版本还没有添加酒精，但也足够美味了。需要冷藏，不然会很快变质。"

#. ~ Description of "sweetened milk"
#: data/json/items/comestibles/drink.json
msgid "Some milk with sugar added.  Tastes slightly better."
msgstr "一些加了糖的牛奶。味道比不加糖稍稍好一些。"

#. ~ Description of "wild sarsaparilla tea"
#: data/json/items/comestibles/drink.json
msgid "Some wild sarsaparilla root steeped in boiling water.  Energizing."
msgstr "一份草药汤，把洋菝葜根茎放入沸水中煮烂制成。让你充满活力。"

#. ~ Description of "sweetened tea"
#: data/json/items/comestibles/drink.json
msgid "The beverage of gentlemen everywhere, made from applying hot water to leaves of the tea plant \"Camellia sinensis\".  With added sweetener for a better taste.  Can also be served cold as iced tea."
msgstr "受世界各地绅士欢迎的饮品，用开水冲泡茶树叶制成。加了甜味剂，口感更佳。也可作为冰茶冷饮。"

#. ~ Description of "black tea"
#: data/json/items/comestibles/drink.json
msgid "The beverage of gentlemen everywhere, made from applying hot water to oxidized leaves of the tea plant \"Camellia sinensis\"."
msgstr "受世界各地绅士欢迎的饮品，由发酵后的茶树叶加开水冲泡而成。"

#. ~ Description of "sweetened coffee substitute with milk"
#: data/json/items/comestibles/drink.json
msgid "The morning ritual of the post-apocalyptic world.  Brewed from the Kentucky coffeetree, this drink has no actual caffeine, but serves as a replacement for those who dearly miss the aroma of real coffee.  Can also be served cold as iced coffee."
msgstr "世界末日后的早晨仪式。这种饮品由肯塔基咖啡树果实酿造而成，不含咖啡因，但可以作为替代品来满足那些非常怀念真正咖啡香气的人。也可以冰镇后饮用。"

#. ~ Description of "black coffee"
#: data/json/items/comestibles/drink.json
msgid "The morning ritual of the pre-apocalyptic world, created from coffee cherries through a complex process of seed removal, roasting, grinding, and brewing.  Coffee is substantially richer in caffeine than its rival tea."
msgstr "曾经在世界末日前是一种早晨仪式，咖啡果经过一系列复杂的除种、烘焙、研磨和调制最终得到的饮品。咖啡比它的对手，茶含有更多的咖啡因。"

#. ~ Description of "diet cola"
#: data/json/items/comestibles/drink.json
msgid "Things go lighter with Cola Zero!  No sugar, no caffeine, no worries!"
msgstr "零度可乐，让一切变得更轻松！无糖，无咖啡因，无忧无虑！"

#. ~ Description of "Mexican hot chocolate"
#: data/json/items/comestibles/drink.json
msgid "This semi-bitter chocolate drink made from cocoa, cinnamon, and chilies traces its history to the Maya and Aztecs.  Perfect for a cold winter day."
msgstr "这是一种种半带苦味的巧克力饮料，使用可可豆，肉桂，和辣椒混合沸煮而成。这种饮料的历史可以追溯到玛雅和阿兹特克文明的时代。寒冬一杯，暖手暖心。"

#. ~ Description of "chicory brew"
#: data/json/items/comestibles/drink.json
msgid "Toasted, ground chicory root steeped in boiling water.  This bitter brew is used as a coffee substitute, though it tastes nothing like coffee."
msgstr "将经过烘烤的菊苣根，浸泡在沸水中。这种苦酿被用作咖啡替代品，尽管它尝起来一点也不像咖啡。"

#. ~ Description of "diet orange soda"
#: data/json/items/comestibles/drink.json
#, no-c-format
msgid "Trofica brand zero-sugar soda with natural orange flavors.  Now with 99% less calories!"
msgstr "Trofica 牌无糖汽水，加入天然橙子风味。卡路里现已减少 99%！"

#. ~ Description of "diet tropical soda"
#: data/json/items/comestibles/drink.json
msgid "Trofica brand zero-sugar soda.  Made with all-natural pineapple, kiwi, and passionfruit flavors that taste just like real fruit with none of the real sugar!"
msgstr "Trofica 牌无糖汽水。使用纯天然菠萝、猕猴桃和百香果风味物质，和真水果味道一模一样，而且没有真的糖分！"

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "V8"
msgid_plural "V8"
msgstr[0] "V8蔬菜汁"

#. ~ Item name
#: data/json/items/comestibles/drink.json
msgid "Virgin Mary cocktail"
msgid_plural "Virgin Mary cocktail"
msgstr[0] "处女玛丽鸡尾酒"

#. ~ Description of "almond milk"
#: data/json/items/comestibles/drink.json
msgid "Wait, you can milk almonds?  Not quite, but you can blend them with water!  A dairy-free alternative high in calcium, and rival to soy milk."
msgstr "扁桃仁也会产奶吗？并不会，但你可以把它们和水混合打成浆！不含乳制品的高钙饮料替代品，可与豆奶媲美。"

#. ~ Description of "hazelnut milk"
#: data/json/items/comestibles/drink.json
msgid "Wait, you can milk hazelnuts?  Not quite, but you can blend them with water!  A dairy-free alternative high in calcium, and rival to soy milk."
msgstr "扁桃仁也会产奶吗？并不会，但你可以把它们和水混合打成浆！不含乳制品的高钙饮料替代品，可与豆奶媲美。"

#. ~ Description of "soy milk"
#: data/json/items/comestibles/drink.json
msgid "Wait, you can milk soybeans?  Not quite, but you can blend them with water!  A dairy-free alternative high in protein, and rival to almond milk."
msgstr "大豆也会产奶吗？并不是，但你可以把它们和水混合打成浆！不含乳制品的高蛋白饮料替代品，可与扁桃仁乳媲美。"

#. ~ Description of "walnut milk"
#: data/json/items/comestibles/drink.json
msgid "Wait, you can milk walnuts?  Not quite, but you can blend them with water!  A dairy-free alternative high in calcium, and rival to soy milk."
msgstr "扁桃仁也会产奶吗？并不会，但你可以把它们和水混合打成浆！不含乳制品的高钙饮料替代品，可与豆奶媲美。"

#. ~ Description of "sweet water"
#: data/json/items/comestibles/drink.json
msgid "Water with sugar or honey added.  Tastes okay."
msgstr "白水里加了点糖或蜂蜜，尝起来还不赖。"

#. ~ Description of "water"
#: data/json/items/comestibles/drink.json
msgid "Water, the stuff of life, necessary for all kinds of crafting, cleaning, and avoiding an agonizing death by dehydration.  You should boil or purify it before using it as drinking water."
msgstr "水，生命之源，是各种工艺、清洁和避免因脱水而痛苦死亡所必需的材料。在将其用作饮用水之前，你应该先把它煮沸或净化。"

#. ~ Description of "murky water"
#: data/json/items/comestibles/drink.json
msgid "Water, the stuff of life.  This water looks like it has quite a bit of life in it in fact, and not the good kind.  You should filter and sterilize it if you want to drink it."
msgstr "水，生命之源。  这水看上去很有生命力，实际上却不是好水。  如果想喝就应该过滤、消毒。"

#. ~ "activation_message" action message of item "spurge tea"
#: data/json/items/comestibles/drink.json
msgid "You no longer need to worry about asthma attacks, at least for a while."
msgstr "你不再需要担心哮喘发作了，至少短时间内如此。"

#. ~ Description of "water (purifying)"
#: data/json/items/comestibles/drink.json
msgid "You've dissolved tablets of disinfecting chemicals in this water to purify it.  Soon it'll be ready to drink."
msgstr "你在水中溶解了消毒药片以净化水质。很快它就可以饮用了。"

