#. variety.
#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json data/json/npcs/island_prison/prisoners.json data/json/npcs/necc/members/foodguard.json data/json/npcs/talk_tags.json
msgid "Okay."
msgstr "好的。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay.  Lead the way."
msgstr "好的，你来带路吧。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "On second thought, never mind."
msgstr "[取消]回头想一想，算了吧。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Pleasure doing business!"
msgstr "交易愉快！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Right, right, I'll ask later."
msgstr "好吧，以后再问你吧。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Right… I don't want any trouble."
msgstr "好……我不想惹麻烦。"

#. ~ Response to NPC dialogue
#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json data/json/npcs/holdouts/Rural-Cowboy_Nihilist.json data/json/npcs/holdouts/Rural-Cowboy_Trader.json data/json/npcs/hub01/robofac_ancilla_npcs/NPC_ANCILLA_HQ_GUARD.json data/json/npcs/your_followers/luo_follower.json
msgid "See you around."
msgstr "[取消]嗯，保重吧，回头见。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Seriously, give me more stuff!"
msgstr "真的，再谈一下如何？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Smart choice."
msgstr "明智的选择。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Sounds good."
msgstr "[确认]听起来不错，开始吧。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Step aside.  I'm leader now."
msgstr "一边去，现在我是领队！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json data/json/npcs/refugee_center/surface_refugees/NPC_Draco_Dune.json
msgid "Thanks!"
msgstr "谢谢啦！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Thanks!  But can I have some more?"
msgstr "感谢！能否再给一些？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Thanks, see you later!"
msgstr "谢了，请多保重！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json data/json/npcs/necc/members/NPC_Aunt_Theresa.json data/json/npcs/necc/members/NPC_Helena_Misinter.json data/json/npcs/necc/members/cook.json data/json/npcs/other/TALK_NPC_PREPPER_SURVIVOR.json data/json/npcs/refugee_center/surface_visitors/NPC_old_guard_representative.json data/json/npcs/tacoma_ranch/NPC_ranch_foreman.json
msgid "Thanks."
msgstr "谢了。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Understood.  I'll get those antibiotics."
msgstr "明白了，我会把抗生素拿给你的。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Want to share some useful items with me?"
msgstr "能和我分享一些有用的东西吗？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json data/json/npcs/other/meteorologist.json
msgid "Want to travel with me?"
msgstr "[组队]与我同行吧，如何？"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "We could look for a farm.  They should have food and tools, and they aren't close to cities."
msgstr "我们可以找一个农场。那里应该有食物和工具，而且离城市比较远。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "We should probably stay away from cities, even if they have lots of supplies."
msgstr "也许我们应该远离那些城市，即便那里有不少物资。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "We'll talk about a training seminar after you're done operating that vehicle."
msgstr "在你开完车后，我们再讨论培训的事情。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Well, I am helping you out…"
msgstr "因为我正在帮你忙？……"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Well, I guess it's just us."
msgstr "呵呵，我估计就我们两个活人了。"

#. ~ NPC dialogue line
#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json data/json/npcs/refugee_center/surface_visitors/NPC_old_guard_representative.json data/json/npcs/tacoma_ranch/NPC_ranch_foreman.json
msgid "What is it?"
msgstr "干什么？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "What should we do now?"
msgstr "[询问]我们现在该做什么？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "What, this?  It's not the same one, you are mistaken."
msgstr "什么，这个？这不是同一个东西，你搞错了。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Why should I share my equipment with you?"
msgstr "为何我应该跟你分享自己的装备？"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Why should I travel with you?"
msgstr "为什么我应该跟你同行？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Works for me."
msgstr "挺好，我没意见。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Yeah… I don't think so."
msgstr "噢……我并不这么认为。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You can keep me safe."
msgstr "因为你能保护我的安全。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You got it, I'm with you!"
msgstr "如你所愿，我和你一起走！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You might be seeing more of me…"
msgstr "我们还会再见的……"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You picked up something that does not belong to you…"
msgstr "你拾取了不属于你的东西……"

