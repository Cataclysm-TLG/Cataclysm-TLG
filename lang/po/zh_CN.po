msgid "Zolpidem"
msgstr "唑吡坦"

#. ~ Name of effect type id "weed_high"
#: data/json/effects.json
msgid "Zooted"
msgstr "嗨爆了"

#. ~ Remove message of effect type "Transition Contact Lenses (Plano)"
