msgstr "你的腿太累了，跳不动了。"

#. ~ value of variable 'message_fail' in effect in EoC "EOC_BULL_CHARGE"
#: data/json/effects_on_condition/mutation_eocs/mutation_activation_eocs.json
msgid "You are too tired to run."
msgstr "你太累了，跑不动了。"

#. ~ Player message in false effect in EoC "EOC_BULL_CHARGE"
#: data/json/effects_on_condition/mutation_eocs/mutation_activation_eocs.json
msgid "You can't move properly, so charging is out of the question."
msgstr "你行动不便，更不用说冲锋了。"

#. ~ Player message in false effect in EoC "EOC_FELINE_LEAP"
#. ~ Player message in false effect in EoC "EOC_SHORT_LEAP"
#. ~ Player message in false effect in EoC "EOC_CRUSHING_LEAP"
#. ~ Player message in false effect in EoC "EOC_AVIAN_LEAP"
#. ~ Player message in false effect in EoC "EOC_RAPTOR_LEAP"
#: data/json/effects_on_condition/mutation_eocs/mutation_activation_eocs.json
msgid "You can't move properly, so leaping is out of the question."
msgstr "你行动不便，更不用说跳跃了。"

#. ~ value of variable 'message_success' in effect in EoC "EOC_CRUSHING_LEAP"
#: data/json/effects_on_condition/mutation_eocs/mutation_activation_eocs.json
msgid "You crouch down and leap forward with all your might."
msgstr "你蹲下身子，然后使出全身力气往前一跃。"

#. ~ value of variable 'message_success' in effect in EoC
#. "EOC_BIOLUM3_activated"
#: data/json/effects_on_condition/mutation_eocs/mutation_activation_eocs.json
msgid "You launch a glob of bioluminescent material!"
msgstr "你喷出了一团生物发光物质！"

#. ~ value of variable 'message_success' in effect in EoC "EOC_AVIAN_LEAP"
#. ~ value of variable 'message_success' in effect in EoC "EOC_RAPTOR_LEAP"
#: data/json/effects_on_condition/mutation_eocs/mutation_activation_eocs.json
msgid "You leap forward, talons ready to strike."
msgstr "你摆出了一个开放式防御的姿态，随时准备出击。"

#. ~ value of variable 'message_success' in effect in EoC "EOC_BULL_CHARGE"
#: data/json/effects_on_condition/mutation_eocs/mutation_activation_eocs.json
msgid "You lower your head and charge."
msgstr "你低头猛冲。"

#. ~ value of variable 'message_success' in effect in EoC "EOC_SLIME_SPRAY"
#: data/json/effects_on_condition/mutation_eocs/mutation_activation_eocs.json
msgid "You spit out some goo onto your enemies!"
msgstr "你朝敌人喷出了一团粘液！"

#. ~ value of variable 'message_success' in effect in EoC "EOC_FELINE_LEAP"
#: data/json/effects_on_condition/mutation_eocs/mutation_activation_eocs.json
msgid "You squat down, build up tension in your legs, then release, launching yourself quite a distance."
msgstr "你蹲下，双腿紧绷，然后突然松开，让自己弹跳出一段距离。"

#. ~ value of variable 'message_success' in effect in EoC "EOC_SHORT_LEAP"
#: data/json/effects_on_condition/mutation_eocs/mutation_activation_eocs.json
msgid "You take a big leap forward."
msgstr "你看起来有点无礼……"

#. ~ value of variable 'message_fail' in effect in EoC "EOC_BIOLUM3_activated"
#: data/json/effects_on_condition/mutation_eocs/mutation_activation_eocs.json
msgid "Your body is too starved to activate your bioluminescent flare."
msgstr "你太饿了，无法激活你的生物闪光弹。"

#. ~ value of variable 'message_fail' in effect in EoC "EOC_SLIME_SPRAY"
#: data/json/effects_on_condition/mutation_eocs/mutation_activation_eocs.json
msgid "Your body is too starved to activate your slime spray."
msgstr "你太饿了，无法激活你的粘液喷射。"

#. ~ value of variable 'message_success' in effect in EoC
#. "EOC_WHIPPING_TONGUE_PULL"
#. ~ Description of spell "Whipping Tongue"
#. ~ Description of spell "Harpoon Tongue Stab"
#. ~ Description of spell "Harpoon Tongue Pull"
#: data/json/effects_on_condition/mutation_eocs/mutation_activation_eocs.json data/json/mutations/mutation_spells.json
msgid "Your tongue launches out to snag your target."
msgstr "你服用了大量剑龙诱变剂。"

#. ~ value of variable 'message_success' in effect in EoC
#. "EOC_HARPOON_TONGUE_STAB"
#: data/json/effects_on_condition/mutation_eocs/mutation_activation_eocs.json
msgid "Your tongue launches out to spear your target."
msgstr "你出手将目标拉向你。"

#. ~ Player message in effect in EoC "flowers_winter_timer"
#: data/json/effects_on_condition/mutation_eocs/mutation_effect_eocs.json
msgid "A somber feeling comes over you as the last petals of your wilting flowers fall from your head."
msgstr "当枯花的最后一片花瓣从你的头上落下时，你感觉很忧郁。"

