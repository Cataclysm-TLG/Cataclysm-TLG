"强度：轻度\n"
"耗时：4小时（可重复）\n"
"位置： %d/3\n"

#: src/faction_camp.cpp:1068
msgid " Recover Foragers"
msgstr "召回同伴（采集植物）"

#: src/faction_camp.cpp:1076
#, c-format
msgid ""
"Notes:\n"
"Send a companion to set traps for small game.\n"
"\n"
"Skills used: Devices, Ecology\n"
"Stats used: Perception\n"
"Difficulty: Low\n"
"Trapping Possibilities:\n"
