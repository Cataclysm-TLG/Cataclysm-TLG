msgid "You try to surface but can't!"
msgstr "你无法浮出水面！"

#: src/game.cpp:11994
msgid "You swim up."
msgstr "你向浅处游去。"

#: src/game.cpp:11996
msgid "You are already underwater and there is no water above you to swim up!"
msgstr "你已经在水里，而且没有可以向上游的空间了！"

#: src/game.cpp:12074
#, c-format
msgid "%s moves out of the way for you."
msgstr "%s 为你让出了路。"

#: src/game.cpp:12089
#, c-format
msgid "Your %s moves out of the way for you."
msgstr "你的 %s 为你让出了路。"

