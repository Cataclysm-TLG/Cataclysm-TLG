#. ~ Description of "cut-resistant apron"
#: data/json/items/armor/torso_clothes.json
msgid "A Kevlar apron that covers the front of the body."
msgstr "一条厚重的毛毯，可以用来当被子，也可以穿在身上进行保暖。"

#. ~ Description of "wedding dress"
#: data/json/items/armor/torso_clothes.json
msgid "A beautiful white wedding dress.  What good will it be now?"
msgstr "一件美丽的白色婚纱。现在还适合穿吗？"

#. ~ Description of "flotation vest"
#: data/json/items/armor/torso_clothes.json
msgid "A brightly-colored vest designed to keep you upright and floating in water."
msgstr "一件有着醒目颜色的，能让你在水上保持垂直漂浮的背心。"

#. ~ Description of "grass shirt"
#: data/json/items/armor/torso_clothes.json
msgid "A crude and bulky short-sleeved shirt woven from grass.  Definitely not the most comfortable thing to wear."
msgstr "一件粗糙而笨重的短袖衬衫，由草编织而成。绝对不是最舒服的衣服。"

#. ~ Description of "makeshift flotation vest"
#: data/json/items/armor/torso_clothes.json
msgid "A flotation vest made of inflated animal skins."
msgstr "一件用充满气的动物毛皮制造而成的救生衣。"

#. ~ Description of "wool hoodie"
#: data/json/items/armor/torso_clothes.json
msgid "A hooded wool shirt with a kangaroo pocket in the front."
msgstr "一件带有兜帽和前置口袋的卫衣。"

#. ~ Description of variant "French maid outfit" of item "skimpy costume
#. dress"
#: data/json/items/armor/torso_clothes.json
msgid "A kinky little number consisting of a black bodice and miniskirt fluffed up with white lace and tulle.  It's a lot sexier than what an actual housekeeper would wear."
msgstr "一件古怪的小衣服，由黑色紧身胸衣和迷你裙组成，上面饰有白色蕾丝和薄纱。  这比真正的管家穿的要性感得多。"

#. ~ Description of variant "gothic dress" of item "skimpy costume dress"
#: data/json/items/armor/torso_clothes.json
msgid "A lacy red and black mini dress in a cutesy gothic style."
msgstr "红黑蕾丝迷你连衣裙，可爱的哥特式风格。"

#. ~ Description of "leather apron"
#: data/json/items/armor/torso_clothes.json
msgid "A leather apron that covers the front of the body."
msgstr "一条厚重的毛毯，可以用来当被子，也可以穿在身上进行保暖。"

#. ~ Description of "cheerleader dress"
#: data/json/items/armor/torso_clothes.json
msgid "A light and breezy cheerleader dress.  It's blue and white with the word \"Cheers\" printed at the top."
msgstr "一条轻便而清凉的啦啦队连衣裙。它是蓝色和白色的，胸部印着\"加油\"的字样。"

#. ~ Description of "sundress"
#: data/json/items/armor/torso_clothes.json
msgid "A light and breezy cotton dress."
msgstr "一件轻便清凉的棉质吊带裙。"

#. ~ Description of "mail carrier shirt"
#: data/json/items/armor/torso_clothes.json
msgid "A light blue button down shirt with a couple of pockets in front and the US postal service logo embroidered on it."
msgstr "一件后背印着美国邮政服务的轻便蓝色衬衫，正面还有两个口袋。"

#. ~ Description of "long waist apron"
#: data/json/items/armor/torso_clothes.json
msgid "A long cloth apron that haings from the waist."
msgstr "我从这本书里学不到新东西了。"

#. ~ Description of "dress"
#: data/json/items/armor/torso_clothes.json
msgid "A long cotton dress."
msgstr "一件棉制长连衣裙。"

#. ~ Description of "luxury Santa dress"
#: data/json/items/armor/torso_clothes.json
msgid "A long red dress with full sleeves and white faux fur trim.  A dress for a queen of the north pole."
msgstr "红色长裙，长袖，白色人造毛皮饰边。  北极女王的礼服。"

#. ~ Description of "denim shirt"
#: data/json/items/armor/torso_clothes.json
msgid "A long sleeved button-down shirt made from denim."
msgstr "牛仔布制成的长袖纽扣衬衫。"

#. ~ Description of "long-sleeved shirt"
#: data/json/items/armor/torso_clothes.json
msgid "A long-sleeved cotton shirt."
msgstr "一件长袖的全棉衬衣。"

#. ~ Description of "costume dress"
#: data/json/items/armor/torso_clothes.json
msgid "A long-sleeved gown made of cheap costumey material."
msgstr "用廉价的服装材料制成的长袖礼服。"

#. ~ Description of variant "striped shirt" of item "long-sleeved shirt"
#: data/json/items/armor/torso_clothes.json
msgid "A long-sleeved shirt with horizontal black and white stripes."
msgstr "一件带有水平黑白相间条纹的长袖衬衫。"

#. ~ Description of "western shirt"
#: data/json/items/armor/torso_clothes.json
msgid "A long-sleeved shirt with snap buttons down the front, a style traditionally associated with the Old West."
msgstr "一种正面有按扣的长袖衬衫，这种风格传统上与老西部有关。"

#. ~ Description of "evening gown"
#: data/json/items/armor/torso_clothes.json
msgid "A luxurious evening gown.  It accentuates your curves, or lack thereof."
msgstr "一件晚上20:00以后穿用的正式礼服，常与披肩、外套、斗篷之类的衣服相配，是女士礼服中最高档次、最具特色、充分展示个性的礼服样式。"

#. ~ Description of variant "princess dress" of item "costume dress"
#: data/json/items/armor/torso_clothes.json
msgid "A pink and white dress made of gauzy tulle, a perfect costume for a princess."
msgstr "粉色和白色的薄纱连衣裙，是公主的完美服装。"

#. ~ Description of "Boston-Chan suit"
#: data/json/items/armor/torso_clothes.json
msgid "A professional-looking bright blue wool suit for the Boston-Chan costume."
msgstr "波士顿酱cosplay套装中的亮蓝色羊毛西服，看起来很专业。"

#. ~ Description of "blazer"
#: data/json/items/armor/torso_clothes.json
msgid "A professional-looking wool blazer."
msgstr "一件羊毛制的专业运动夹克。"

#. ~ Description of "skimpy costume dress"
#: data/json/items/armor/torso_clothes.json
msgid "A scandalously short dress, the sort of thing young women wear for halloween."
msgstr "一件令人震惊的短裙，是年轻女性在万圣节穿的那种衣服。"

#. ~ Description of "sports jersey"
#: data/json/items/armor/torso_clothes.json
msgid "A shirt made of cotton, printed with the name and logo of a sports team."
msgstr "一种印有运动队名称和标识的短袖球衣。"

#. ~ Description of "tallit katan"
#: data/json/items/armor/torso_clothes.json
msgid "A shirt with four tassels worn by observant Jews in deference to Deuteronomy 22:12, which commands the wearing of fringes on the corner of one's garments."
msgstr "一种有四条流苏的衬衫，虔诚的犹太教徒遵守《申命记》22:12戒律而穿着，该条律要求衣角上要有流苏。"

#. ~ Description of "short waist apron"
#: data/json/items/armor/torso_clothes.json
msgid "A short cloth apron that hangs from the waist."
msgstr "由化纤织物制成的柔软汽车座椅。"

#. ~ Description of "short Santa dress"
#: data/json/items/armor/torso_clothes.json
msgid "A short red dress with white faux fur trim.  Looks like something Mrs. Claus might wear on Christmas night."
msgstr "一件装饰着白色人造毛皮的红色短裙。看起来像是圣诞夫人会在圣诞夜穿的衣服。"

#. ~ Description of "halter top"
#: data/json/items/armor/torso_clothes.json
msgid "A short top made from cotton."
msgstr "一件棉制吊带背心。"

#. ~ Description of "polo shirt"
#: data/json/items/armor/torso_clothes.json
msgid "A short-sleeved cotton shirt, slightly thicker than a t-shirt."
msgstr "一件后长、前短，且侧边有一小截开口的下摆的棉衬衫，有着标志性的翻领，原本称做网球衫或高尔夫球衫。"

#. ~ Description of "t-shirt"
#: data/json/items/armor/torso_clothes.json
msgid "A short-sleeved cotton shirt."
msgstr "一件短袖的全棉衬衫。"

#. ~ Description of variant "sexy bee dress" of item "skimpy costume dress"
#: data/json/items/armor/torso_clothes.json
msgid "A skimpy dress striped in yellow and black to invoke the image of a honey bee."
msgstr "黄色和黑色条纹的紧身连衣裙，唤起蜜蜂的形象。"

#. ~ Description of "leotard"
#: data/json/items/armor/torso_clothes.json
msgid "A skin-tight spandex garment, covering the body from the groin to the shoulders.  With its deep scoop-cut back and high waist cuts, this garment is perfect for showcasing your physique on the stage."
msgstr "一件紧身的氨纶连体服，覆盖了从腹股沟到肩膀的身体。它背后的圆低领和底部高腰的剪裁，能够在舞台上完美的展示出你的体型。"

#. ~ Description of "Santa dress"
#: data/json/items/armor/torso_clothes.json
msgid "A sleeved red dress with white faux fur trim.  For when you want to be Mrs. Claus on Christmas, or perhaps Santa going clubbing."
msgstr "一条装饰着白色人造毛皮的红袖连衣裙。适合圣诞夫人在圣诞夜时穿着，或者圣诞老人去夜总会时穿着。"

#. ~ Description of variant "sinister gown" of item "costume dress"
#: data/json/items/armor/torso_clothes.json
msgid "A sleeveless gown in a dramatic gothic style - part of a halloween costume, or maybe a piece of clubwear."
msgstr "戏剧性哥特式风格的无袖礼服 - 万圣节服装的一部分，也可能是俱乐部服装的一部分。"

#. ~ Description of "long-sleeved t-shirt"
#: data/json/items/armor/torso_clothes.json
msgid "A soft cotton shirt with long sleeves."
msgstr "一件常见于郡县治安官们的棕褐色长袖纽扣衬衫，上面印有当地治安部门的标志。"

#. ~ Description of "hoodie"
#: data/json/items/armor/torso_clothes.json
msgid "A sweatshirt with a hood and a \"kangaroo pocket\" in the front for storage."
msgstr ""
"一件带有兜帽和前置口袋的卫衣。\n"
"\"戴上兜帽无法使人低调，反而会更引人注目。\""

#. ~ Description of "flag t-shirt"
#: data/json/items/armor/torso_clothes.json
msgid "A t-shirt embroidered with an American flag pattern."
msgstr "一件印着星条旗花纹的T恤。"

#. ~ Description of "work t-shirt"
#: data/json/items/armor/torso_clothes.json
msgid "A t-shirt with a small front pocket."
msgstr "一件灰色的T恤，前面还有个小口袋。"

#. ~ Description of "turtleneck shirt"
#: data/json/items/armor/torso_clothes.json
msgid "A tasteful shirt with a high rolled collar.  It's too thin to be called a sweater."
msgstr "有品位的高卷领衬衫。  它太薄了，不能称为毛衣。"

#. ~ Description of "turtleneck"
#: data/json/items/armor/torso_clothes.json
msgid "A tasteful wool turtleneck, modeled after cashmere.  Unencumbering and warm, but lacking storage."
msgstr "一件雅致的羊毛高领毛衣，仿羊绒款。不太累赘而且非常保暖，但缺乏存储空间。"

#. ~ Description of variant "skimpy pirate dress" of item "skimpy costume
#. dress"
#: data/json/items/armor/torso_clothes.json
msgid "A teeny tiny little dress festooned with lace and frills.  It sort of looks like stereotypical pirate's garb."
msgstr "一件饰有蕾丝和褶边的极小连衣裙。  它看起来有点像典型的海盗服装。"

#. ~ Description of "sweatshirt"
#: data/json/items/armor/torso_clothes.json
msgid "A thick cotton shirt."
msgstr "一件厚棉衫。"

#. ~ Description of "uttarasanga"
#: data/json/items/armor/torso_clothes.json
msgid "A traditional Buddhist shirt, covering most of the upper body, but not the arms."
msgstr "郁多罗僧是一种传统佛教的上衣，覆盖除了手臂的整个上半身。"

#. ~ Description of "leather vest"
#: data/json/items/armor/torso_clothes.json
msgid "A vest made from thick leather."
msgstr "一件厚皮革制成的背心。"

#. ~ Description of "buckskin vest"
#: data/json/items/armor/torso_clothes.json
msgid "A vest made of thin, lightweight leather."
msgstr "一件由轻薄皮革制成的马甲。"

#. ~ Description of "sweater"
#: data/json/items/armor/torso_clothes.json
msgid "A warm wool sweater."
msgstr "一件十分保暖的羊毛衫。"

#. ~ Description of "dress shirt"
#: data/json/items/armor/torso_clothes.json
msgid "A white button-down shirt with long sleeves.  Looks professional!"
msgstr ""
"一件白色纽扣领的长袖衬衫。\n"
"\"穿着像个专业人士！\""

#. ~ Description of "plastic apron"
#: data/json/items/armor/torso_clothes.json
msgid "An apron made of plastic that covers the front of the body, provides some protection against accidental chemical splashes."
msgstr "一条塑料围裙，能很好地防护飞溅的化学试剂。"

#. ~ Description of "cotton apron"
#: data/json/items/armor/torso_clothes.json
msgid "An cloth apron that covers the front of the body."
msgstr "一件无袖连身衣，覆盖了躯干和腿部。"

#. ~ Description of "combat shirt"
#: data/json/items/armor/torso_clothes.json
msgid "An oddly balanced long-sleeved shirt with a thin, breathable torso and thicker arms more appropriate for a jacket.  The arms are covered in a camouflage pattern and have two shoulder pockets.  It has a pocket for your pen!"
msgstr "一种奇怪匀称的长袖衬衫，躯干部分薄而透气，手臂部分更厚，更像是夹克。手臂部分覆盖着迷彩图案，肩部有两个口袋。它还有一个口袋能用来放你的钢笔！"

#. ~ Description of "buckskin shirt"
#: data/json/items/armor/torso_clothes.json
msgid "An overshirt made of thin, lightweight leather."
msgstr "一件由轻薄皮革制成的罩衫。"

#. ~ Item name
#: data/json/items/armor/torso_clothes.json
msgid "Boston-Chan suit"
msgid_plural "Boston-Chan suits"
msgstr[0] "波士顿酱西服"

#. ~ Description of a pocket in item "dress shirt"
#: data/json/items/armor/torso_clothes.json
msgid "Buttonholes for cufflinks"
msgstr "蓝黄玉银袖扣"

#. ~ Description of a pocket in item "dress shirt"
#. ~ Description of a pocket in item "western shirt"
#: data/json/items/armor/torso_clothes.json
msgid "Eyelets for a collar pin"
msgstr "领针孔眼"

#. ~ Variant name of item "skimpy costume dress"
#: data/json/items/armor/torso_clothes.json
