msgid "How would you prefer to climb down?"
msgstr "你希望如何爬下去？"

#: src/game.cpp:13770
msgid "It <color_green>seems perfectly safe</color> to climb down like this."
msgstr "就这么爬下去 <color_green>似乎是非常安全的</color> 。"

#: src/game.cpp:13772
msgid "It <color_green>seems safe</color> to climb down like this."
msgstr "就这么爬下去 <color_green>似乎是安全的</color> 。"

#: src/game.cpp:13774
msgid "It <color_yellow>seems a bit tricky</color> to climb down like this."
msgstr "就这么爬下去 <color_yellow>似乎有点儿冒险</color> 。"

#: src/game.cpp:13776
msgid "It <color_yellow>seems somewhat risky</color> to climb down like this."
msgstr "就这么爬下去 <color_yellow>似乎有些危险</color> 。"

#: src/game.cpp:13778
msgid "It <color_red>seems very risky</color> to climb down like this."
msgstr "就这么爬下去 <color_red>看起来非常危险</color> 。"

