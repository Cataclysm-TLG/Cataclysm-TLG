#. ~ Description of a pocket in item "military rucksack"
#: data/json/items/armor/storage.json
msgid "Pouch sized for a hydration pack."
msgstr "一个大小适合储水背袋的口袋。"

#. ~ "holster_prompt" action message of item "hiking backpack"
#: data/json/items/armor/storage.json
msgid "Sheath blade"
msgstr "收刀"

#. ~ "holster_prompt" action message of item "golf bag"
