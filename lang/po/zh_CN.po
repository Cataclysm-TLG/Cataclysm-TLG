msgid "small helicopter rotors"
msgstr "小型直升机旋翼"

#. ~ Description of vehicle part "leather bucket seat"
#: data/json/vehicleparts/seats.json
msgid "A leather car seat for one."
msgstr "一个皮革汽车座椅。"

#. ~ Description of vehicle part "saddle"
#: data/json/vehicleparts/seats.json
msgid "A padded wedge that you straddle, like a bicycle or motorcycle."
msgstr "一个自行车或摩托车上常见的鞍座。"

#. ~ Description of vehicle part "cloth seat"
#: data/json/vehicleparts/seats.json
msgid "A simple fabric seat, suspended from the frame itself."
msgstr "一个悬挂在车体框架上的简易布质座位。"

#. ~ Description of vehicle part "reclining bucket seat"
#: data/json/vehicleparts/seats.json
msgid "A soft seat with an adjustable backrest, making it a reasonably comfortable place to sleep."
msgstr "带有可调节靠背的柔软座椅，是个相当舒适的睡觉地方。"

#. ~ Description of vehicle part "bucket seat"
#: data/json/vehicleparts/seats.json
msgid "A soft upholstered car seat, contoured to hold one person."
msgstr "一款柔软的软垫汽车座椅，其轮廓可容纳一个人。"

#. ~ Description of vehicle part "bench seat"
#: data/json/vehicleparts/seats.json
msgid "A soft, wide seat with a high back, the kind often used in back seats or older cars.  It might be a decent place to sleep."
msgstr "柔软、宽阔、高靠背的座椅，通常用于后座或老式汽车。 这大概是个像样的睡觉地方。"

#. ~ Description of vehicle part "steel bench"
#: data/json/vehicleparts/seats.json
msgid "A steel bench with ankle and wrist restraints built in.  It looks very uncomfortable."
msgstr "一条自带脚踝和手腕锁链的钢制长凳。看起来很不舒服。"

