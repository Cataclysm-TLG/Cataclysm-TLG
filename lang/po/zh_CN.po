msgstr[0] "大众机械杂志"

#. ~ Item name
#: data/json/items/book/mechanics.json
msgid "Stirling engine kit instructions"
msgid_plural "copies of Stirling engine instructions"
msgstr[0] "斯特林发动机说明书"

#. ~ Description of "lab journal-Curie"
#: data/json/items/book/mechanics.json
msgid "This lab notebook is filled with the collective discoveries and refinements of a research team dedicated to nuclear energy.  You don't think you're ready to start a second Cataclysm, but the general information provided might be useful…"
msgstr "这本团队日志记满了一个核能研究团队对核能技术的发现和改良内容。你并不想用核平带来另一个大灾变，但是上面一些通用的技术信息也许会派上用场……"

#. ~ Item name
#: data/json/items/book/mechanics.json
msgid "Under the Hood"
msgid_plural "copies of Under the Hood"
msgstr[0] "引擎探秘指南"

#. ~ Item name
#: data/json/items/book/mechanics.json
msgid "army improvised field repairs manual"
msgid_plural "army improvised field repairs manuals"
msgstr[0] "军用应急维修手册"

#. ~ Item name
