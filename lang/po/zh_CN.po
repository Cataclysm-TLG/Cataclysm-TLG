#: data/json/npcs/tacoma_ranch/NPC_ranch_barber.json
msgid "Barber"
msgstr "理发师"

#. ~ NPC dialogue line
#: data/json/npcs/tacoma_ranch/NPC_ranch_barber.json
msgid "Can I interest you in a trim?  It'll cost you 6 merch for a haircut or 3 for a beard trim.  I can do color and styling too."
msgstr "想要修剪一下吗？理发6商币，剃须3商币。我也会染色和造型。"

#. ~ NPC dialogue line
#: data/json/npcs/tacoma_ranch/NPC_ranch_barber.json
msgid "I can't imagine what I'd need your assistance with."
msgstr "眼下好像没什么需要你帮忙的。"

#. ~ NPC dialogue line
#: data/json/npcs/tacoma_ranch/NPC_ranch_barber.json
msgid "Stand still while I get my clippers…"
msgstr "请稍等，让我拿把剪刀来……"

#. ~ Response to NPC dialogue
#: data/json/npcs/tacoma_ranch/NPC_ranch_barber.json
msgid "Thanks…"
msgstr "谢了……"

