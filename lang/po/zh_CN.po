#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Ah, okay."
msgstr "啊，好吧。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, let's begin."
msgstr "好吧，让我们开始吧。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, let's go."
msgstr "好的，出发吧。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, show me how it's done."
msgstr "好的，让我看看是怎么做的吧。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, who should participate?"
msgstr "好的，谁应该参加？"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright.  You can lead now."
msgstr "好吧，现在你说了算。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Any tips?"
msgstr "[询问]有什么建议吗？"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "At least we've got shelter."
msgstr "好歹我们还有个避难所可以呆。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Awesome!"
msgstr "嗯，那太好了！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Because I'm holding a thermal detonator!"
msgstr "因为我手上捏这个危险的家伙！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Because I'm your friend!"
msgstr "因为我是你的朋友！"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Don't try and talk yourself out of this, drop it now."
msgstr "别说那么多，现在就放下它。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Eh, never mind."
msgstr "[取消]嗯，不用了。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json data/json/npcs/holdouts/Rural-Cowboy_Nihilist.json data/json/npcs/tacoma_ranch/NPC_ranch_barber.json
msgid "Fine."
msgstr "好吧。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Focus on the road, mate!"
msgstr "专心开车，兄弟！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Give it to me, or else!"
msgstr "快点把你的东西给我！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Good.  Something else…"
msgstr "好的。还有别的事……"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Hmm, okay."
msgstr "嗯嗯，好吧。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "How much further?"
msgstr "还有多远？"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I can keep you safe."
msgstr "因为我有能力保护你啊。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I can't host a seminar while I'm operating a vehicle!"
msgstr "我开车的时候没法开展培训！"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I can't train you properly while I'm operating a vehicle!"
msgstr "我开车的时候没法训练你！"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I can't train you properly while you're operating a vehicle!"
msgstr "你开车的时候，我没法好好儿训练你！"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I don't know, look for supplies and other survivors I guess."
msgstr "不知道，或许我们应该寻找其他幸存者和补给。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I have some reason for denying you training."
msgstr "我不教你是有原因的。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I have some reason for not telling you."
msgstr "我不方便对你说。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I have some reason to refuse hosting a training seminar."
msgstr "我不开展培训是有原因的。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json data/json/npcs/your_followers/luo_follower.json
msgid "I need you to come with me."
msgstr "[归队]我需要你和我一起走。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I really don't feel comfortable doing so…"
msgstr "这么做让我很不爽啊……"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I suppose getting a car up and running would be really be useful if we have to move."
msgstr "如果我们必须搬家的话，用车来搬家会非常有用。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I understand…"
msgstr "我明白……"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'd like to lead for a while."
msgstr "让我来带路吧。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'd prefer to keep that to myself."
msgstr "我还是留着给自己吧。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'll give it back!"
msgstr "我会把这个还给你的。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'll give you some space."
msgstr "我会给你点空间。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'll kill you if you don't."
msgstr "要是不答应我就杀了你。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm driving here!"
msgstr "我在开车！"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm on watch."
msgstr "我在看管这里。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm sorry.  Look, I already dropped it, okay?"
msgstr "我很抱歉。看，我已经把它放下了，好吗？"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm willing to pay <topic_item_price> per batch for a total of <topic_item_your_total_price>."
msgstr "每份我给你算 <topic_item_price>，一共 <topic_item_your_total_price>。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Just this once, you can keep it.  Don't tell anyone else."
msgstr "下不为例，你可以留着它。别告诉别人。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Let's see…"
msgstr "我想想看……"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json data/json/npcs/your_followers/luo_follower.json
msgid "Let's talk."
msgstr "让我们交易吧。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Look, I really need this.  Please let me have it."
msgstr "听着，我急需这个。请把它给我吧。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json data/json/npcs/other/meteorologist.json data/json/npcs/refugee_center/surface_visitors/NPC_old_guard_representative.json data/json/npcs/tacoma_ranch/NPC_ranch_crop_overseer.json data/json/npcs/tacoma_ranch/NPC_ranch_woodcutter1.json
msgid "Maybe later."
msgstr "下次再说吧。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Maybe we should start boarding up this place."
msgstr "也许我们该开始加固这个地方。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Never mind, I'll do without.  Bye."
msgstr "[取消]没关系，再见。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "No, I'm keeping it.  Try and take it off me, I dare you."
msgstr "不，它是我的了。你敢把它从我身上拿下来试试。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "No, we'll be okay here."
msgstr "不要，在这挺好的。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Not a bloody chance, I'm going to get left behind!"
msgstr "一点可能也没有。我要留下来！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, I'm dropping it…"
msgstr "好吧，我现在就放下它……"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, fine, bye."
msgstr "嗯嗯，那就这样，再会。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, fine."
msgstr "好的，算了。"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, here you go."
msgstr "好的，给你。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, let's begin."
msgstr "好的，我们开始吧。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, let's go!"
msgstr "好的，我们出发吧！"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, okay, sorry."
msgstr "好吧，我表示抱歉。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, okay, this is all a misunderstanding.  Sorry, I'll drop it now."
msgstr "好吧，好吧，这都是误会。对不起，我现在就把它放下。"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, okay."
msgstr "OK，OK。"

#. ~ Snippet in category "<acknowledged>"
