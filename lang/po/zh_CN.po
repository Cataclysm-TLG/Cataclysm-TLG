msgstr "\"求求你，我不想死。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Please, don't!\""
msgstr "\"别！\""

#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
