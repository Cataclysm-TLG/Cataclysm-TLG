#: data/json/martialarts_fictional.json
msgid "* Only works on a <info>non-downed</info> target"
msgstr "* 仅对 <info>未被击倒</info> 的目标生效"

#. ~ Message of martial technique "Biojutsu Impale"
#: data/json/martialarts_fictional.json
#, c-format
msgid "<npcname> brutally impales %s with their weapon!"
msgstr "<npcname>无情地用武器穿刺了%s!"

#. ~ Message of martial technique "Disarm"
#: data/json/martialarts_fictional.json
#, c-format
msgid "<npcname> effortlessly disarms and stuns %s!"
msgstr "<npcname>轻而易举地缴械并击晕了%s！"

#. ~ Message of martial technique "Biojutsu Takedown"
#: data/json/martialarts_fictional.json
#, c-format
msgid "<npcname> kicks and slams %s to the ground!"
msgstr "<npcname>把%s绊倒在地!"

#. ~ Message of martial technique "Measured Strike (melee)"
#. ~ Message of martial technique "Measured Strike (unarmed)"
#: data/json/martialarts_fictional.json
#, c-format
