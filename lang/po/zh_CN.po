msgstr "收集 20 单位酵母"

#. ~ Response to NPC dialogue
#: data/json/npcs/tacoma_ranch/NPC_ranch_bartender.json
msgid "I'd like to exchange a token."
msgstr "我想用一个瓶盖换"

#. ~ Response to NPC dialogue
#: data/json/npcs/tacoma_ranch/NPC_ranch_bartender.json
