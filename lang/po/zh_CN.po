msgid "It <color_pink>looks like you'll slip</color> if you climb down like this."
msgstr "如果你就这么爬下去 <color_pink>多半免不了手滑</color> 。"

#: src/game.cpp:13782
msgid "It <color_pink>doesn't seem possible to climb down safely</color>."
msgstr "就这么爬下去 <color_pink>不出意外几乎是不可能的</color>。"

#: src/game.cpp:13788
msgid "Falling <color_pink>would kill you</color>."
msgstr "跌落后 <color_pink>会死</color>。"

#: src/game.cpp:13790
msgid "Falling <color_pink>could cripple or kill you</color>."
msgstr "跌落后 <color_pink>非死即残</color>。"

#: src/game.cpp:13792
msgid "Falling <color_pink>would break bones.</color>."
msgstr "跌落后 <color_pink>会骨折</color>。"

#: src/game.cpp:13794
msgid "Falling <color_red>would hurt badly</color>."
msgstr "跌落后 <color_red>会伤得很重</color>。"

#: src/game.cpp:13796
msgid "Falling <color_red>would hurt</color>."
msgstr "跌落后 <color_red>会受伤</color>."

#: src/game.cpp:13798
msgid "Falling <color_green>wouldn't hurt much</color>."
msgstr "跌落时 <color_green>不会伤得很重</color>。"

#: src/game.cpp:13809
#, c-format
msgid "Even if you climb down safely, you will fall <color_yellow>at least %d story</color>."
msgid_plural "Even if you climb down safely, you will fall <color_red>at least %d stories</color>."
msgstr[0] "即使你能够安全地爬下这层，你也会跌落 <color_red>至少 %d 层楼那么高</color>。"

#: src/game.cpp:13823
msgid "You <color_red>probably won't be able to climb back up</color>."
msgstr "你想爬回去的话 <color_red>多半是做不到的</color>。"

#: src/game.cpp:13825
msgid "You <color_green>should be easily able to climb back up</color>."
msgstr "你想爬回去的话 <color_green>应该很容易</color>。"

#: src/game.cpp:13828
msgid "You <color_yellow>may have problems trying to climb back up</color>."
msgstr "你想爬回去的话 <color_yellow>也许会有些麻烦</color>。"

#: src/game.cpp:13833
msgid "Climb down?"
msgstr "爬下去？"

#: src/game.cpp:13921
