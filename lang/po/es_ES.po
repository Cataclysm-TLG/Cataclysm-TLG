msgstr[0] "casco de desactivador de bombas (on)"
msgstr[1] "cascos de desactivador de bombas (on)"
msgstr[2] "cascos de desactivador de bombas (on)"

#. ~ Description of "ear plugs"
#: data/json/items/tool_armor.json
msgid "Industrial-grade ear plugs.  They fit inside the ears."
msgstr "Tapones industriales para los oídos. Se ponen dentro de la oreja."

#. ~ "msg" action message of item "phase immersion suit"
#: data/json/items/tool_armor.json
msgid ""
"Initiating\n"
"Running suit integrity diagnostics…\n"
"All systems operational."
msgstr ""
"Iniciando\n"
"Ejecutando los diagnósticos de integridad del traje...\n"
"Todos los sistemas operacionales.."

#. ~ "need_charges_msg" action message of item "five-point anchor"
#. ~ "need_charges_msg" action message of item "malfunctioning five-point anchor"
#: data/json/items/tool_armor.json
msgid "It seems like this device needs power."
msgstr "Tiene pinta de que el dispositivo necesita mas energía."

#. ~ "menu_text" action message of item "attached ear plugs (out)"
#. ~ "menu_text" action message of item "makeshift ear plugs (out)"
#: data/json/items/tool_armor.json
msgid "Plug in"
msgstr "Colocar"

#. ~ Item name
#: data/json/items/tool_armor.json
