msgid "Set which renderer to use.  Requires restart."
msgstr "Establezca qué renderizador usar. Requiere reiniciar el juego."

#: src/options.cpp:2600
msgid "Software rendering"
msgstr "Render por software"

#: src/options.cpp:2601
msgid ""
"Use software renderer instead of graphics card acceleration.  Requires "
"restart."
msgstr ""
"Utiliza el procesador de software en lugar de la aceleración de la tarjeta "
"gráfica. Requiere reiniciar el juego."

