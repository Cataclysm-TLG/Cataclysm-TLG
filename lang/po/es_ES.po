msgid "You light the firecracker."
msgstr "Enciendes el petardo."

#. ~ "msg" action message of item "pack of firecrackers"
#: data/json/items/tool/explosives.json
msgid "You light the pack of firecrackers."
msgstr "Enciendes el paquete de petardos."

#. ~ "need_fire_msg" action message of item "firecracker"
#. ~ "need_fire_msg" action message of item "pack of firecrackers"
#: data/json/items/tool/explosives.json
msgid "You need a source of fire!"
msgstr "¡Necesitas una fuente de fuego!"

#. ~ "msg" action message of item "bug bomb"
#: data/json/items/tool/explosives.json
#, c-format
msgid "You open the %s's release valve."
msgstr ""

#. ~ "msg" action message of item "packed M72 LAW"
#: data/json/items/tool/explosives.json
msgid "You pull the activating lever, readying the LAW to fire."
msgstr "Tiras de la palanca activadora, preparando el LAW para disparar."

#. ~ "msg" action message of item "fungicidal gas grenade"
