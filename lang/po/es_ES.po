#. ~ Description of "memory banks module"
#: data/json/items/robot_parts.json
msgid "A module that allows for the storage and recovery of information."
msgstr "Un módulo que permite almacenar y recuperar información."

#. ~ Description of "identification module"
#: data/json/items/robot_parts.json
msgid ""
"A module that continuously runs image recognition algorithms to "
"differentiate friend from foe."
msgstr ""
"Un módulo que ejecuta continuamente algoritmos de reconocimiento de imágenes "
"para diferenciar a los amigos de los enemigos."

#. ~ Description of "targeting module"
#: data/json/items/robot_parts.json
msgid ""
"A module that integrates visual and proprioceptive information from "
"peripheric sensors and outputs information necessary for accurate aiming."
msgstr ""
"Un módulo que integra información visual y propioceptiva información de los "
"sensores periféricos y produce la información necesaria para apuntar con "
"precisión."

#. ~ Description of "AI core"
#: data/json/items/robot_parts.json
msgid ""
"A module that is responsible for decision-making, it basically runs the AI "
"of a robot."
msgstr ""
"Un módulo responsable por la toma de decisiones, básicamente ejecuta la IA "
"del robot."

#. ~ Description of "pathfinding module"
#: data/json/items/robot_parts.json
msgid ""
"A module that uses a combination of vector integration and egocentric "
"mapping to find the best path available."
msgstr ""
"Un módulo que utiliza una combinación de integración de vectores y "
"cartografía egocéntrica para encontrar el mejor camino disponible."

#. ~ Description of "set of spidery legs"
#: data/json/items/robot_parts.json
msgid "A set of big pointy legs, like the ones found under a tripod."
msgstr ""
"Un conjunto de grandes patas puntiagudas, como las que se encuentran bajo un "
"trípode."

#. ~ Description of "set of android arms"
#: data/json/items/robot_parts.json
msgid "A set of human-like arms."
msgstr "Es un grupo de brazos similares a las humanos."

#. ~ Description of "set of android legs"
#: data/json/items/robot_parts.json
msgid "A set of human-like legs."
msgstr "Un conjunto de piernas como las de un humano."

#. ~ Description of "set of omni wheels"
#: data/json/items/robot_parts.json
msgid "A set of omni wheels, like the ones found under a police bot."
msgstr ""
"Un juego de ruedas omnidireccionales, como las que se encuentran bajo un "
"robot de la policía."

#. ~ Description of "set of rotors"
#: data/json/items/robot_parts.json
msgid "A set of rotors able to lift a small drone."
msgstr "Un conjunto de rotores capaces de levantar un pequeño dron."

#. ~ Description of "set of small tank treads"
#: data/json/items/robot_parts.json
msgid ""
"A set of small tank treads, like the ones used by the \"Beagle\" mini-tank."
msgstr ""
"Un conjunto de pequeñas orugas de tanque, como las que usa el mini-tanque "
"\"Beagle\"."

#. ~ Description of "set of tiny spidery legs"
#: data/json/items/robot_parts.json
msgid "A set of tiny, pointy legs, like the ones found under a skitterbot."
msgstr ""
"Un conjunto de pequeñas piernas puntiagudas, como las que se encuentran "
"debajo de un arañabot."

#. ~ Description of "gun operating system"
#: data/json/items/robot_parts.json
msgid "A system that can operate most conventional weapons."
msgstr "Un sistema que puede operar la mayoría de las armas convencionales."

#. ~ Description of "basic AI core"
#: data/json/items/robot_parts.json
msgid "A very basic AI core with minimal cognitive abilities."
msgstr "Un núcleo de IA muy básico con mínimas habilidades cognitivas."

#. ~ Description of "sensor array"
#: data/json/items/robot_parts.json
msgid ""
"A wide range of sensors meant to give the ability to perceive the "
"surrounding world."
msgstr ""
"Una amplia gama de sensores destinados a dar la capacidad de percibir el "
"mundo circundante."

#. ~ Item name
#: data/json/items/robot_parts.json
msgid "AI core"
msgid_plural "AI cores"
msgstr[0] "núcleo de IA"
msgstr[1] "núcleos de IA"
msgstr[2] "núcleos de IA"

#. ~ Description of "advanced AI core"
#: data/json/items/robot_parts.json
msgid "An advanced AI core with impressive cognitive abilities."
msgstr "Un avanzado núcleo de IA con impresionantes habilidades cognitivas."

#. ~ Description of "self monitoring sensors"
#: data/json/items/robot_parts.json
msgid ""
"An array of sensors and diagnostic modules allowing a robot to perceive "
"itself."
msgstr ""
"Un conjunto de sensores y módulos de diagnóstico que permiten al robot "
"percibirse a sí mismo."

#. ~ Description of "module template"
#: data/json/items/robot_parts.json
msgid "This is a template for robot module.  If found in a game it is a bug."
msgstr ""
"Esta es una plantilla para el módulo del robot. Si se encuentra en un juego "
"es un bug."

#. ~ Description of "police bot chassis"
#: data/json/items/robot_parts.json
msgid ""
