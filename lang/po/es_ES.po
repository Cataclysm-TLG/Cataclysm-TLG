#: src/player_hardcoded_effects.cpp:661 src/player_hardcoded_effects.cpp:722
#: src/player_hardcoded_effects.cpp:1356
msgid "A monster appears nearby!"
msgstr "¡Aparece un monstruo cerca!"

#: src/player_hardcoded_effects.cpp:662
msgid "Space folds impossibly around itself!"
msgstr ""

#: src/player_hardcoded_effects.cpp:672 src/player_hardcoded_effects.cpp:732
msgid "You shudder suddenly."
msgstr "De repente, sientes un escalofrío."

#: src/player_hardcoded_effects.cpp:688
msgid "You pass out."
msgstr "Te desmayaste."

