#. ~ Description of vehicle part "wall wirings"
#: data/json/furniture_and_terrain/appliances.json
msgid "Electric wires embedded in the wall."
msgstr "Cables eléctricos empotrados en la pared."

#. ~ Description of vehicle part "ap_ground_solar_panel_v2"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"Four high-performance solar panels arrayed together to provide energy when "
"exposed to direct sunlight."
msgstr ""

#. ~ Description of vehicle part "ap_ground_solar_panel"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"Four solar panels arrayed together to provide energy when exposed to direct "
"sunlight."
msgstr ""

#. ~ Description of vehicle part "hydraulic press"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"If you really want to squash something a lot, this is exactly the right "
"industrial tool for you.  Plugged in and ready to go."
msgstr ""
"Si realmente quieres aplastar algo mucho, esta sería exactamente la "
"herramienta industrial adecuada para ti. Enchufada y lista para ser usada."

#. ~ Description of vehicle part "stationary water purifier"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"This device effectively sterilizes water.  Activate it to clean all water in "
"a connected tank, at the cost of some electricity."
msgstr ""
"El dispositivo esterilizada agua de forma efectiva. Activar para limpiar "
"toda el agua en un tanque conectado, a cambio de un poco de electricidad."

#. ~ Description of vehicle part "air compressor"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"This durable tank is topped with a motor that will cram as much air into the "
"tank as possible.  Plugged in and ready to go."
msgstr ""
"Este resistente depósito está provisto de un motor que introduce la mayor "
"cantidad de aire posible dentro. Enchufado y listo para ser usado."

#. ~ Description of vehicle part "folding solar panel"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"This folding solar panel has been unfolded and is ready to charge connected "
"devices using the power of the sun."
msgstr ""

#. ~ Description of vehicle part "advanced folding solar panel"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"This high-end solar panel has been unpacked and is ready to supply power, "
"provided it's out in the sun."
msgstr ""

#. ~ Description of vehicle part "router table"
#: data/json/furniture_and_terrain/appliances.json
msgid ""
"This table has an inset router, a rotating motor with an exchangeable blade "
"head for cutting specific profiles and grooves.  Plugged in and ready to go."
msgstr ""
"Esta mesa tiene una fresadora, un motor rotativo con un cabezal de cuchilla "
"intercambiable para cortar perfiles y ranuras específicas y cosas así. "
"Enchufada y lista para ser usada."

