msgstr ""

#. ~ Description of "active tear gas payload"
#: data/json/items/tool/misc.json
msgid ""
"This is a dummy item used by tear gas hacks that just so happens to be "
"counting down.  You should never see it outside of debug."
msgstr ""
"Este es un artículo falso usado por los guardias de gas lacrimógeno que "
"casualmente está en cuenta regresiva. Nunca deberías verlo fuera de la "
"depuración."

#. ~ Description of "tear gas payload"
#: data/json/items/tool/misc.json
msgid ""
"This is a dummy item used by tear gas hacks.  You should never see it "
"outside of debug."
msgstr ""
"Este es un artículo falso usado por los hacks de gas lacrimógeno. Nunca "
"deberías verlo fuera de la depuración."

