#: data/json/npcs/LIXA_talk.json
msgid "ERROR: Power Draw"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/LIXA_talk.json
msgid ""
"Emergency shutdown halted:  ERROR unsafe power discharge, ERROR active "
"compressors"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/LIXA_talk.json
msgid "Open LAYMAN BRIEFING."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/LIXA_talk.json
msgid ""
"Power draw experiencing instability.  Current power input:  negative ERROR "
"STACK OVERFLOW kJ/s."
msgstr ""

