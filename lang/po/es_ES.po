#. ~ "menu_text" action message of item "torch"
#: data/json/items/tool/lighting.json
msgid "Light torch"
msgstr "Antorcha de luz"

#. ~ "menu_text" action message of item "atomic headlamp (covered)"
#. ~ "menu_text" action message of item "atomic lamp (covered)"
#: data/json/items/tool/lighting.json data/json/items/tool_armor.json
msgid "Open cover"
msgstr "Abrir cubierta"

#. ~ Description of "atomic lamp"
#: data/json/items/tool/lighting.json
msgid ""
"Powered by the magic of nuclear decay and low-energy LEDs, this device will "
"provide just enough light to read by for at least a decade.  Use it to close "
"the cover and hide the light."
msgstr ""

#. ~ Description of "atomic lamp (covered)"
#: data/json/items/tool/lighting.json
msgid ""
"Powered by the magic of nuclear decay and low-energy LEDs, this expensive "
"little light will provide just enough light to read by for at least a "
"decade.  It is also available with a cute cartoon bear cover to turn it into "
"a nightlight for a very wealthy child with a fear of the dark.  The cover is "
"closed.  Use it to open the cover and show the light."
msgstr ""

#. ~ "menu_text" action message of item "flare"
#: data/json/items/tool/lighting.json
msgid "Strike the striker"
msgstr "Golpea al atacante"

