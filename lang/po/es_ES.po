#. ~ Description of "yukata"
#: data/json/items/armor/coats.json
msgid ""
"A Japanese robe similar to a Kimono, it's made of lightweight cotton, "
"perfect for the Summer."
msgstr ""

#. ~ Description of "grim reaper's robe"
#: data/json/items/armor/coats.json
msgid ""
"A black hooded grim reaper's robe with a face cover to hide the user's lack "
"of facial skin.  It pairs nicely with a scythe.  Use it to remove the face "
"cover and show yourself before your victims."
msgstr ""
"Una túnica negra con capucha de la Parca con una cubierta facial para "
"ocultar la ausencia de piel del rostro del usuario. Se combina muy bien con "
"una guadaña. Úsala para quitarte la cubierta facial y mostrarte ante tus "
"víctimas."

#. ~ Description of "emergency jacket"
#: data/json/items/armor/coats.json
msgid ""
"A bright, cheaply made FEMA-issue windbreaker jacket with a hood.  It's not "
"much, but it might keep you from freezing until rescue arrives, assuming "
"anyone's coming..."
msgstr ""

#. ~ Description of "winter coat"
#: data/json/items/armor/coats.json
msgid "A bulky winter coat sized for a toddler."
msgstr ""

#. ~ Description of "cheap ghost's robe"
#: data/json/items/armor/coats.json
msgid ""
"A cheap ghost costume comprised of a white sheet with two eye holes cut "
"out.  A simple hat is worn underneath to keep the sheet in place."
msgstr ""
"Un disfraz fantasma barato compuesto por una sábana blanca con dos agujeros "
"para los ojos recortados. Se lleva un simple sombrero debajo para mantener "
"la sábana en su sitio."

#. ~ Description of "nun habit"
#: data/json/items/armor/coats.json
msgid "A dark piece of clerical clothing.  Typically worn by Christian nuns."
msgstr ""

#. ~ Description of variant "dobok" of item "gi"
#: data/json/items/armor/coats.json
msgid ""
"A distinctive cloth jacket worn by practitioners of the Korean art of "
"Taekwando.  It's lightweight, but sturdy enough to go to the mat."
msgstr ""

#. ~ Description of "chef's jacket"
#: data/json/items/armor/coats.json
msgid "A double-breasted uniform to protect against the heat of the kitchen."
msgstr ""
"Un uniforme de doble botonadura para protegerse del calor en la cocina."

#. ~ Description of "gi"
#. ~ Description of variant "gi" of item "gi"
#: data/json/items/armor/coats.json
msgid ""
"A durable cloth jacket used as the top half of a uniform in many Japanese "
"martial arts."
msgstr ""

#. ~ Description of "combat blouse"
#: data/json/items/armor/coats.json
msgid ""
"A fitted camouflage jacket, referred to as a blouse because it is worn "
"untucked as part of a modern military uniform."
msgstr ""

#. ~ Description of "tuxedo"
#: data/json/items/armor/coats.json
msgid "A full-body tuxedo, because even now, life is more than mere survival."
msgstr ""

#. ~ Description of "longcoat"
#: data/json/items/armor/coats.json
msgid ""
"A full-length coat made of tough, rain-repellant material.  It has several "
"pockets."
msgstr ""

#. ~ Description of "fur longcoat"
#: data/json/items/armor/coats.json
msgid "A full-length coat made of warm animal fur."
msgstr ""

#. ~ Description of "leather longcoat"
#: data/json/items/armor/coats.json
msgid "A full-length leather coat with many pockets for storage."
msgstr ""

#. ~ Description of "turnout coat"
#: data/json/items/armor/coats.json
msgid ""
"A heavy protective coat worn by firefighters, highly resistant to heat and "
"flame."
msgstr ""
"Capa protectora pesada que llevan los bomberos, muy resistente al calor y a "
"las llamas."

#. ~ Description of "peacoat"
#: data/json/items/armor/coats.json
msgid "A heavy wool coat, warm and with deep pockets."
msgstr "Un abrigo de lana pesado, cálido y con bolsillos profundos."

#. ~ Description of "jean jacket"
#: data/json/items/armor/coats.json
msgid "A jacket made from denim."
msgstr "Una chaqueta de tela vaquera."

#. ~ Description of "flannel jacket"
#: data/json/items/armor/coats.json
msgid "A jacket made from flannel, favored by outdoorsy types."
msgstr ""

#. ~ Description of "faux fur coat"
#: data/json/items/armor/coats.json
msgid ""
"A jacket made of fake animal fur.  While not as fancy as a fur coat, its "
"garish appearance still makes quite a statement."
msgstr ""

#. ~ Description of "tactical jacket"
#: data/json/items/armor/coats.json
msgid "A jacket with a hood and several pockets."
msgstr ""

#. ~ Description of "varsity jacket"
#: data/json/items/armor/coats.json
msgid ""
"A letterman jacket, the type that the jocks in a highschool or a college "
"would wear."
msgstr ""

#. ~ Description of "windbreaker"
#: data/json/items/armor/coats.json
msgid ""
"A light synthetic jacket with a hood.  Not very warm, but will keep out the "
"rain."
msgstr ""
"Una chaqueta ligera sintética con capucha. No es muy abrigado, pero te "
"protegerá de la lluvia."

#. ~ Description of "nylon bomber jacket"
#: data/json/items/armor/coats.json
msgid "A lightweight nylon bomber jacket."
msgstr ""

#. ~ Description of "greatcoat"
#: data/json/items/armor/coats.json
msgid "A long overcoat made from durable heavyweight wool."
msgstr ""

#. ~ Description of "lab coat"
#: data/json/items/armor/coats.json
msgid ""
"A long white coat with several large pockets.  Comes with a very nice pocket "
"protector."
msgstr ""
"Una bata larga y blanca con varios bolsillos grandes. Viene con un agradable "
"protector para los bolsillos."

#. ~ Description of "thawb"
#: data/json/items/armor/coats.json
msgid ""
"A long, loose-fitting robe with wide sleeves.  A traditional Arab garment."
msgstr ""
"Túnica larga y holgada con mangas anchas. Una prenda tradicional árabe."

#. ~ Description of "robe"
#: data/json/items/armor/coats.json
msgid "A long, plush housecoat, perfect for lounging around the house."
msgstr ""

#. ~ Description of "tunic"
#: data/json/items/armor/coats.json
msgid "A long-sleeved top that drapes almost to the knees."
msgstr ""

#. ~ Description of "haori"
#: data/json/items/armor/coats.json
msgid ""
"A loose coat with wide sleeves that is typically worn unfastened over a "
"kimono."
msgstr ""

#. ~ Description of "tangzhuang"
#: data/json/items/armor/coats.json
msgid ""
"A loose-fitting Chinese jacket with a mandarin collar and frog ties down the "
"front.  These were once common street fashion in China, but have long since "
"become associated with martial arts from that country."
msgstr ""

#. ~ Description of "rag tunic"
#: data/json/items/armor/coats.json
msgid ""
"A makeshift knee-length robe with a string tied around the waist to keep it "
