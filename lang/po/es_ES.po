msgctxt "npc:n"
msgid ""
"&The mercenary stares at the window, and speaks in a quiet and terse "
"manner.  \"I have a client looking for a medical-grade human biopsy sample, "
"no questions asked.  Are you the right one for the job?"
msgstr ""
"&El mercenario mira la ventana y habla de una manera cortante y suave. "
"\"Tengo un cliente que busca una muestra de biopsia humana, sin hacer "
"preguntas. ¿Estás como para realizar ese trabajo?"

#. ~ Description of mission "Fleshmonger"
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
msgid ""
"Deposit a human sample in a pit within the dead drop location.  Pick up your "
"reward at the Terminal once that's done."
msgstr ""

#. ~ Mission name
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
msgid "Fleshmonger"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
msgid "I might be."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
msgid "It'll get done."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
msgid ""
"Most I can give is two gold coins.  I've arranged a drop in the nearby "
"woods, put the goods there and you can get your cash with the barkeep here."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
msgid "No deal."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
msgid "No, but I might be looking to buy some."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
msgid "No, not at all."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
msgid "Not interested after all?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
msgid "Oh yes.  I actually have one right here."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
msgid "Sure, just let me find the cash."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
msgid "Sure, whatever."
msgstr "Claro, lo que sea."

#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
msgid "[5 HGC] Its a deal."
msgstr ""

