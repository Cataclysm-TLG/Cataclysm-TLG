#: data/json/items/vehicle/wheel.json data/json/vehicleparts/wheel.json
msgid ""
"A set of small wheels mounted on pivots, like you'd find on a rolling office "
"chair."
msgstr ""

#. ~ Description of "concrete mixer wheel mounts"
#. ~ Description of vehicle part "concrete mixer wheel mounts"
#: data/json/items/vehicle/wheel.json data/json/vehicleparts/wheel.json
msgid "A set of two small wheel mounts from a concrete mixer."
msgstr ""

#. ~ Description of "concrete mixer wheels"
#: data/json/items/vehicle/wheel.json
msgid "A set of two small wheels from a concrete mixer."
msgstr ""

#. ~ Description of "set of large casters"
#: data/json/items/vehicle/wheel.json
msgid ""
"A set of wheels mounted on pivots, like you'd find a dumpster or a generator."
msgstr ""

#. ~ Description of "metal wheel"
#: data/json/items/vehicle/wheel.json
msgid "A simple metal wheel."
msgstr "Un sencilla rueda de metal."

#. ~ Description of "16" racing tire"
#: data/json/items/vehicle/wheel.json
msgid "A slick 16\" racing car tire for fitting to a medium steel rim."
msgstr ""
"Un neumático de coche de carreras de 16\" para montar en una llanta de acero "
"mediana."

#. ~ Description of "wheelbarrow wheel"
#: data/json/items/vehicle/wheel.json
msgid "A small wheel from a common garden wheelbarrow."
msgstr "Una rueda pequeña como la de una carretilla normal de jardinería."

#. ~ Description of "17" car tire"
#: data/json/items/vehicle/wheel.json
msgid "A standard 17\" car tire for fitting to a medium steel rim."
msgstr ""
"Un neumático de coche estándar de 17\" para montar en una llanta de acero "
"mediana."

#. ~ Description of "steel motorbike rim"
#: data/json/items/vehicle/wheel.json
msgid "A steel rim for a motorbike tire."
msgstr "Una llanta de acero para un neumático de motocicleta."

#. ~ Description of "rail wheel"
#: data/json/items/vehicle/wheel.json
msgid ""
"A strong rail wheel.  A flange helps keep it on a rail, but makes it perform "
"terribly when not on a rail."
msgstr ""
"Una fuerte rueda de ferrocarril. Una pestaña ayuda a mantenerla en un riel, "
"pero hace que funcione terriblemente cuando no está en un riel."

#. ~ Description of "skate wheel"
#: data/json/items/vehicle/wheel.json
msgid ""
"A very small plastic wheel with a punk attitude.  This wheel was made for "
"skating."
msgstr ""
"Una rueda de plástico muy pequeña con una actitud punk. Esta rueda fue hecha "
"para hacer skating."

#. ~ Description of "armored wheel"
#: data/json/items/vehicle/wheel.json
msgid "A wide military-grade wheel."
msgstr "Una rueda ancha de grado militar."

#. ~ Description of "wide steel rim"
#: data/json/items/vehicle/wheel.json
msgid "A wide steel rim for a larger tire."
msgstr "Una llanta de acero ancha para un neumático más grande."

#. ~ Description of "24" wide tire"
#: data/json/items/vehicle/wheel.json
msgid "A wide tire for fitting to a wide steel rim."
msgstr "Un neumático ancho que se ajusta en una llanta de acero ancha."

#. ~ Description of "24" off-road wide tire"
#: data/json/items/vehicle/wheel.json
msgid ""
"A wide tire for fitting to a wide steel rim.  It's studded to provide better "
"grip off-road at the cost of some performance on pavement."
msgstr ""
"Un neumático ancho para montar en una llanta de acero ancha. Está provisto "
"de tacos para proporcionar un mejor agarre fuera de la carretera a costa de "
"algunas prestaciones en el asfalto."

#. ~ Description of "wide wheel"
#: data/json/items/vehicle/wheel.json
msgid "A wide wheel.  \\o/ This wide."
msgstr "Una rueda ancha. Así de ancha  \\o/ ."

#. ~ Description of "deflated 24" wide wheel"
#: data/json/items/vehicle/wheel.json
msgid ""
"A wide wheel.  \\o/ This wide.  It is currently deflated and will need to be "
"inflated to be used on a vehicle."
msgstr ""
"Una rueda ancha. \\o/ - Así de ancha. Actualmente está desinflada y será "
"necesario inflarla para utilizarla en un vehículo."

#. ~ Description of "off-road wide wheel"
#: data/json/items/vehicle/wheel.json
msgid ""
"A wide wheel.  \\o/ This wide.  It's studded to provide better grip off-road "
"at the cost of some performance on pavement."
msgstr ""
"Es una rueda ancha. Así de ancha \\o/ . Tiene tacos grandes para brindar "
"mejor agarre en todo terreno, pero tiene un menor rendimiento en pavimento."

#. ~ Description of "deflated 24" off-road wide wheel"
#: data/json/items/vehicle/wheel.json
msgid ""
"A wide wheel.  \\o/ This wide.  It's studded to provide better grip off-road "
"at the cost of some performance on pavement.  It is currently deflated and "
"will need to be inflated to be used on a vehicle."
msgstr ""
"Una rueda ancha. \\o/ - Así de ancha. Está provista de tacos para "
"proporcionar un mejor agarre fuera de la carretera a costa de algunas "
"prestaciones en el pavimento. Actualmente está desinflada y será necesario "
"inflarla para utilizarla en un vehículo."

#. ~ Description of "deflated 16" racing wheel"
#: data/json/items/vehicle/wheel.json
msgid ""
"A wide, smooth wheel intended for racing.  It is currently deflated and will "
"need to be inflated to be used on a vehicle."
msgstr ""
"Una rueda ancha y lisa destinada a las carreras. Actualmente está desinflada "
"y será necesario inflarla para utilizarla en un vehículo."

#. ~ Description of "racing wheel"
#: data/json/items/vehicle/wheel.json
msgid ""
"A wide, smooth wheel intended for racing.  The slick surface provides better "
"speed on pavement but penalizes off-road speed."
msgstr ""
"Una rueda lisa y ancha, diseñada para carreras. La superficie resbaladiza "
"brinda mayor velocidad en el pavimento pero menor en otros terrenos."

#. ~ Description of "27" off-road bicycle tire"
#: data/json/items/vehicle/wheel.json
msgid ""
"A wide, studded bicycle tire intended to be fitted to a bicycle rim for off-"
"road biking."
msgstr ""
"Neumático de bicicleta ancho, con tacos, destinada a ser montada en una "
"llanta de bicicleta para el ciclismo todoterreno."

#. ~ Description of "off-road bicycle wheel"
#: data/json/items/vehicle/wheel.json
msgid "A wide, studded bicycle wheel intended for off-road biking."
msgstr ""
"Una rueda de bicicleta ancha, con tacos, destinada a la bicicleta todo "
"terreno."

#. ~ Description of "deflated 27" off-road bicycle wheel"
#: data/json/items/vehicle/wheel.json
msgid ""
"A wide, studded, bicycle wheel intended for off-road biking.  It is "
"currently deflated and will need to be inflated to be used on a vehicle."
msgstr ""
"Una rueda de bicicleta ancha, con tacos, destinada a la práctica del "
"ciclismo todoterreno. Actualmente está desinflada y será necesario inflarla "
"para utilizarla en un vehículo."

#. ~ Description of "small wheels"
#: data/json/items/vehicle/wheel.json
msgid ""
"Two small plastic wheels snapped onto a simple wire axle, the kind you'd see "
"on a child's wagon or a rolling trash can."
msgstr ""

