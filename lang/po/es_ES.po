msgid "Care to trade?"
msgstr "¿Quieres comerciar?"

#. ~ Description of mission "House cleaning"
#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
msgid "Clean lighthouse from <zombies> with Mikhail."
msgstr "Limpia el faro de <zombies> com Mikhail."

#. ~ Dialogue line in mission "Fisherman's boat"
#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
msgid "Did you find it?"
msgstr "¿Lo has encontrado?"

#. ~ NPC dialogue line
