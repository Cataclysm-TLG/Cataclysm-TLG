msgid "Canning Food"
msgstr "Enlatado de Comida"

#. ~ Proficiency name
#: data/json/proficiencies/comestibles.json
msgid "Cheesemaking Expert"
msgstr "Quesería Experta"

#. ~ Description of proficiency "Forager Cooking"
#: data/json/proficiencies/comestibles.json
msgid ""
"Cooking with foraged ingredients that you wouldn't find in most cookbooks."
msgstr ""
"Cocinar con ingredientes recogidos que no se encuentran en la mayoría de los "
"libros de cocina."

#. ~ Proficiency name
#: data/json/proficiencies/comestibles.json
msgid "Culinary Fermentation"
msgstr "Fermentación Culinaria"

#. ~ Proficiency name
#: data/json/proficiencies/comestibles.json
msgid "Curing and Drying Food"
msgstr "Curado y Secado"

