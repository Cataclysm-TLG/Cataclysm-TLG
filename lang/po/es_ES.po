#: data/json/items/generic.json
msgid "MELCHIOR report"
msgid_plural "MELCHIOR reports"
msgstr[0] "reporte MELCHIOR"
msgstr[1] "reportes MELCHIOR"
msgstr[2] "reportes MELCHIOR"

#. ~ Description of "burnt out bionic"
#: data/json/items/generic.json
msgid ""
"Once a valuable bionic implant, it has not held up well under repeated use.  "
"It has been destroyed by excessive electric current and is now useless."
msgstr ""
"Lo que fuera un valioso implante biónico, no ha aguantado bien su uso de "
"forma repetida. Este objeto ha sido destruido por una corriente eléctrica "
"excesiva y ahora no sirve para nada."

#. ~ Item name
#: data/json/items/generic.json
msgid "RAM"
msgid_plural "RAMs"
msgstr[0] "RAM"
msgstr[1] "RAMs"
msgstr[2] "RAMs"

#. ~ Description of "rough terrain"
#: data/json/items/generic.json
msgid "Seeing this is a bug."
msgstr "Ver esto es un bug."

#. ~ Description of "file"
#: data/json/items/generic.json
msgid ""
"Several documents containing all kinds of information, customer data, and "
"charts, kept together in a manila folder.  Pretty useless now."
msgstr ""
"Varios documentos con toda clase de información, datos de clientes y "
"gráficos juntados en una carpeta manila. Bastante inútil ahora."

#. ~ Description of "cigarette"
#: data/json/items/generic.json
msgid ""
"Smoke swirls from the lit end of this cigarette, filling the air with the "
"thrilling smell of burning chemicals."
msgstr ""
"El humo forma un espiral desde la punta encendida de este cigarrillo, "
"llenando el aire con el sensacional olor de químicos quemados."

#. ~ Description of "unfinished koji rice"
#. ~ Description of "unfinished koji rice (obsolete)"
#: data/json/items/generic.json
#: data/json/obsoletion_and_migration/obsoletion.json
msgid ""
"Some cooked rice mixed with yeast and koji mold fragments, set aside to let "
"koji mold grow on it so that it can make a passable sake base."
msgstr ""
"Un poco de arroz cocido mezclado con levadura y partes de moho koji, y "
"apartado para dejar que el moho koji crezca en él y así poder hacer una base "
"de sake pasable."

#. ~ Description of "growing wild koji mold"
#. ~ Description of "growing wild koji mold (obsolete)"
#: data/json/items/generic.json
#: data/json/obsoletion_and_migration/obsoletion.json
msgid ""
"Some cooked rice sprinkled with ash and wrapped into a corn husk.  If left "
"alone for a while, it will most likely grow koji mold."
msgstr ""
"Un poco de arroz cocido espolvoreado con ceniza y envuelto en una hoja de "
"maíz. Si se deja tranquilo durante un tiempo, lo más probable es que crezca "
"moho koji."

#. ~ Description of "grown wild koji mold"
#: data/json/items/generic.json
msgid ""
"Some cooked rice sprinkled with ash and wrapped into a corn husk.  It has "
"grown patches of koji mold inside; disassemble this item to extract it."
msgstr ""
"Un poco de arroz cocido espolvoreado con ceniza y envuelto en una hoja de "
"maíz. En su interior han crecido manchas de moho koji; desmonte este "
"artículo para extraerlo."

#. ~ Description of "lime mortar"
#: data/json/items/generic.json
msgid ""
"Some lime mortar, made from quicklime and aggregate and ready for building."
msgstr "Un mortero de cal, hecho con cal viva y árida, listo para construir."

#. ~ Description of "dry concrete mix"
#: data/json/items/generic.json
msgid ""
"Some mixed cement, sand and aggregates, precombined and ready to be used in "
"a construction project."
msgstr ""

#. ~ Description of "mortar"
#: data/json/items/generic.json
msgid "Some mortar, ready to be used in building projects."
msgstr "Un poco de mortero, listo para ser usado en proyectos de construcción."

#. ~ Description of "handful of leaves"
#: data/json/items/generic.json
msgid ""
"Some ordinary, mostly dry leaves.  They have very few uses and are thus "
"(almost) only good for burning."
msgstr ""
"Unas hojas ordinarias, casi siempre secas. Tienen muy pocos usos y por lo "
"tanto (casi) sólo sirven para quemar."

#. ~ Description of "koji rice"
#: data/json/items/generic.json
msgid ""
"Some rice covered in koji mold, mixed in with yeast.  Useful for making "
"sake, but not really tasty on its own.  Smells vaguely of chestnuts."
msgstr ""
"Un poco de arroz cubierto de moho koji, mezclado con levadura. Útil para "
"hacer sake, pero no muy sabroso por sí solo. Huele vagamente a castañas."

#. ~ Description of "laboratory shipping records"
#: data/json/items/generic.json
msgid ""
"Some type of advanced data storage device, filled with logistical data on "
"subterranean train routes and schedules."
msgstr ""
"Algún tipo de dispositivo de almacenamiento de datos avanzado, repleto de "
"datos logísticos sobre rutas y horarios de trenes subterráneos."

#. ~ Description of "superglue"
#: data/json/items/generic.json
msgid "Strong cyanoacrylate glue."
msgstr ""

#. ~ Description of "bundle of planks"
#: data/json/items/generic.json
msgid ""
"Ten construction planks securely tied together for easier transport.  "
"Disassemble to untie them."
msgstr ""
"Diez tablones de construcción seguramente atados juntos para facilitar el "
"transporte. Desmontar para desatarlos."

#. ~ Description of "bundle of copper tubing"
#: data/json/items/generic.json
msgid ""
"Ten copper pipes securely tied together for easier transport.  Disassemble "
"to untie them."
msgstr ""
"Diez tupos de cobre seguramente atados juntos para facilitar el transporte. "
"Desmontar para desatarlos."

#. ~ Description of "bundle of pipes"
#: data/json/items/generic.json
msgid ""
"Ten pipes securely tied together for easier transport.  Disassemble to untie "
"them."
msgstr ""
"Diez tupos seguramente atados juntos para facilitar el transporte. Desmontar "
"para desatarlos."

#. ~ Description of "bundle of rebar"
#: data/json/items/generic.json
msgid ""
"Ten rods of rebar securely tied together for easier transport.  Disassemble "
"to untie them."
msgstr ""
"Diez piezas de barras corrugadas seguramente atadas juntas para facilitar el "
"transporte. Desmontar para desatarlas."

#. ~ Description of "bundle of sticks"
#: data/json/items/generic.json
msgid ""
"Ten sticks securely tied together for easier transport.  Disassemble to "
"untie them."
msgstr ""
"Diez palos seguramente atados juntos para facilitar el transporte. Desmontar "
"para desatarlos."

#. ~ Description of "broken grocery bot"
#: data/json/items/generic.json
msgid ""
"The body of a busted grocery bot.  Its tarnished face is still smiling.  "
"Could be gutted for parts."
msgstr ""
"El cuerpo de un mercadobot roto. Su rostro empañado aún sonríe. Se podría "
"desmontar para recuperar sus partes."

#. ~ Description of "joint"
#: data/json/items/generic.json
msgid ""
"The smell of skunk permeates the air as a thin trail of smoke floats off of "
"this joint."
msgstr ""
"El olor a mofeta penetra en el aire mientras el fino rastro de humo flota "
"desde este porro."

#. ~ Description of "cigar"
#: data/json/items/generic.json
msgid "The smoke billowing from this cigar has a sweet, musty odor."
msgstr "El humo de este cigarro forma una nube con un aroma dulce y húmedo."

#. ~ Description of "joint roach"
#: data/json/items/generic.json
msgid ""
"The smoked-down butt of a joint, a reminder of some good times.  Pretty much "
"trash now.  Bummer, man.\n"
"A few of these could probably be used to roll another joint."
msgstr ""
"La parte final de un porro fumado, un souvenir de tiempos mejores. Esto es "
"casi basura. Qué bajón, tio.\n"
"Con varios de estos probablemente te puedas armar otro porro."

#. ~ Description of "drum skin"
#: data/json/items/generic.json
msgid ""
"The tanned hide of an animal repurposed to become the head on a percussion "
"drum."
msgstr ""

#. ~ Description of "sunflower"
#: data/json/items/generic.json
msgid ""
"The top of a sunflower, with yellow petals and some seeds that have yet to "
"be eaten by animals."
msgstr ""
"La parte superior de un girasol, con pétalos amarillos y algunas semillas "
"que aún no han sido comidas por los animales."

#. ~ Description of "fluid-preserved brain"
#: data/json/items/generic.json
msgid ""
"This 3 L jar contains a human brain preserved in a formaldehyde solution."
msgstr ""

#. ~ Description of "gold gas discount card"
#: data/json/items/generic.json
msgid "This card gives you a good discount on the purchase of gasoline."
msgstr "Esta tarjeta te hace un buen descuento cuando compras combustible."

#. ~ Description of "silver gas discount card"
#: data/json/items/generic.json
msgid "This card gives you a little discount on the purchase of gasoline."
msgstr "Esta tarjeta te hace un pequeño descuento cuando compras combustible."

#. ~ Description of "platinum gas discount card"
#: data/json/items/generic.json
msgid "This card gives you a splendid discount on the purchase of gasoline."
msgstr ""
"Esta tarjeta te hace un espléndido descuento cuando compras combustible."

#. ~ Description of "military parachute"
#: data/json/items/generic.json
msgid ""
"This is a big, bulky military-level parachute, designed to slow the fall of "
"up to a thousand kilograms of cargo dropped from an aircraft.  You have no "
"clue how to put all the straps back in their place."
msgstr ""

#. ~ Description of "wooden pallet"
#: data/json/items/generic.json
msgid "This is a heavy and bulky 40x48 inch palette."
msgstr ""

#. ~ Description of "in-progress craft"
#: data/json/items/generic.json
msgid "This is an in-progress craft."
msgstr "Esta es una fabricación en curso."

#. ~ Description of "in-progress disassembly"
#: data/json/items/generic.json
msgid "This is an in-progress disassembly."
msgstr "Esto es un desensamblado en curso."

#. ~ Description of "bundle of cloth sheets"
#: data/json/items/generic.json
