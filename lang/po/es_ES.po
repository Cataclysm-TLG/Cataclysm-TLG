#: src/consumption.cpp:908
msgid "Eww.  Inedible plant stuff!"
msgstr "¡Qué asquito! ¡Sustancia vegetal intragable!"

#: src/consumption.cpp:915
msgid "The thought of eating that makes you feel sick."
msgstr "La idea de comerte eso te provoca nauseas."

#: src/consumption.cpp:928
