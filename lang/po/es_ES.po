#: data/json/npcs/TALK_NC_FARMER.json
msgid "How did you make it?"
msgstr "¿Cómo lo hiciste?"

#. ~ Response to NPC dialogue
#: data/json/npcs/TALK_NC_FARMER.json
msgid "I don't have time for this."
msgstr "No tengo tiempo para esto."

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/Cataclysm-TLG/Cataclysm-TLG/blob/master/doc/TRANSLATING.md#grammatical-gender
#: data/json/npcs/TALK_NC_FARMER.json
msgctxt "npc:f"
msgid ""
"I grew up on the farm, I don't know much about ghosts and goblins, but I've "
"spent a lot of time growing food and I work hard.  It's better in the "
"country, cleaner.  Not as dangerous.  I hope."
msgstr ""
"Crecí en una granja, no sé mucho sobre fantasmas y duendes, pero he pasado "
"mucho tiempo cultivando alimentos y trabajo intensamente. Es mejor en el "
"campo, más limpio. No es tan peligroso. Eso espero."

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/Cataclysm-TLG/Cataclysm-TLG/blob/master/doc/TRANSLATING.md#grammatical-gender
