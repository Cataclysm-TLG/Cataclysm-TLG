#. ~ Monster message of special attack of monster "giant fire ant"
#: data/json/monsters/insect_spider.json
#, c-format
msgid "The %s sprays fire!"
msgstr ""

#. ~ Death message of monster "giant fire ant"
#: data/json/monsters/insect_spider.json
#, c-format
msgid "The %s's body hisses as gas escapes from its remains."
msgstr ""

#. ~ Death message of monster "cave worm"
#. ~ Death message of monster "giant acidic ant"
