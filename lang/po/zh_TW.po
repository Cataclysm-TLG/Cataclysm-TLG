msgstr "[1 商票 / 格] 我想種些種子。"

#. ~ Response to NPC dialogue
#: data/json/npcs/tacoma_ranch/NPC_ranch_crop_overseer.json
msgid "[100 merch] Yeah, let's do it."
msgstr "[100 商票] 可以，就這麼做。"

#. ~ Response to NPC dialogue
#: data/json/npcs/tacoma_ranch/NPC_ranch_crop_overseer.json
msgid "[200 merch] Alright, build me a fence."
msgstr "[200 商票] 很好，幫我蓋圍籬。"

#. ~ Response to NPC dialogue
#: data/json/npcs/tacoma_ranch/NPC_ranch_crop_overseer.json
