msgstr "%s 正在掃描周圍的環境。"

#: src/monattack.cpp:2522
msgid ""
"a soft robotic voice say, \"Welcome doctor <male_full_name>.  I'll be your "
"assistant today.\""
msgstr ""

#: src/monattack.cpp:2523
msgid ""
"a soft robotic voice say, \"Welcome doctor <female_full_name>.  I'll be your"
" assistant today.\""
msgstr ""

