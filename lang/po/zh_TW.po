#. ~ Response to NPC dialogue
#: data/json/npcs/necc/members/NPC_Aunt_Theresa.json
msgid "Could you make something for me?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/necc/members/NPC_Aunt_Theresa.json
msgid "Do you knit at all?  I noticed you have sewing needles."
