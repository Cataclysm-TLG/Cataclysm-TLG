msgstr ""

#. ~ Description of "canned sardine"
#: data/json/items/comestibles/meat_dishes.json
msgid "Salty little fish.  They'll make you thirsty."
msgstr "鹽漬的小魚。會讓你口渴。"

#. ~ Description of "currywurst"
#: data/json/items/comestibles/meat_dishes.json
