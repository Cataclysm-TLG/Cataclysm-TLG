msgstr "\"只是個擦傷。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's just repeating us.\""
msgstr "\"他就只是重複著我們說的話。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's looking for us.\""
msgstr "\"有東西在找我們。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's looking right at us.\""
msgstr "\"它當下正在找我們。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"It's parroting us, but we're uncertain as to how or why.\""
msgstr "\"這東西會模仿我們, 但是我們不確定原因。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's probably more scared of us than we are of it.\""
msgstr "\"那東西可能比較怕我們。\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"It's so cold.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"I… I feel weak…\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Just a little.\""
msgstr "\"再一點。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Just because it doesn't look like you doesn't mean that it isn't.\""
msgstr "\"只是看它長得不像你不代表它就沒智慧。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Just being an alien creature doesn't mean it's intelligent.\""
msgstr "\"只是個外星生物, 不代表他就有智慧。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Keep your hands up!\""
msgstr "“舉高雙手！”"

#. ~ Speech from speaker mon_civilian_zombiefighter
#: data/json/speech.json
msgid "\"Kick the bucket, filthy dead!\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Kill them all and let God sort them out!\""
msgstr "\"把他們都殺了去上帝面前排隊! \""

#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go,
#. mon_mi_go_abductor
#: data/json/speech.json
msgid "\"LEAVE!  NOW!\""
msgstr "\"滾開！馬上！\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Lemme outta here!\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Let me have a look at it.\""
msgstr "\"我來看看。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
