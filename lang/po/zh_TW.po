msgstr "\"我到處在找你們。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I've got a headache.\""
msgstr "\"我頭在痛了。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"I've got family coming tomorrow.\""
msgstr "\"我家人明天會來看我。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"I've seen horrors, horrors that you've seen.\""
msgstr "\"我已經見識過你看過的恐怖。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Individual instances of U-O Seven-Seven-Three-Four.\""
msgstr "\"U-O 7 - 7 - 3 - 4 的個別實驗。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
