msgid ""
"a soft robotic voice say, \"Unhand this patient immediately!  If you keep "
"interfering with the procedure I'll be forced to call law enforcement.\""
msgstr "柔和的機器人聲音說：“立即讓該患者接受治療！如果你繼續干涉該程序，我將被迫聯繫執法部門。”"

#: src/monattack.cpp:2614
msgid ""
"a soft robotic voice say, \"Greetings, nurse.  Please take good care of this"
" patient.\""
msgstr ""

