msgstr "%1$s 衝撞你的 %2$s, 但你的護甲避免了傷害!"

#: src/monattack.cpp:3424
#, c-format
msgid "The %1$s lunges at <npcname>'s %2$s, but their armor prevents injury!"
msgstr "%1$s 衝撞 <npcname> 的 %2$s, 但他的護甲避免了傷害!"

