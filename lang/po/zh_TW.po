#. ~ Name of a gun
#: data/json/items/gun/84x246mm.json
msgid "AT4 launcher"
msgid_plural "AT4 launchers"
msgstr[0] ""

#. ~ Item name
#. ~ Name of a gun
#: data/json/items/gun/84x246mm.json
msgid "M3 rocket launcher"
msgid_plural "M3 rocket launchers"
msgstr[0] ""

#. ~ Item name
#. ~ Name of a gun
#: data/json/items/gun/84x246mm.json
