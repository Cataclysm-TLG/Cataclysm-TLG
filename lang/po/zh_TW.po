#: data/json/bionics.json
msgid "Blood Analysis"
msgstr "血液分析"

#. ~ Name of a bionic
#: data/json/bionics.json
msgid "Blood Filter"
msgstr "血液過濾"

#. ~ Name of a bionic
#: data/json/bionics.json
msgid "Cable Charger System"
msgstr "電纜充電系統"

#. ~ Name of a bionic
#: data/json/bionics.json
msgid "Calorie Tracker"
msgstr "卡路里追蹤器"

#. ~ Name of a bionic
#: data/json/bionics.json
msgid "Cerebral Booster"
msgstr "腦波增強"

#. ~ Name of a bionic
#. ~ Item name
#. ~ Name of a gun
#: data/json/bionics.json data/json/items/gun/bio.json
msgid "Chain Lightning"
msgid_plural "Chain Lightnings"
msgstr[0] "連鎖電擊"

