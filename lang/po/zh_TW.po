#: data/json/npcs/refugee_center/surface_staff/Smokes/free_merchant_shopkeep_talk_fluff.json
msgid "That's fine for now."
msgstr "就這樣吧。"

#. ~ NPC dialogue line
#: data/json/npcs/campus/great_library_librarian_talk.json
msgid "What questions do you have?"
msgstr ""

