msgstr "“讓我看見你的雙手！”"

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor,
#. mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Let's have a tea party!\""
msgstr ""

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor,
#. mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Let's have fun!\""
msgstr ""

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor,
#. mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Let's play together!\""
msgstr ""

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Let's play… Russian roulette.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_surgeon
#: data/json/speech.json
msgid "\"Like we said, we have no idea what it's thinking.\""
msgstr "\"就像我們說的, 我們不知道它在想什麼。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Look at this fuckin' shit we're in, man.\""
msgstr "\"看看這個操他媽的狗屎地方啊, 老兄。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Look out!\""
msgstr "\"小心! \""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi-go-surgeon
#: data/json/speech.json
msgid "\"Look, it's responding!\""
msgstr "\"快看, 它有反應! \""

#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go,
#. mon_mi_go_abductor
#: data/json/speech.json
msgid "\"MEAT!\""
msgstr "\"肉！\""

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor,
#. mon_mannequin_decoy
#: data/json/speech.json
msgid "\"May I have a cookie?\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Me go, you stay.\""
msgstr "\"我去,你留.\"(鐵巨人經典台詞"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Members of the species have some kind of neurocognitive link.\""
msgstr "\"這些物種的成員都具有某種神經認知連結。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Mom, I miss you.\""
msgstr "\"媽, 我想你。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Mom.\""
msgstr "\"媽。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Mommy, help!\""
msgstr "\"媽咪, 救我! \""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Mommy?\""
msgstr ""

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"My previous owner squealed like a pig when I gutted her!\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Negative.\""
msgstr "\"否。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"No officer on scene.  Requesting backup!\""
msgstr "“現場無員警。請求支援！”"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"No!\""
msgstr "\"不! \""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Nobody is helping us.\""
msgstr "\"沒有人會來救我們。\""

#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Not that way!  Go left!\""
msgstr "\"不是那裡! 走左邊! \""

#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go,
#. mon_mi_go_abductor
#: data/json/speech.json
msgid "\"No… stop the burning!\""
msgstr "“不......別燒了！”"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Of course it is.\""
msgstr "\"它當然是。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Oh God, I'm the only one left.\""
msgstr "\"老天, 只剩下我了。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Oh God, my leg, Oh God!\""
msgstr "\"我的天哪, 我的腳, 喔不! \""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Oh you motherfucking shellfish, you're going down.\""
msgstr ""

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor,
#. mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Oh, how fun!\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi-go_surgeon
#: data/json/speech.json
