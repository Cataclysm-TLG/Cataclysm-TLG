#. ~ Description of species "KRAKEN"
#: data/json/species.json
msgid "a cephalopod"
msgstr ""

#. ~ Description of species "CYBORG"
#: data/json/species.json
msgid "a cyborg"
msgstr ""

#. ~ Description of species "FISH"
#: data/json/species.json
msgid "a fish"
msgstr "魚類"

#. ~ Description of species "INSECT_FLYING"
#: data/json/species.json
msgid "a flying insect"
msgstr "飛行昆蟲"

#. ~ Description of species "ROBOT_FLYING"
#: data/json/species.json
msgid "a flying robot"
msgstr ""

#. ~ Description of species "HUMAN"
#: data/json/species.json
msgid "a human"
msgstr "人類"

#. ~ Description of species "MAMMAL"
#: data/json/species.json
msgid "a mammal"
msgstr "哺乳動物"

#. ~ Description of species "MOLLUSK"
#: data/json/species.json
msgid "a mollusk"
msgstr "軟體動物"

#. ~ Description of species "MUTANT"
#: data/json/species.json
msgid "a mutant"
msgstr "突變體"

#. ~ Description of species "PLANT"
#: data/json/species.json
msgid "a plant"
msgstr "植物"

#. ~ Description of species "REPTILE"
#: data/json/species.json
msgid "a reptile"
msgstr "爬蟲類"

#. ~ Description of species "ROBOT"
#: data/json/species.json
msgid "a robot"
msgstr "機器人"

#. ~ Description of species "SPIDER"
#: data/json/species.json
msgid "a spider"
msgstr "蜘蛛"

