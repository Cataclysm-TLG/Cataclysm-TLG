msgstr "\"甚至也可能是用來嚇退我們的一種方式。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"It does seem to have some form of higher level brain functioning.\""
msgstr "\"它似乎有某種更高等的大腦功能。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"It may be a mechanism for attracting prey.\""
msgstr "\"這可能是吸引獵物的一種機制。\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"It won't hurt a bit.\""
msgstr "\"這樣完全不會痛。\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"It'll be over quick.  I promise.\""
msgstr ""

