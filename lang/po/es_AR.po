msgstr[0] "yelmo corintio"
msgstr[1] "yelmos corintios"
msgstr[2] "yelmos corintios"

#. ~ Description of "head guard"
#: data/json/items/armor/helmets.json
msgid ""
"Lightweight sports headgear designed to protect the head while sparring, a "
