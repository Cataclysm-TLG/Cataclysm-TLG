#. ~ Description of "fire gauntlets"
#: data/json/items/armor/gloves.json
msgid ""
"A heavy pair of gloves, used by firefighters and metalworkers for heat "
"protection."
msgstr ""
"Es un par de guantes pesados usado por los bomberos y herreros para "
"protegerse del calor."

#. ~ Description of "boxing gloves"
#: data/json/items/armor/gloves.json
msgid ""
"A pair of big, red, 8 oz. boxing gloves made from thick vinyl and foam."
msgstr ""

#. ~ Description of "skeleton gloves"
#: data/json/items/armor/gloves.json
msgid ""
"A pair of black costume gloves with a skeletal hand pattern printed on them."
msgstr ""
"Es un par de guantes negros de disfraz con el dibujo de una mano "
"esquelética."

#. ~ Description of "black gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of black cotton gloves."
msgstr "Es un par de guantes negros de algodón."

#. ~ Description of "light gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of cloth gloves."
msgstr ""

#. ~ Description of "wrist warmers"
#: data/json/items/armor/gloves.json
msgid ""
"A pair of cloth mitts that cover the wrists and palms but leave the fingers "
"free."
msgstr ""

#. ~ Description of "cut-resistant gloves"
#: data/json/items/armor/gloves.json
msgid ""
"A pair of cut-resistant gloves, useful for butchery or routine work with "
"bladed objects."
msgstr ""
"Es un par de guantes resistentes a los cortes, útiles para carnear o para "
"trabajos rutinarios con cuchillas."

#. ~ Description of "bag mitts"
#: data/json/items/armor/gloves.json
msgid "A pair of disposable plastic bags, adapted to be used as gloves."
msgstr ""
"Es un par de bolsas descartables de plástico, adaptadas para usarse como "
"guantes."

#. ~ Description of "biosilicified chitin gauntlets"
#: data/json/items/armor/gloves.json
msgid ""
"A pair of fingerless gauntlets crafted from the carefully cleaned and pruned"
" biosilicified exoskeletons of acidic ants.  Acid-resistant but brittle."
msgstr ""

#. ~ Description of "airsoft gloves"
#: data/json/items/armor/gloves.json
msgid ""
"A pair of fingerless gloves with hard plastic reinforcing the backs of the "
"hands to protect against BB pellets and other light projectiles."
msgstr ""

#. ~ Description of "tactical gloves"
#: data/json/items/armor/gloves.json
msgid ""
"A pair of flame- and cut-resistant aramid fabric gloves.  Commonly used by "
"police and military units."
msgstr ""
"Es un par de guantes de aramida resistentes al calor y los cortes. "
"Utilizados comúnmente por policías y soldados."

#. ~ Description of "EOD overhand protectors"
#: data/json/items/armor/gloves.json
msgid ""
"A pair of fragmentation resistant pads for wearing over the backs of one's "
"hands, providing protection from shrapnel in case things go wrong.  Sold as "
"an accessory for explosive ordnance disposal suits, but not often used due "
"to the difficulty in armoring the entire hand and retaining dexterity."
msgstr ""

#. ~ Description of "chitin gauntlets"
#: data/json/items/armor/gloves.json
msgid ""
"A pair of gauntlets made from arthropod exoskeleton.  Though intricately "
"articulated and padded by unsclerotized material, they do not cover the tips"
" of the fingers."
msgstr ""

#. ~ Description of "chainmail gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of gloves made of interlocking rings of low-quality steel wire."
msgstr ""

#. ~ Description of "chainmail gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of gloves made of interlocking rings of steel wire."
msgstr ""

#. ~ Description of "leather gauntlets"
#: data/json/items/armor/gloves.json
msgid "A pair of heavy fingerless leather gloves."
msgstr "Es un par de guantes de cuero grueso sin dedos."

#. ~ Description of "fingerless leather gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of leather gloves without fingers."
msgstr "Es un par de guantes de cuero sin dedos."

#. ~ Description of "armored fingerless leather gloves"
#: data/json/items/armor/gloves.json
msgid ""
"A pair of leather gloves without fingers.  These have been crudely "
"reinforced with sheet metal guards across the back."
msgstr ""

#. ~ Description of "mittens"
#: data/json/items/armor/gloves.json
msgid "A pair of mittens sized for a preschooler."
msgstr ""

#. ~ Description of "snow mittens"
#: data/json/items/armor/gloves.json
