"A pair of mittens with a water-resistant nylon shell, perfect for skiing."
msgstr ""

#. ~ Description of "Nomex wrist warmers"
#: data/json/items/armor/gloves.json
msgid ""
"A pair of mitts that cover the wrists and palms but leave the fingers free."
"  These are made from a fire-resistant aramid weave."
msgstr ""

#. ~ Description of "winter gloves"
#: data/json/items/armor/gloves.json
msgid "A pair of padded cotton gloves.  Toasty!"
msgstr "Es un par de guantes de algodón acolchados. ¡Calentitos!"

#. ~ Description of "army winter gloves"
#: data/json/items/armor/gloves.json
