#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Affirmative.\""
msgstr "\"Afirmativo.\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"And that's supposed to comfort me?\""
msgstr "\"¿Y se supone que eso tiene que tranquilizarme?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"And what if all the backups fail?\""
msgstr "\"¿Y qué pasa si fallan todos los de respaldo?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Anything else?\""
msgstr "\"¿Algo más?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you alone?\""
msgstr "\"¿Estás solo?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you busy at the moment?\""
msgstr "\"¿Estás ocupado en este momento?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you busy later?\""
msgstr "\"¿Vas a estar ocupado más tarde?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you busy tonight?\""
msgstr "\"¿Tenés algo que hacer hoy a la noche?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you feeling all right?\""
msgstr "\"¿Te sentís bien?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you free tonight?\""
msgstr "\"¿Vas a estar hoy a la noche?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you going to help them?\""
msgstr "\"¿Los vas a ayudar?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you going to the party tonight?\""
msgstr "\"¿Vas a ir a la fiesta esta noche?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you hungry?\""
msgstr "\"¿Tenés hambre?\""

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor,
#. mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Are you my mommy?\""
msgstr "\"¿Sos mi mamá?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you seeing anyone?\""
msgstr "\"¿Estás saliendo con alguien?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you sure?\""
msgstr "\"¿Estás seguro?\""

