"\n"
"+10% move speed.\n"
"Lasts 1 second."
msgstr ""

#. ~ Description of buff "Kalaripayattu" in martial art "Simha Vadivu"
#: data/json/martialarts.json
msgid ""
"After striking a critical blow, you have entered the lion stance, foregoing "
"evasion and mobility to press the attack with deadly precision."
msgstr ""

#. ~ Name of martial art
#: data/json/martialarts.json
msgid "Aikido"
msgstr "Aikido"

#. ~ Buff name of martial art "Aikido"
#. ~ Clause text "buff_aikido_static1" of UI widget
