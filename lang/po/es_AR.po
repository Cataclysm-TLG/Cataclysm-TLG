#~ msgid ""
#~ "A primitive skirt made from grass.  Not actually useful for much other than "
#~ "looking like a tribal person."
#~ msgstr ""
#~ "Es una pollera primitiva hecha con pasto. Su única utilidad es la de parecer"
#~ " miembro de alguna tribu."

