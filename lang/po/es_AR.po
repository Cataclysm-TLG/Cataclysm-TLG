#~ msgstr ""
#~ "Tus ojos brillan morados por un momento. Ahora tu vista puede penetrar en "
#~ "las sombras más oscuras."

#~ msgid ""
#~ "Your eyes glow red for a moment.  Now your sight can pierce the darkest "
#~ "shadows."
#~ msgstr ""
#~ "Tus ojos brillan rojos por un momento. Ahora tu vista puede penetrar en las "
#~ "sombras más oscuras."

#~ msgid ""
