#. ~ NPC dialogue line
#: data/json/npcs/old_guard/NPC_Old_Guard_FOB_quartermaster.json
msgid ""
"I'm the camp quartermaster.  Come and see me if you have anything valuable "
"to trade."
msgstr ""
"Soy el intendente del campamento. Hablá conmigo si tenés algo de valor para "
"comerciar."

#. ~ NPC dialogue line
#: data/json/npcs/old_guard/NPC_Old_Guard_FOB_quartermaster.json
msgid "If you're looking to trade you've come to the right place."
msgstr "Si querés comerciar viniste al lugar indicado."

#. ~ NPC dialogue line
#: data/json/npcs/old_guard/NPC_Old_Guard_FOB_quartermaster.json
msgid "Welcome to camp Arabella, What will it be?"
msgstr "Bienvenido al campamento Arabella. ¿Qué se le ofrece?"

#. ~ Response to NPC dialogue
#: data/json/npcs/old_guard/NPC_Old_Guard_FOB_quartermaster.json
msgid "Well, I'd better be going.  Bye."
msgstr "Bueno, mejor me voy yendo. Chau."

