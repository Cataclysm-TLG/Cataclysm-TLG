msgid "Intravenous Needletip"
msgstr "Aguja Intravenosa"

#. ~ Name of a bionic
#: data/json/bionics.json
msgid "Itchy Metal Thing"
msgstr "Cosa de Metal que Pica"

#. ~ Name of a bionic
#: data/json/bionics.json
msgid "Joint Servo"
msgstr "Articulaciones Servo"

#. ~ Name of a bionic
