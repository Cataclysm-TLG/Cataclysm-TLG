msgstr "Te voy a matar si no lo hacés."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm driving here!"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm on watch."
msgstr "Estoy de guardia."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm sorry.  Look, I already dropped it, okay?"
msgstr "Perdón. Mirá, ya lo dejé, listo."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid ""
"I'm willing to pay <topic_item_price> per batch for a total of "
"<topic_item_your_total_price>."
msgstr ""
"Estoy dispuesto a pagar <topic_item_price> por tanda para un total de "
"<topic_item_your_total_price>."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Just this once, you can keep it.  Don't tell anyone else."
msgstr "Solo por esta vez, te lo podés quedar. No le digas a nadie."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Let's see…"
msgstr "Vamos a ver…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "Let's talk."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Look, I really need this.  Please let me have it."
msgstr "Mirá, necesito esto, de verdad. Por favor, dejámelo."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/other/meteorologist.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_old_guard_representative.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_crop_overseer.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_woodcutter1.json
msgid "Maybe later."
msgstr "Tal vez más tarde."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Maybe we should start boarding up this place."
msgstr "Tal vez deberíamos empezar por poner tablas en las aberturas."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Never mind, I'll do without.  Bye."
msgstr "No importa, lo voy a hacer sin eso. Chau."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "No, I'm keeping it.  Try and take it off me, I dare you."
msgstr "No, me lo voy a quedar. Vení y sacámelo si te animás."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "No, we'll be okay here."
msgstr "No, vamos a estar bien acá."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
