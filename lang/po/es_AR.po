#. ~ Description of loot zone "Storage: Unsorted"
#: data/json/loot_zones.json
msgid ""
"A space for items which are to be sorted into other storage zones.  You can "
"use the \"sort out items\" zone action to automatically move items from here"
" to any valid destinations, including ones contained within this zone."
msgstr ""

#. ~ Description of loot zone "Storage: Unload Everything"
#: data/json/loot_zones.json
msgid ""
"Any containers in this zone you don't otherwise sort will have their "
"contents dumped out and placed on the same tile.  This includes corpses, "
"magazines, and magazine wells."
msgstr ""
"Todos los contenedores en esta zona que no tengas organizados de otra manera"
" serán vaciados y su contenido será puesto en el mismo espacio. Esto incluye"
" cadáveres, cargadores y aberturas de cargador."

#. ~ Description of loot zone "Storage: Strip Corpses"
#: data/json/loot_zones.json
msgid ""
"Corpses in this zone you don't otherwise sort will have everything taken off"
" them and dropped on the same tile."
msgstr ""
"Los cadáveres en esta zona serán despojados de todo lo que tengan, dejando "
"las cosas en el mismo espacio."

#. ~ Description of loot zone "Storage: Bionics"
#: data/json/loot_zones.json
msgid "Destination for Compact Bionic Modules, a.k.a. CBMs."
msgstr ""

#. ~ Description of loot zone "Storage: Ammo"
#: data/json/loot_zones.json
msgid "Destination for ammo."
msgstr "Lugar para la munición."

#. ~ Description of loot zone "Storage: Default"
#: data/json/loot_zones.json
msgid "Destination for any loot without a more specific zone defined."
msgstr ""

#. ~ Description of loot zone "Storage: Armor"
#: data/json/loot_zones.json
msgid ""
"Destination for armor.  Does include filthy armor if such zone is not "
"specified."
msgstr ""
"Lugar para ropas y armaduras. Incluye prendas sucias si no hay una zona "
"específica para ella."

#. ~ Description of loot zone "Storage: Artifacts"
#: data/json/loot_zones.json
msgid "Destination for artifacts."
msgstr "Lugar para artefactos."

#. ~ Description of loot zone "Storage: Books"
#: data/json/loot_zones.json
msgid "Destination for books and magazines."
msgstr "Lugar para libros y revistas."

#. ~ Description of loot zone "Storage: Chemical"
#: data/json/loot_zones.json
msgid "Destination for chemicals."
msgstr "Lugar para químicos."

#. ~ Description of loot zone "Storage: Clothing"
#: data/json/loot_zones.json
msgid ""
"Destination for clothing.  Does include filthy clothing if such zone is not "
"specified."
msgstr ""
"Lugar para ropa. Incluye la ropa sucia si no hay una zona específica para "
"ella."

#. ~ Description of loot zone "Storage: Food"
#: data/json/loot_zones.json
msgid ""
"Destination for comestibles.  If a more specific food zone is not defined, "
"all food is moved here."
msgstr ""

#. ~ Description of loot zone "Storage: Corpses"
#: data/json/loot_zones.json
msgid "Destination for corpses."
msgstr "Lugar para cadáveres."

#. ~ Description of loot zone "Storage: Currency"
#: data/json/loot_zones.json
msgid "Destination for currency."
msgstr "Lugar para el efectivo."

#. ~ Description of loot zone "Storage: Drink"
#: data/json/loot_zones.json
msgid ""
"Destination for drinks.  Does include perishable drinks if such zone is not "
"specified."
msgstr ""
"Lugar para las bebidas. Incluye bebidas perecederas si no hay una zona "
"específica para ellas."

#. ~ Description of loot zone "Storage: Drugs"
#: data/json/loot_zones.json
msgid "Destination for drugs and other medical items."
msgstr "Lugar para drogas y otros objetos médicos."

#. ~ Description of loot zone "Storage: Containers"
#: data/json/loot_zones.json
msgid "Destination for empty containers."
msgstr "Lugar para recipientes vacíos."

#. ~ Description of loot zone "Storage: Filthy Armor"
#: data/json/loot_zones.json
msgid "Destination for filthy armor."
msgstr "Lugar para ropa y armaduras sucias."

#. ~ Description of loot zone "Storage: Filthy Clothing"
#: data/json/loot_zones.json
msgid "Destination for filthy clothing."
msgstr "Lugar para la ropa sucia."

#. ~ Description of loot zone "Storage: Mods"
#: data/json/loot_zones.json
msgid "Destination for firearm modifications and similar items."
msgstr "Lugar para modificaciones de armas de fuego y similares."

#. ~ Description of loot zone "Storage: Wood"
#: data/json/loot_zones.json
msgid ""
"Destination for firewood and lumber.  Items stored here will not "
"automatically be used to fuel fires unless this area is also designated as a"
" firewood zone."
msgstr ""

#. ~ Description of loot zone "Storage: Fuel"
#: data/json/loot_zones.json
msgid ""
"Destination for gasoline, diesel, kerosene and other substances used as a "
"fuel."
msgstr ""
"Lugar para nafta, gasoil, querosén y otras sustancias utilizadas como "
"combustible."

#. ~ Description of loot zone "Storage: Magazines"
#: data/json/loot_zones.json
msgid "Destination for gun magazines."
msgstr "Lugar para cargadores de armas."

#. ~ Description of loot zone "Storage: Guns"
#: data/json/loot_zones.json
msgid "Destination for guns, bows and similar weapons."
msgstr "Lugar para armas de fuego, arcos y similares."

#. ~ Description of loot zone "Storage: Manuals"
#: data/json/loot_zones.json
msgid "Destination for instructional books and magazines."
msgstr "Lugar para los libros y revistas instructivos."

#. ~ Description of loot zone "Storage: Item Group"
#: data/json/loot_zones.json
msgid "Destination for items from an item group."
msgstr "Lugar para objetos del grupo de objetos."

#. ~ Description of loot zone "Storage: Keys"
#: data/json/loot_zones.json
msgid "Destination for keys."
msgstr "Lugar para las llaves."

#. ~ Description of loot zone "Storage: Custom"
#: data/json/loot_zones.json
msgid "Destination for loot with a custom filter that you can modify."
msgstr ""
"Lugar para cosas dependiendo cómo hayas modificado el filtro de cosas."

#. ~ Description of loot zone "Storage: Martial arts manuals"
