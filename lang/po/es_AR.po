#~ msgid ""
#~ "Your flesh heals visibly while blood disintegrates hidden inside your veins."
#~ msgstr ""
#~ "Tu carne se cura visiblemente mientras la sangre se desintegra dentro de tus"
#~ " venas."

#~ msgid "Your funeral."
#~ msgstr "Tu funeral."

