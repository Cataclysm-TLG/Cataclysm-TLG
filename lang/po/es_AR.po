msgid "Open default advanced inventory layout"
msgstr "Abrir disposición por defecto de inventario avanzado"

#: src/options.cpp:1908
msgid ""
"If true, open default advanced inventory layout instead of last opened "
"layout"
msgstr ""
"Si está activado, usa la disposición por defecto del inventario avanzado en "
"lugar de la última disposición usada."

