#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid " *pshhhttt* I'm reading you boss, over."
msgstr " *pshhhttt* Te estoy interpretando, jefe, cambio."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid ""
" *tshk* Are you serious?  This isn't a cell phone.  Can it wait until we're "
"in the same place?"
msgstr ""
" *tshk* ¿En serio? Esto no es un celular. ¿Podés esperar a que estemos en el"
" mismo lugar?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid " *tshk* Not sure it works when I am that far."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "*pssshht* ten-four, I'll make my way there, over."
msgstr "*pssshht* diez-cuatro, voy a ir hasta ahí, cambio."

