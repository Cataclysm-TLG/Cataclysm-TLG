#~ " time."
#~ msgstr ""
#~ "Es un SCBA, un dispositivo autónomo de respiración. Un conjunto de tanques "
#~ "contienen una bacteria creada para procesar el Co2 y convertirlo en aire "
#~ "respirable."

#~ msgid ""
