#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, fine."
msgstr "Bueno, está bien."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, here you go."
msgstr "Bueno, acá tenés."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, let's begin."
msgstr "Ok, empecemos."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, let's go!"
msgstr "¡Bueno, vamos!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, okay, sorry."
msgstr "Bueno, bueno, perdón."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, okay, this is all a misunderstanding.  Sorry, I'll drop it now."
msgstr "Okey, okey, es un malentendido. Perdón, ya lo dejo."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
