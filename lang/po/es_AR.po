msgid_plural "issues of Computer Gaming"
msgstr[0] "Juegos de Computadora"
msgstr[1] "fascículos de Juegos de Computadora"
msgstr[2] "fascículos de Juegos de Computadora"

#. ~ Item name
#: data/json/items/book/misc.json
