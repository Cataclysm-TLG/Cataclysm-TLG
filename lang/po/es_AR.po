msgid "Spray where?"
msgstr "¿Dónde querés grafitear?"

#: src/iuse.cpp:1854
#, c-format
msgid ""
"Since they're not on fire, this will probably make %s angry.  Continue?"
msgstr ""

#: src/iuse.cpp:1872 src/iuse.cpp:4664
#, c-format
msgid "%s is blinded by the spray."
msgstr ""

#: src/iuse.cpp:1959
#, c-format
msgid "You unpack your %s for use."
msgstr "Desempaquetás tu %s para usarlo/a."

#: src/iuse.cpp:1970
msgid "Choose CBM to pack"
msgstr "Elegí un MCB para guardar"

#: src/iuse.cpp:1970
msgid "You don't have any CBMs."
msgstr "No tenés ningún MCB."

#: src/iuse.cpp:1976
msgid "This CBM is faulty.  You should mend it first.  Do you want to try?"
msgstr ""
"Este MCB está defectuoso. Deberías arreglarlo primero. ¿Querés intentarlo?"

#: src/iuse.cpp:1982
msgid "You carefully prepare the CBM for sterilization."
msgstr "Cuidadosamente, preparás el MCB para la esterilización."

#: src/iuse.cpp:2004
#, c-format
msgid "You can't pack your %s until you take it off."
msgstr "No podés empaquetar tu %s hasta que te lo saques."

#: src/iuse.cpp:2016
#, c-format
msgid "You pack your %s for storage."
msgstr "Empaquetás tu %s para guardarlo."

#: src/iuse.cpp:2031 src/iuse.cpp:2126
msgid "Purify what?"
msgstr "¿Qué querés potabilizar?"

#: src/iuse.cpp:2031 src/iuse.cpp:2126
msgid "You don't have water to purify."
msgstr "No tenés agua para potabilizar."

#: src/iuse.cpp:2046
msgid "That volume of water is too large to purify."
msgstr "El volumen de agua es demasiado grande como para potabilizarla."

#: src/iuse.cpp:2084
#, c-format
