#: src/options.cpp:2180
msgid ""
"Show: cursor is always shown.  Hide: cursor is hidden.  HideKB: cursor is "
"hidden on keyboard input and unhidden on mouse movement."
msgstr ""
"표시: 커서가 항상 보입니다. 숨김: 커서를 숨깁니다. 미사용시 숨김: 키보드 입력시에는 숨기고 마우스를 움직일 때에는 보여줍니다."

#. ~ show mouse cursor
#: src/options.cpp:2182
msgid "Show"
msgstr "표시"

#. ~ hide mouse cursor
#: src/options.cpp:2184
msgid "Hide"
msgstr "숨김"

#. ~ hide mouse cursor when keyboard is used
#: src/options.cpp:2186
msgid "HideKB"
msgstr "미사용시 숨김"

#: src/options.cpp:2191
msgid "Edge scrolling"
msgstr "엣지 스크롤"

#: src/options.cpp:2192
msgid "Edge scrolling with the mouse."
msgstr "마우스로 가장자리에서 스크롤 할 수 있습니다."

