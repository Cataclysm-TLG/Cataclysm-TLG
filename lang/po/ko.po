msgstr ""

#. ~ Feed message of monster "large claw sloth"
#: data/mods/Megafauna/monsters/mf_wild.json
#, c-format
msgid ""
"The %s seems to like you!  It lets you pat its head, giving off a bassy hum."
msgstr ""

#. ~ Feed message of monster "stag moose cub"
#: data/mods/Megafauna/monsters/mf_wild.json
#, c-format
