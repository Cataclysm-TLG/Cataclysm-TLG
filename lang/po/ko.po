msgid "Do you have them?"
msgstr "가져왔어?"

#. ~ NPC dialogue line
#: data/json/npcs/tacoma_ranch/NPC_ranch_foreman.json
msgid ""
"Ever since you got the bartender set up, our liquor business has been "
"running so much better!  As thanks for your efforts, I wanted to reward you "
"with a portion of recent profits."
msgstr ""

#. ~ Mission name
#: data/json/npcs/tacoma_ranch/NPC_ranch_foreman.json
msgid "Find 12 Car Batteries"
msgstr "자동차 배터리 12개 찾기"

#. ~ Mission name
#: data/json/npcs/tacoma_ranch/NPC_ranch_foreman.json
msgid "Find 2 Arc Welders"
msgstr "아크 용접기 2개 찾기"

#. ~ Mission name
#: data/json/npcs/tacoma_ranch/NPC_ranch_foreman.json
