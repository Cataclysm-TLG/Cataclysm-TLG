msgstr "%1$s(은)는 %2$s(으)로 변했습니다!"

#: src/monattack.cpp:3231
#, c-format
msgid "The %s vanishes!"
msgstr "%s(이)가 사라집니다!"

#: src/monattack.cpp:3233
#, c-format
msgid "A %s appears!"
msgstr "%s(이)가 나타납니다!"

#: src/monattack.cpp:3263
