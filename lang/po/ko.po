#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Uncategorized object seven-seven-three-four.\""
msgstr "\"미분류 물체 7-7-3-4.\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Until such time as more permanent arrangements are made.\""
msgstr "\"좀더 영구적인 합의가 있기 전까지는.\""

#. ~ Speech from speaker mon_shoggoth, mon_mi_go, mon_mi_go_abductor,
#. mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"U…uugh…\""
msgstr ""

#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
