msgstr "애니메이션 관련 옵션."

#: src/options.cpp:2213
msgid "Animations"
msgstr "애니메이션"

#: src/options.cpp:2214
msgid "If true, will display enabled animations."
msgstr "이 설정을 켜면 사용 가능한 애니메이션을 사용합니다."

#: src/options.cpp:2218
msgid "Weather effects"
msgstr ""

#: src/options.cpp:2219
msgid "If true, will display visual weather effects."
msgstr ""

