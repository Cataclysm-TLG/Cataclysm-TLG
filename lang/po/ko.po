msgstr "잠에서 깨어났습니다."

#. ~ Description of effect type "Skunk Spray"
#: data/json/effects.json
msgid "You were sprayed by a skunk!"
msgstr ""

#. ~ Description of effect type "Acid Drenched"
#: data/json/effects.json
msgid "You're bathed in acid!"
msgstr ""

#. ~ Apply message of effect type "Electrocuted"
#: data/json/effects.json
msgid "You're being electrocuted!"
msgstr ""

#. ~ Description of effect type "Electrocuted"
#: data/json/effects.json
