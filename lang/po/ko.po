msgstr "\"실험체를 제거해야 할 것이다.\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"We're all alone.\""
msgstr "\"우린 혼자야.\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"We're both scavs, in't we?\""
msgstr "\"거 같은 쥐새끼끼리 너무 그러지 말자고. 응?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"We're not even sure what it is.\""
msgstr "\"도대체 이게 뭔지 모르겠네.\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"We're on our own.\""
msgstr "\"우리 스스로 해야해.\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"We're still trying to figure out what makes it tick.\""
msgstr "\"아직 우리는 이것이 어떻게 작동하는지 알아내려고 노력 중입니다.\""

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"What IS that?\""
msgstr "\"저게 대체 뭐야?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"What are you afraid will happen?\""
