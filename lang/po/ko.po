#: data/json/bionics.json
msgid "Electrical Discharge"
msgstr "고장: 전기 방전"

#. ~ Name of a bionic
#: data/json/bionics.json
msgid "Electrical Drain"
msgstr "고장: 전기 흡수"

#. ~ Name of a bionic
#: data/json/bionics.json
msgid "Electromagnetic Leak"
msgstr "고장 : 전자기 누출"

#. ~ Name of a bionic
#: data/json/bionics.json
msgid "Electromagnetic Unit"
msgstr "전자석 장치"

#. ~ Name of a bionic
