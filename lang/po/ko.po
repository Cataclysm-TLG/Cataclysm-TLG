#: data/json/overmap/overmap_land_use_codes.json
msgid ""
"Open areas in the process of being developed from one land use to another "
"(if the future land use is at all uncertain).  Formerly identified as Urban "
"Open."
msgstr ""

#. ~ Name of an overmap land use code
#: data/json/overmap/overmap_land_use_codes.json
