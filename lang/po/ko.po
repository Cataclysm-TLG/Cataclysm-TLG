msgstr "발 아래 바닥이 흔들립니다."

#: src/monattack.cpp:3874 src/monattack.cpp:3904
msgid "a deafening roar!"
msgstr "귀가 먹먹한 포효!"

#: src/monattack.cpp:3894
#, c-format
