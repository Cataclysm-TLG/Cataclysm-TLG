msgstr "거래하자."

#. ~ NPC dialogue line
#: data/json/npcs/hub01/ROBOFAC_SURFACE_FREEMERCHANT.json
msgid "Safe travels, scavenger."
msgstr "조심히 다니라고, 수색꾼 나으리."

#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/ROBOFAC_SURFACE_FREEMERCHANT.json
msgid "Thanks for the info, bye."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/hub01/ROBOFAC_SURFACE_FREEMERCHANT.json
msgid ""
"We have been supplying this lab here with food from a few hunting and "
"farming communities nearby.  The roads are tough and dangerous, but it makes"
" good money, and beats scavenging the cities for scraps."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/hub01/ROBOFAC_SURFACE_FREEMERCHANT.json
msgid "Welcome…"
msgstr "반가워..."

#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/ROBOFAC_SURFACE_FREEMERCHANT.json
msgid "When is the next shipment?"
msgstr ""

