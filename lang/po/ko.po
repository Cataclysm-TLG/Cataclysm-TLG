msgstr ""

#: src/monattack.cpp:3222
#, c-format
msgid "You feel a sudden, intense burst of energy from the %s."
msgstr ""

#. ~ %1$s is the pre-upgrade monster, %2$s is the post-upgrade monster.
#: src/monattack.cpp:3228
#, c-format
