#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor,
#. mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"FUCK YOU!\""
msgstr "\"씨발 엿이나 먹어라!\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Fantastic.\""
msgstr "\"환상적이군.\""

#. ~ Speech from speaker mon_feral_sapien_spear
#: data/json/speech.json
msgid "\"Food!\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Forget it.\""
msgstr "\"됐어.\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
