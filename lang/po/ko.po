msgid "If true, show item symbols in inventory and pick up menu."
msgstr "이 설정을 켜면 물품 이름 좌측에 물품 기호를 표시합니다."

#: src/options.cpp:2154
msgid "Show armor coverage map"
msgstr "방어구 적용 범위 그리기"

#: src/options.cpp:2155
msgid ""
"If true, show a visual representation of armor coverage in the item info "
