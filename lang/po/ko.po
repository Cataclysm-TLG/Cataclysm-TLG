msgstr "\"걱정 마. 저게 설마 격리실에서 공간이동이라도 하겠어?\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Don't worry.\""
msgstr "\"걱정마.\""

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Down here, they ALL float!\""
msgstr "\"여기 아래에, 그들 모두가 떠있어!\""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
