#. ~ Description of "cluster of giant frog eggs"
#: data/json/items/comestibles/egg.json
msgid ""
"A clump of very large frog eggs, reeking of ammonia.  They look almost like "
"peeled grapes, except that each is the size of an orange."
msgstr ""

#. ~ Description of "roach egg"
#: data/json/items/comestibles/egg.json
msgid "A fist-sized egg from a giant roach.  Incredibly gross."
msgstr ""

#. ~ Description of "locust egg"
#: data/json/items/comestibles/egg.json
msgid "A fist-sized egg from a locust."
msgstr ""

#. ~ Description of "plague vector egg"
#: data/json/items/comestibles/egg.json
msgid "A fist-sized egg from a plague vector.  Incredibly gross."
msgstr ""

#. ~ Description of "vegetable omelet"
#: data/json/items/comestibles/egg.json
msgid "A fluffy beaten egg pancaked over with cheese and vegetables inside."
