#. ~ NPC dialogue line
#: data/json/npcs/tacoma_ranch/NPC_ranch_doctor.json
msgid "I can't right now, I have other matters to attend to."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/tacoma_ranch/NPC_ranch_doctor.json
msgid ""
"I could only find one real crutch, but if you match it with this wooden one, "
"that's just as good, right?."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/tacoma_ranch/NPC_ranch_doctor.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_nurse.json
msgid "I could use your medical assistance."
