#. ~ NPC dialogue line
#: data/json/npcs/hub01/robofac_ancilla_npcs/NPC_ANCILLA_HQ_GUARD.json
msgid ""
"Me?  Just standing around, looking scary.  Think I'm doing a good job?\n"
"\n"
"Don't answer that."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/hub01/robofac_ancilla_npcs/NPC_ANCILLA_HQ_GUARD.json
msgid ""
"Well you certainly look like you could.  Try ringing the box in the bunker "
"across the street, or see if someone in the Terminal has a need for help."
msgstr ""

