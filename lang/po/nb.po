msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/tacoma_ranch/NPC_ranch_generic.json
msgid "I don't know what I could offer."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/tacoma_ranch/NPC_ranch_generic.json
msgid "Maybe the scrapper would have some spare parts?"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/tacoma_ranch/NPC_ranch_generic.json
msgid "Unfortunately, I don't have anything that can help."
msgstr ""

#. ~ Dialogue line in mission "Collect 100 Aspirin"
#: data/json/npcs/tacoma_ranch/NPC_ranch_nurse.json
msgid "Aspirin is pretty common in homes and convenience stores."
msgstr ""

