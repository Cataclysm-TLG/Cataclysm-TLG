msgstr ""

#. ~ Description of "pelmeni"
#: data/json/items/comestibles/meat_dishes.json
msgid ""
"Delicious cooked dumplings consisting of a meat filling wrapped in thin "
"dough."
msgstr ""

#. ~ Description of "meat fried rice"
#: data/json/items/comestibles/meat_dishes.json
msgid "Delicious fried rice with meat.  Tasty and very filling."
msgstr ""

#. ~ Description of "meat temaki"
#: data/json/items/comestibles/meat_dishes.json
msgid ""
"Delicious slivers of raw meat, wrapped in tasty sushi rice and rolled up in "
"a healthy green vegetable."
msgstr ""

#. ~ Description of "sashimi"
#: data/json/items/comestibles/meat_dishes.json
msgid ""
"Delicious slivers of thinly sliced raw fish, served with tasty vegetables."
msgstr ""

#. ~ Description of "fish makizushi"
#: data/json/items/comestibles/meat_dishes.json
msgid ""
"Delicious slivers of thinly-sliced raw fish, wrapped in tasty sushi rice and "
"rolled up in a healthy green vegetable."
msgstr ""

#. ~ Description of "clam chowder"
#: data/json/items/comestibles/meat_dishes.json
msgid ""
"Delicious, lumpy, white soup made of meat (traditionally clams) and potatoes "
