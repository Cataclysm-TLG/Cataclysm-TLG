msgid "Android Keyboard Options"
msgstr ""

#: src/options.cpp:2807
msgid "Options regarding Android keyboard."
msgstr ""

#: src/options.cpp:2809
msgid "Trap Back button"
msgstr ""

#: src/options.cpp:2810
msgid ""
"If true, the back button will NOT back out of the app and will be passed to "
"the application as SDL_SCANCODE_AC_BACK.  Requires restart."
msgstr ""

#: src/options.cpp:2815
msgid "Use native Android UI menus"
msgstr ""

#: src/options.cpp:2816
msgid ""
"If true, native Android dialogs are used for some in-game menus, such as "
"popup messages and yes/no dialogs."
msgstr ""

#: src/options.cpp:2821
msgid "Auto-manage virtual keyboard"
msgstr ""

#: src/options.cpp:2822
msgid ""
"If true, automatically show/hide the virtual keyboard when necessary based "
"on context.  If false, virtual keyboard must be toggled manually."
msgstr ""

#: src/options.cpp:2827
msgid "Virtual keyboard screen scale"
msgstr ""

#: src/options.cpp:2828
msgid ""
"If true, when the virtual keyboard is visible, scale the screen to prevent "
"overlapping.  Useful for text entry so you can see what you're typing."
msgstr ""

#: src/options.cpp:2835
msgid "Vibration duration"
msgstr ""

#: src/options.cpp:2836
msgid ""
"If non-zero, vibrate the device for this long on input, in milliseconds.  "
"Ignored if hardware keyboard connected."
msgstr ""

