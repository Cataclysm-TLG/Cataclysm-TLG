#. ~ Description of "cloth patch"
#: data/json/items/tool/toiletries.json
msgid ""
"A 6-inch square patch of fabric, suitable for repairing and tailoring "
"clothing."
msgstr ""

#. ~ Description of "sponge"
#: data/json/items/tool/toiletries.json
msgid ""
"A cleaning aid made of soft, porous material.  It will make cleaning hard "
"objects much easier."
msgstr ""

#. ~ Description of "shaving kit"
#: data/json/items/tool/toiletries.json
msgid ""
"A compact, lightweight shaving kit made for travelers.  You can use it to "
"shave if it's supplied with soap.  It requires 1 unit of soap per use."
msgstr ""

#. ~ Description of "dish towel"
#: data/json/items/tool/toiletries.json
msgid "A dish towel, useful for cleaning hard surfaces."
msgstr ""

#. ~ Description of "razor blade"
#: data/json/items/tool/toiletries.json
msgid "A double-edged razor blade."
msgstr ""

#. ~ Description of "makeshift haircut kit"
#: data/json/items/tool/toiletries.json
msgid "A kit containing various improvised tools for cutting hair."
msgstr ""

#. ~ Description of "hair dye kit"
#: data/json/items/tool/toiletries.json
msgid ""
"A kit featuring all the tools needed to dye hair, including an applicator "
"brush, combs, and plastic gloves."
msgstr ""

#. ~ Description of "collapsible mop"
#: data/json/items/tool/toiletries.json
msgid ""
"A long, unwieldy mop with a collapsible handle for convenient "
"transportation.  You may use it to clean up any 'mess' you have made."
msgstr ""

#. ~ Description of "makeshift shaving kit"
#: data/json/items/tool/toiletries.json
msgid ""
"A makeshift shaving kit.  You can use it to shave if it's supplied with "
"soap.  It requires 1 unit of soap per use."
msgstr ""

#. ~ Description of "scrub brush"
#: data/json/items/tool/toiletries.json
msgid "A plastic scrub brush.  It will make cleaning hard objects much easier."
msgstr ""

#. ~ Description of "electric hair trimmer"
#: data/json/items/tool/toiletries.json
msgid ""
"A pocket-sized electric trimmer made for cutting hair.  You can use it to "
"cut your hair if it's supplied with batteries.  It requires 1 unit of charge "
"per use."
msgstr ""

#. ~ Description of "bathroom scale"
#: data/json/items/tool/toiletries.json
msgid "A small bathroom scale, meant to weigh a person while naked."
msgstr ""

#. ~ Description of "washboard"
#: data/json/items/tool/toiletries.json
msgid ""
"A wooden washboard.  It will make washing clothing and other soft items much "
"easier."
msgstr ""

#. ~ Description of "mop"
#: data/json/items/tool/toiletries.json
msgid ""
"An unwieldy mop.  Good for cleaning up spills.  Use to mop up any 'mess' you "
