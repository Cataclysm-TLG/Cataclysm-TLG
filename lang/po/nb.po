#. ~ NPC dialogue line
#: data/json/npcs/refugee_center/surface_refugees/shared_dialogue.json
msgid "Sorry, but you couldn't pay me enough to go back there."
msgstr ""

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/Cataclysm-TLG/Cataclysm-TLG/blob/master/doc/TRANSLATING.md#grammatical-gender
