#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid ""
"\"A fisherman hauled it in.  Lucky for us, he called the coast guard.  Yeah, "
"I'd hate to be him right about now.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Affirmative.\""
msgstr "„Potwierdzam”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"And that's supposed to comfort me?\""
msgstr "„I to mnie niby miało pocieszyć?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Anything else?\""
msgstr "„Coś jeszcze?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you alone?\""
msgstr "„Jesteś sam?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you busy at the moment?\""
msgstr "„Jesteś teraz zajęty?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you busy later?\""
msgstr "„Będziesz później zajęty?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you busy tonight?\""
msgstr "„Co robisz wieczorem?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you feeling all right?\""
msgstr "„Jak się czujesz?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you free tonight?\""
msgstr "„Masz wolny wieczór?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you going to help them?\""
msgstr "„Zamierzasz im pomóc?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you going to the party tonight?\""
msgstr "„Idziesz dziś na imprezę?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you hungry?\""
msgstr "„Jesteś głodny?”."

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor, mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Are you my mommy?\""
msgstr "„Jesteś moją mamusią?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you seeing anyone?\""
msgstr "„Widzisz kogoś?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you sure?\""
msgstr "„Na pewno?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Area nineteen has a few in cold storage.\""
msgstr "„Strefa 19 ma kilka w zamrażarce”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"At least we know they can die.\""
msgstr "„Przynajmniej wiemy, że mogą umrzeć”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Be careful out there.\""
msgstr "„Bądźcie ostrożni”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Be quiet.\""
msgstr "„Bądź cicho”."

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Big Brother is watching you…\""
msgstr "„Wielki Brat patrzy…”."

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Blood… delicious.\""
msgstr "„Krew… pyszna”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Boss wants you.\""
msgstr ""

#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Burning… from the inside…\""
msgstr "„Palę się… od środka…”"

#. ~ Speech from speaker mon_shoggoth, mon_mi_go, mon_mi_go_abductor, mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"C-can't…\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Call an ambulance!\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Call an ambulance.\""
msgstr "„Wezwij karetkę”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Call an ambulance…But not for me!\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Call me.\""
msgstr "„Zadzwoń”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Call the police.\""
msgstr "„Wezwij policję”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can I help you?\""
msgstr "„Mogę w czymś pomóc?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can I see your phone?\""
msgstr "„Mogę zobaczyć twój telefon?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can you help me?\""
msgstr "„Czy możesz mi pomóc?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can you repeat that?\""
msgstr "„Możesz powtórzyć?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can you swim?\""
msgstr "„Potrafisz pływać”."

#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can't… breathe…\""
msgstr "„Nie… mogę… oddychać…”"

#. ~ Speech from speaker mon_civilian_zombiefighter
#: data/json/speech.json
msgid "\"Come get some!\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Come here!\""
msgstr "„Chodź tu!”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Come on, come on, they can help us!\""
