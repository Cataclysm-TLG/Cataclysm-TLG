#~ msgid ""
#~ "This brand of toilet paper is designed to dissolve completely in water!"
#~ msgstr "Ten gatunek papieru toaletowego rozpuszcza się całkowicie w wodzie!"

#~ msgid "This brings a smile to your face."
#~ msgstr "To wywołuje uśmiech na twojej twarzy."

#~ msgid ""
#~ "This broken-down heat mill once provided respite from the cold.  Designed "
#~ "to operate without human maintenance indefinitely, but has broken down - "
#~ "or been intentionally damaged."
#~ msgstr ""
#~ "Ten zepsuty młyn cieplny dawał kiedyś wytchnienie od zimna. "
#~ "Zaprojektowany, by działać bez ludzkiej obsługi w nieskończoność, ale "
#~ "uległ awarii - lub został celowo uszkodzony."

#~ msgid ""
#~ "This bulky, four-legged dinosaur corpse with a beak has grown dense bone "
#~ "armor."
#~ msgstr ""
#~ "Ten masywny, czworonożny trup dinozaura z dziobem ma gęsty pancerz kostny."

#~ msgid "This burn really hurts!"
#~ msgstr "To oparzenie naprawdę boli!"

#~ msgid ""
