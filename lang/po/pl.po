#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I got this weird rash a few days ago.\""
msgstr "„Dostałem takiej dziwnej wysypki parę dni temu”."

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I hate you.\""
msgstr "„Nienawidzę cię”."

#. ~ Speech from speaker mon_prototype_cyborg, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I have done what you asked.  Please let me go!\""
msgstr "„Zrobiłem, o co prosiłeś. Pozwól mi odejść!”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"I love you and I'll never forget you.\""
msgstr "„Kocham cię i nigdy cię nie zapomnę”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I love you too.\""
msgstr "„Też cię kocham”."

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor, mon_mannequin_decoy
#: data/json/speech.json
msgid "\"I love you!\""
msgstr "„Kocham cię!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I love you.\""
msgstr "„Kocham cię”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I need a new coat.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I think I need to see a doctor.\""
msgstr "„Myślę, że potrzebuję lekarza”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I think I'll live.\""
msgstr "„Będę żył”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi-go_surgeon
#: data/json/speech.json
msgid "\"I think there's something in the air that's keeping us alive.\""
msgstr "„Chyba jest coś w powietrzu, co trzyma nas przy życiu”."

#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I told you to let me die.\""
msgstr "„Mówiłem ci, żebyś pozwolił mi umrzeć”."

#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I was once a man.  A MAN!\""
msgstr "„Byłem kiedyś człowiekiem. CZŁOWIEKIEM!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I wonder if it understands us.\""
msgstr "„Ciekawe, czy nas rozumie?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I'll never forget you.\""
msgstr "„Nigdy cię nie zapomnę”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I'm fine.\""
msgstr "„Nic mi nie jest”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I'm heading to the pool after work.\""
msgstr "„Idę na basen po pracy”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I'm hungry.\""
msgstr "„Jestem głodny”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I'm not afraid of you!\""
msgstr "„Nie boję się ciebie!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I'm not convinced it can actually comprehend us.\""
msgstr "„Jestem przekonany, że jest w stanie nas pojąć”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I'm okay, don't worry about me.\""
msgstr "„Wszystko ok, nie martw się o mnie”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I've been looking all over for you.\""
msgstr "„Wszędzie was szukałem”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I've got a headache.\""
msgstr "„Boli mnie głowa”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I've got family coming tomorrow.\""
msgstr "„Rodzina przyjeżdża do mnie jutro”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid ""
"\"If I was in there I'd sure as hell be trying to talk my way out, but it's "
"just standing there.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Individual specimens of U-O Seven-Seven-Three-Four.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Is everything all right?\""
msgstr "„Wszystko w porządku?”."

#. ~ Speech from speaker mon_prototype_cyborg, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Is it done?  Am I perfect now?\""
msgstr "„Już skończone? Czy jestem już perfekcyjny?”"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Is it supposed to rain tomorrow?\""
msgstr "„Jutro ma padać?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It can't follow all of us.\""
msgstr "„Nie może pójść jednocześnie za wszystkimi”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It could be some kind of a drone.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It could even be a way of trying to scare us off.\""
msgstr "„A także może to być sposób na wystraszenie nas”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It may be a mechanism for attracting prey.\""
msgstr "„To może być mechanizm zwabiania zwierzyny”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It tries to open the door a few times an hour.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid ""
"\"It was just wandering around by the freeway.  It might have been hit by a "
"car.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It won't hurt a bit.\""
msgstr "„Nic nie zaboli”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"It'll be over quick.  I promise.\""
msgstr "„To się szybko skończy. Obiecuję”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid ""
"\"It's almost like they can't tell we're trying to talk to them, or maybe "
"they just don't care.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid ""
"\"It's capable of complex problem solving.  It's clearly not just an animal."
"\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's faster than us.\""
msgstr "„Jest od nas szybsze”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's heading right for us!\""
msgstr "„Idzie prosto na nas”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's just a scratch.\""
msgstr "„To tylko zadrapanie.”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's just repeating us.\""
msgstr "„Tylko po nas powtarza”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's looking for us.\""
msgstr "„To nas szuka”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's looking right at us.\""
msgstr "„Patrzy prosto na nas”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's parroting us, but we're uncertain as to how or why.\""
msgstr "„Naśladuje nas jak papuga, ale nie mamy pewności jak i dlaczego”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"It's probably more scared of us than we are of it.\""
msgstr "„Pewnie jest bardziej przerażona nami, niż my nią”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"It's so cold.\""
msgstr "„Jest tak zimno”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"I… I feel weak…\""
msgstr "„Czuję się… słabo…”"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Just a little.\""
msgstr "„Tylko trochę”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Just because it doesn't look like you doesn't mean that it isn't.\""
msgstr "„To, że nie wygląda jak ty, nie oznacza. że nie jest”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Just being an alien creature doesn't mean it's intelligent.\""
msgstr "„To, że jest obce, nie oznacza, że jest inteligentne”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Keep your hands up!\""
msgstr "„Trzymaj swoje ręce wysoko!”."

#. ~ Speech from speaker mon_civilian_zombiefighter
#: data/json/speech.json
msgid "\"Kick the bucket, filthy dead!\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Kill 'em all and let God sort 'em out!\""
msgstr ""

#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"LEAVE!  NOW!\""
msgstr "„ODEJDŹ! TERAZ!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Lemme outta here!\""
msgstr "„Wypuście mnie stąd!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Let me have a look at it.\""
msgstr "„Pozwól, że na to zerknę”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Let me see your hands!\""
msgstr "„Pokaż mi ręce!”."

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor, mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Let's have a tea party!\""
msgstr "„Zróbmy przyjęcie herbaciane!”."

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor, mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Let's have fun!\""
msgstr "„Pobawmy się!”."

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor, mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Let's play together!\""
msgstr "„Zagrajmy razem!”."

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Let's play… Russian roulette.\""
msgstr "„Zagrajmy… w rosyjską ruletkę”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Like a parrot?\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Look at this fuckin' shit we're in, man.\""
msgstr "„Spójrz na to gówno w którym się znaleźliśmy, człowieku”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Look out!\""
msgstr "„Uważaj!”."

#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"MEAT!\""
msgstr "„MIĘSO!”."

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor, mon_mannequin_decoy
#: data/json/speech.json
msgid "\"May I have a cookie?\""
msgstr "„Mogę ciasteczko?”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Maybe.  Except they repeat things they've never heard before.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Me go, you stay.\""
msgstr "„Ja iść, ty zostać!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid ""
"\"Members of the species have some capacity to transmit information over "
"long distances.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid ""
"\"Mimicry in nature is usually to get close to prey or deter predators, but…"
"\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Mom, I miss you.\""
msgstr "„Mamo, tęsknię za tobą”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Mom.\""
msgstr "„Mamo”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Mommy, help!\""
msgstr "„Mamo, pomocy!”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Mommy?\""
msgstr "„Mamusiu?”."

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"My previous owner squealed like a pig when I gutted her!\""
msgstr "„Moja poprzednia właścicielka kwiczała jak świnia, gdy ją oprawiłem!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Negative.\""
msgstr "„Zaprzeczam”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"No officer on scene.  Requesting backup!\""
msgstr "„Brak służb na miejscu. Wzywam wsparcie!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"No!\""
msgstr "„Nie!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"No, we can't go in there.  It would tear us apart.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Nobody is helping us.\""
msgstr "„Nikt nam nie pomaga”."

#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Not that way!  Go left!\""
msgstr "„Nie tędy! W lewo!”."

#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"No… stop the burning!\""
msgstr "„Nie… powstrzymaj to pieczenie!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Oh God, I'm the only one left.\""
msgstr "„O Boże, zostałem tylko ja”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Oh God, my leg, Oh God!\""
msgstr "„O Boże, moja noga, o Boże!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Oh you motherfucking shellfish, you're going down.\""
msgstr "„O ty cholerny skorupiaku, już po tobie”."

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor, mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Oh, how fun!\""
msgstr "„O, jak fajnie!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi-go_surgeon
#: data/json/speech.json
msgid "\"Oi, dingus, you can't keep me in 'ere.\""
msgstr "„Ej, kolo, nie możesz mnie tu zatrzymać”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Okay.\""
msgstr "„Okej”."

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor, mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Om nom nom!  Delicious!\""
msgstr "„Mniam, mniam! Pychota!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Only a few more days 'til the weekend.\""
msgstr "„Za parę dni weekend”."

#. ~ Speech from speaker mon_shoggoth, mon_mi_go, mon_mi_go_abductor, mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Oooouuooooo…\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid ""
"\"Other than the mimicry, they have not responded to any of our attempts to "
"communicate.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Over here!\""
msgstr "„Tutaj!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Papaya!\""
msgstr "„Papaja!”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Please help me.\""
msgstr "„Pomóż mi, proszę”."

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor, mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Please take me with you!\""
msgstr "„Proszę, weź mnie ze sobą!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Please, God…\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Please, I don't want to die.\""
msgstr "„Proszę, nie chcę umierać”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Please, don't!\""
msgstr "„Proszę, nie!”."

#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid ""
"\"Please, kill me!\", followed by an electronic voice saying \"SELF "
"PRESERVATION PROTOCOLS ACTIVATED\""
msgstr ""
"„Proszę, zabij mnie!”, po którym słychać elektroniczny głos „PROTOKOŁY "
"SAMOZACHOWAWCZE AKTYWOWANE”"

#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Please, take me with you.\""
msgstr "„Proszę, zabierz mnie ze sobą”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Police inbound.  Stay where you are!\""
msgstr "„Policja w drodze. Zostań tam, gdzie jesteś!”"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Positive.\""
msgstr "„Zgadza się”."

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Put it down!  We can talk about this…\""
msgstr "„Odłóż to, możemy o tym porozmawiać…”."

#. ~ Speech from speaker mon_feral_sapien_spear
#: data/json/speech.json
msgid "\"Raagh!\""
msgstr "„Raaaa!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Remain where you are!\""
msgstr "„Zostań tam gdzie jesteś!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Requesting assistance!\""
msgstr "„Prośba o wsparcie!”."

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Requesting supervisor!\""
msgstr "„Prośba o nadzór!”"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
