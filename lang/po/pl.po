#: data/json/npcs/talk_tags.json
msgid "Hey!  Do you speak English?"
msgstr "Hej! Mówisz po polsku?"

#. ~ Snippet in category "<witnessed_thievery>"
#. ~ Warning from non-hostile NPCs when the player steals something.
#: data/json/npcs/talk_tags.json
msgid "Hey!  I <swear> saw you take that <name_b>!  Drop it.  Now."
msgstr "Hej! Widziałem cię jak bierzesz ten <name_b>! Rzuć to. Natychmiast."

#. ~ Snippet in category "<speech_warning>"
#. ~ NPC complaint that they heard an unknown voice.  This goes off a lot and could use more variety.
#: data/json/npcs/talk_tags.json
msgid "Hey!  I heard something."
msgstr "Hej! Coś usłyszałem."

#. ~ Snippet in category "<monster_warning>"
#. ~ This is a warning about a dangerous monster, and the code always follows it with the name of the monster.
#: data/json/npcs/talk_tags.json
msgid "Hey!  Over there!  I see a"
msgstr "Hej! Tam! Widzę"

#. ~ Snippet in category "<wait>"
#. ~ The NPC says these things when the player has moved out of sight and the NPCs wants to catch up.
#: data/json/npcs/talk_tags.json
