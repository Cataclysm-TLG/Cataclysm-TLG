#~ msgid ""
#~ "A t-shirt with the Debian logo on it, underneath it says \"The Universal "
#~ "Operating System\""
#~ msgstr "T-shirt z logo Debiana i napisem „Ostateczny system operacyjny”."

#~ msgid ""
#~ "A t-shirt with the Fedora logo on it, underneath it says \"Freedom.  "
#~ "Friends.  Features.  First.\""
