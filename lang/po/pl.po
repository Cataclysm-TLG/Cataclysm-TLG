#. ~ NPC dialogue line
#: data/json/npcs/tacoma_ranch/NPC_ranch_sickly_laborer.json
msgid "Please leave me alone…"
msgstr "Zostaw mnie proszę w spokoju…"

#. ~ Response to NPC dialogue
#: data/json/npcs/tacoma_ranch/NPC_ranch_sickly_laborer.json
msgid "That's sad."
msgstr "To smutne."

#. ~ Response to NPC dialogue
#: data/json/npcs/tacoma_ranch/NPC_ranch_sickly_laborer.json
