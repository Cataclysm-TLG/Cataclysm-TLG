#: data/json/npcs/hub01/robofac_basement_npcs/NPC_Jonathan_Farrier.json
msgid "Hub 01 Assistant"
msgstr "Asystent Hub 01"

#. ~ Job description of "Hub 01 Assistant" NPC class
#. ~ Trucker and now general handyman.  Used to work as a cargo driver for a company supplying Hub 01, is only inside the lab by chance.
#: data/json/npcs/hub01/robofac_basement_npcs/NPC_Jonathan_Farrier.json
msgid "I do miscellaneous jobs within Hub 01."
msgstr "Wykonuję rozmaite zadania w Hub 01."

