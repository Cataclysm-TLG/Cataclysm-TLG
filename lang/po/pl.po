#. ~ Response to NPC dialogue
#: data/json/npcs/other/TALK_ANIMAL_SHELTER_SURVIVOR.json
msgid "Could I buy one of your pets?"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/other/TALK_ANIMAL_SHELTER_SURVIVOR.json
msgid "Finally, someone who isn't part of those <zombies>."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/other/TALK_ANIMAL_SHELTER_SURVIVOR.json
#: data/json/npcs/other/TALK_GUN_STORE_SURVIVOR.json
msgid "Hey, nice to meet you."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/other/TALK_ANIMAL_SHELTER_SURVIVOR.json
msgid ""
"I hate to see them go, but I think you'd be able to take better care of one "
"than I can right now.  I can sell you a cat or dog of your choosing, for $25 "
"and $50, respectively."
msgstr ""

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/Cataclysm-TLG/Cataclysm-TLG/blob/master/doc/TRANSLATING.md#grammatical-gender
