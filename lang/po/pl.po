msgstr ""

#. ~ Description of terrain "rocky coastline"
#: data/json/furniture_and_terrain/terrain-beach.json
msgid ""
"This is a section of eroded natural stone formations along the beach, the "
"water lapping and splashing at the edges."
msgstr ""

