#. ~ Response to NPC dialogue
#: data/json/npcs/necc/members/NPC_Zachary_Montes.json
msgid "Hey, good to see you're still around."
msgstr "Hej, dobrze widzieć, że nadal tu jesteś."

#. ~ NPC dialogue line
#: data/json/npcs/necc/members/NPC_Zachary_Montes.json
msgid ""
"I ain't leaving, <name_g>.  Not until that eldritch screeching nightmare is "
"dead 'n buried."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/necc/members/NPC_Zachary_Montes.json
msgid ""
"I got here first, therefore this place belongs to me.  Them's the rules in "
"the <the_cataclysm>."
msgstr ""

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/Cataclysm-TLG/Cataclysm-TLG/blob/master/doc/TRANSLATING.md#grammatical-gender
#: data/json/npcs/necc/members/NPC_Zachary_Montes.json
msgctxt "u:f"
msgid "I got my rights to be here, chum.  Squatter's rights!"
msgstr "Mam swoje prawa do bycia tutaj, chłopie. Prawa dzikiego lokatora!"

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/Cataclysm-TLG/Cataclysm-TLG/blob/master/doc/TRANSLATING.md#grammatical-gender
