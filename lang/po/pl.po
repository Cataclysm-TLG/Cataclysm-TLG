#. ~ Description of vehicle part "cloth seat"
#: data/json/vehicleparts/seats.json
msgid "A simple fabric seat, suspended from the frame itself."
msgstr ""

#. ~ Description of vehicle part "reclining bucket seat"
#: data/json/vehicleparts/seats.json
