#. ~ Description of furniture "chicory"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A blue flower imported from Europe, also known as a cornflower."
msgstr ""

#. ~ Description of furniture "tulip"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A bright, colorful flower with petals forming a small cup at its top.  It "
"can be poisonous to livestock."
msgstr ""

#. ~ Description of furniture "bluebell"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A common bluebell flower.  Pretty."
msgstr "Pospolity kwiat martensji. Ładny."

#. ~ Description of furniture "burdock"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A common weed with a purple thistle-like flower.  Its seeds tend to stick to "
"clothing and fur."
msgstr ""
"Pospolity chwast o fioletowych, przypominających oset kwiatach. Jego nasiona "
"mają tendencję do przyklejania się do ubrań i sierści."

#. ~ Description of furniture "dandelion"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A common weed with a yellow flower.  Produces seeds that get carried on the "
"wind by thin, gray filaments."
msgstr ""
"Pospolity chwast o żółtych kwiatach. Wytwarza nasiona, które są przenoszone "
"przez wiatr za pomocą cienkich, szarych włókien."

#. ~ Description of furniture "wild carrot"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A common white wildflower which could be harvested for its root."
msgstr ""
"Pospolita biała dziko rosnąca roślina, którą można zbierać dla jej korzenia."

#. ~ Description of furniture "chamomile"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A cute white flower with a yellow center, used to brew a soothing tea."
msgstr ""

#. ~ Description of furniture "dam"
#: data/json/furniture_and_terrain/furniture-flora.json
#: data/mods/innawood/furniture_and_terrain/misc.json
msgid ""
"A house that beavers built.  The entrance is underwater making it harder for "
"predators to access."
msgstr ""

#. ~ Description of furniture "lotus"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A lovely flower that grows on the surface of bodies of fresh water.  A "
"traditional symbol of many Eastern cultures."
msgstr ""

#. ~ Description of furniture "black eyed Susan"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A mildly poisonous yellow flower with a dark ball in the middle.  Sometimes "
"known as an ox-eye daisy."
msgstr ""

#. ~ Description of furniture "lily"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A pretty flower that comes in a variety of colors."
msgstr "Piękny kwiat, który występuje w różnych kolorach."

#. ~ Description of furniture "datura"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A pretty moonflower."
msgstr "Piękny bieluń."

#. ~ Description of furniture "purple loosestrife"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A pretty violet flower that likes water.  Unfortunately it is invasive and "
"does not benefit the environment."
msgstr ""

#. ~ Description of furniture "thistle"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A prickly and invasive small plant."
msgstr ""

#. ~ Description of furniture "dahlia"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A puffy flower with many tightly-layered petals."
msgstr ""

#. ~ Description of furniture "animal topiary"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A shrub with small green leaves, trimmed into a dragon shape."
msgstr ""

#. ~ Description of furniture "abstract topiary"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A shrub with small green leaves, trimmed into a fanciful abstract shape."
msgstr ""

#. ~ Description of furniture "short hedge"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A shrub with small green leaves, trimmed into a squared shape."
msgstr "Krzew o małych, zielonych liściach, przyciętych w kwadratowy kształt."

#. ~ Description of furniture "animal topiary"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A shrub with small green leaves, trimmed into an animal shape."
msgstr ""

#. ~ Description of furniture "pile of leaves"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A sizable pile of leaves.  You could sleep on it if you don't care about "
"comfort or warmth."
msgstr ""
"Spory stos liści. Możesz na nim spać jeśli nie dbasz o komfort lub ciepło."

#. ~ Description of furniture "common selfheal"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A small purple flower.  It got its name due to its usage in traditional "
"medicine."
msgstr ""

#. ~ Description of furniture "wintergreen"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A small shrub native to North America.  The leaves, which remain green even "
"in winter, are valued for medicinal purposes.  It produces edible and sweet "
"berries, too!"
msgstr ""
"Niewielka krzewinka pochodząca z Ameryki Północnej. Liście, które pozostają "
"zielone nawet w zimie, są cenione do celów leczniczych. Wytwarza również "
"jadalne i słodkie jagody!"

#. ~ Description of furniture "wild sarsaparilla"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A small, flowering plant known as 'Aralia nudicaulis'.  It is colored in "
"vibrant shades of orange and red in autumn, making it easy to spot."
msgstr ""
"Mała, kwitnąca roślina znana jako „Aralia nudicaulis”. Jesienią przebarwia "
"się na żywe odcienie pomarańczu i czerwieni, dzięki czemu łatwo ją zauważyć."

#. ~ Description of furniture "tall hedge"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A tall shrub with small green leaves, trimmed into a squared shape."
msgstr ""

#. ~ Description of furniture "sunflower"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A tall, wide-headed flower with a large dark center.  Produces many "
"nutritious seeds."
msgstr ""
"Wysoki, rozłożysty kwiat z dużym ciemnym środkiem. Wytwarza wiele pożywnych "
"nasion."

#. ~ Description of furniture "mustard"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"A yellow flower known as Brassica Nigra.  Known for its seeds that can be "
"used for making table mustard."
msgstr ""

#. ~ Description of furniture "spurge flower"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "A yellow-green flower that grows in densely-packed bushes."
msgstr ""

#. ~ Description of furniture "wild rice"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"Also called Indian rice, Northern wild rice, or manoomin in Ojibwe, is a "
"species of rice that has been harvested and used by Native American tribes "
"of the northeast for hundreds of years.  It's similar to other types of wild "
"rice, offering a fiber-rich and healthy basis of a meal."
msgstr ""

#. ~ Description of furniture "Japanese knotweed"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"An invasive species originating from Japan.  The stem looks like it might "
"contain some water."
msgstr ""
"Gatunek inwazyjny pochodzący z Japonii. Wygląda na to, że łodyga może "
"zawierać trochę wody."

#. ~ Description of furniture "spreading dogbane"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"It is not only toxic to dogs when eaten by them.  Humans and many other "
"animals are affected, too.  Its fibers sure are worth salvaging though.  "
"Despite its name, it is not actually spreading fast."
msgstr ""

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "Japanese knotweed"
msgstr "rdestowiec ostrokończysty"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "Jerusalem artichoke plant"
msgstr "słonecznik bulwiasty"

#. ~ Description of furniture "Jerusalem artichoke plant"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid "Looking similar to a sunflower, this tall plant has a nutritious tuber."
msgstr ""

#. ~ Description of furniture "poppy flower"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"Papaver somniferum, also known as the opium poppy.  These harmless-looking "
"flowers were once widely cultivated for decorative purposes, but in summer "
"their heads may be harvested and used in the production of a highly "
"addictive painkiller."
msgstr ""

#. ~ Description of furniture "starry false Solomon's seal"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"The blossoms of this flower look like stars in the night sky.  Its crimson "
"berries are edible."
msgstr ""
"Kwiaty tego kwiatu wyglądają jak gwiazdy na nocnym niebie. Jego karmazynowe "
"jagody są jadalne."

#. ~ Description of furniture "lilypad"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"This lilypad doesn't look like it would support the weight of the things "
"you've heard croaking in the swamp."
msgstr ""

#. ~ Description of furniture "dead plant"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"This plant has joined the billions lost in the Cataclysm, and is now little "
"more than a dry stalk."
msgstr ""

#. ~ Description of furniture "cattails"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"This useful plant is available all year round.  Many parts of the plant are "
"edible."
msgstr ""
"Ta pożyteczna roślina jest dostępna przez cały rok. Wiele części rośliny "
"jest jadalnych."

#. ~ Description of furniture "salsify"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"Tragopogon porrifolius, a ragged-looking purple flower with a nutritious "
"root."
msgstr ""
"Tragopogon porrifolius - purpurowy kwiat o poszarpanym wyglądzie i pożywny "
"korzeń."

#. ~ Description of furniture "fireweed"
#: data/json/furniture_and_terrain/furniture-flora.json
msgid ""
"Vibrant purple, it tends to be the first to appear after fires, hence its "
"name."
msgstr ""

