#. ~ Snippet in category "<schizo_weapon_talk_misc>"
#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_girl.json
#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_woman.json
#: data/json/snippets/schizophrenia.json
msgid "How are you today?"
msgstr "Jak się dzisiaj masz?"

#. ~ NPC dialogue line
#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_girl.json
msgid ""
"I don't have much to tell, sorry.  I'm busy with helping my mom, tiding this "
"place to make it our new home.  You should talk to my dad, he doesn't look "
"busy right now.  Or always…"
msgstr ""
"Nie mam zbyt wiele do powiedzenia, przepraszam. Jestem zajęty pomaganiem "
"mamie, porządkowaniem tego miejsca, aby stało się naszym nowym domem. "
"Powinnaś porozmawiać z moim tatą, nie wygląda na zajętego w tej chwili. W "
"zasadzie nigdy…"

#. ~ Response to NPC dialogue
#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_girl.json
#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_man.json
#: data/json/npcs/Lighthouse_Family/NPC_lighthouse_woman.json
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
#: data/json/npcs/your_followers/luo_follower.json
