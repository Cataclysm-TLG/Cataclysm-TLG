#~ "ziemi, zbyt obżarte ścierwem, by latać."

#~ msgid "This mech has a dead battery and won't turn on"
#~ msgstr "Ten mech ma rozładowaną baterię i nie włączy się"

#~ msgid "This might not be a very private place."
#~ msgstr "To może nie być zbyt prywatne miejsce."

#~ msgid ""
#~ "This module increases the exosuit's weight bearing at the cost of "
#~ "increased power consumption."
