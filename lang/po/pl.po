msgid_plural "boiled human stomachs"
msgstr[0] "gotowany ludzki żołądek"
msgstr[1] "gotowane ludzkie żołądki"
msgstr[2] "gotowanych ludzkich żołądków"
msgstr[3] "gotowanego ludzkiego żołądka"

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "boiled large human stomach"
msgid_plural "boiled large human stomachs"
msgstr[0] "duży gotowany ludzki żołądek"
msgstr[1] "duże gotowane ludzkie żołądki"
msgstr[2] "dużych gotowanych ludzkich żołądków"
msgstr[3] "dużego gotowanego ludzkiego żołądka"

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "boiled stomach"
msgid_plural "boiled stomachs"
msgstr[0] "gotowany żołądek"
msgstr[1] "gotowane żołądki"
msgstr[2] "gotowanych żołądków"
msgstr[3] "gotowanego żołądka"

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "butchery refuse"
msgid_plural "butchery refuse"
msgstr[0] "odrzut rzeźniczy"
