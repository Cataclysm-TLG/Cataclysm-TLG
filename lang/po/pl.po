#. ~ Item name
#: data/json/items/ammo.json
msgid "120mm HEAT"
msgid_plural "120mm HEAT"
msgstr[0] "120 mm kumulacyjny"
msgstr[1] "120 mm kumulacyjne"
msgstr[2] "120 mm kumulacyjnych"
msgstr[3] "120 mm kumulacyjnego"

#. ~ Description of "120mm HEAT"
#: data/json/items/ammo.json
msgid ""
"A 120mm high-explosive anti-tank round.  It could ruin anyone's whole day."
msgstr ""
"120 mm pocisk kumulacyjny ze zintegrowanym ładunkiem wybuchowym. Potrafi "
"zrujnować komuś cały dzień."

#. ~ Description of "albuterol"
#: data/json/items/ammo.json
msgid ""
"A bronchodilator that relaxes muscles in the airways and increases air flow "
"to the lungs."
msgstr ""
"Lek rozszerzający oskrzela, który rozluźnia mięśnie dróg oddechowych i "
"zwiększa przepływ powietrza do płuc."

#. ~ Description of "solid hydrogen canister"
#: data/json/items/ammo.json
msgid ""
"A canister of pressurized hydrogen so heavily compressed it has turned "
"solid.  With proper equipment, it could be heated into plasma."
msgstr ""

#. ~ Description of "chunk of rubber"
#: data/json/items/ammo.json
msgid "A chunk of useful rubber that can be molded easily."
msgstr ""

#. ~ Description of "soap bar"
#: data/json/items/ammo.json
msgid "A cleansing agent shaped into a bar."
msgstr ""

#. ~ Description of "butane"
#: data/json/items/ammo.json
msgid "A common flammable liquid, used in lighters."
msgstr ""

#. ~ Description of "moisturizer"
#: data/json/items/ammo.json
msgid ""
"A cosmetic preparation used for protecting, moisturizing, and lubricating "
"the skin."
msgstr ""
"Preparat kosmetyczny stosowany do ochrony, nawilżania i natłuszczania skóry."

#. ~ Description of "extinguishing agent"
#: data/json/items/ammo.json
msgid "A dry chemical solution effective at extinguishing fires."
msgstr ""

#. ~ Description of "feather"
#: data/json/items/ammo.json
msgid "A feather from a bird.  Useful for fletching arrows."
msgstr ""

#. ~ Description of "charcoal"
#: data/json/items/ammo.json
msgid ""
"A flammable carbon-based material produced by slowly burning wood.  Utilized "
"in recipes requiring a pure, hot flame.  Can also be used in filters to "
"remove contaminants from air and water."
msgstr ""

#. ~ Description of "down feather"
#: data/json/items/ammo.json
msgid "A fluffy down feather from a bird.  Useful for making cozy bedclothes."
msgstr ""

#. ~ Description of "marble"
#: data/json/items/ammo.json
msgid "A glass marble, useful as ammunition for a slingshot."
msgstr ""

#. ~ Description of "fish bait"
#: data/json/items/ammo.json
msgid "A handful of bait, used in traps to lure fish."
msgstr ""

#. ~ Description of "raw copper wire"
#: data/json/items/ammo.json
msgid "A length of copper wire ready to be covered with plastic."
msgstr ""

#. ~ Description of "copper wire"
#: data/json/items/ammo.json
msgid ""
"A length of plastic-jacketed copper cable, of the type used in small "
"electronics."
msgstr ""

#. ~ Description of "yarn"
#: data/json/items/ammo.json
msgid "A length of wool yarn that could be used to knit wool clothing."
msgstr ""

#. ~ Description of "gas mask cartridge"
#. ~ Description of magazine "gas mask cartridge"
#: data/json/items/ammo.json data/json/items/magazine/filter.json
msgid ""
"A medium-sized, replaceable filter cartridge for an air filtration mask."
msgstr ""

#. ~ Description of "metal RPG die"
#: data/json/items/ammo.json
msgid "A metal die used to play various role-playing games."
msgstr ""

#. ~ Description of "glowstick juice"
#: data/json/items/ammo.json
msgid ""
"A mix of blue dye, base catalyst, and diphenyl oxalate used in glowsticks."
msgstr ""
"Mieszanka niebieskiego barwnika, niebieskiego katalizatora i szczawianu "
"difenylu używanego w światłach chemicznych."

#. ~ Description of "nitrox"
#: data/json/items/ammo.json
msgid ""
"A mixture of oxygen and nitrogen in proportions suitable for sustaining "
"divers."
msgstr ""

#. ~ Description of "notch"
#: data/json/items/ammo.json
msgid "A notch used with a fire drill to create an ember."
msgstr ""

#. ~ Description of "tear gas spray"
#: data/json/items/ammo.json
msgid ""
"A noxious aerosolized irritant used to fend off attackers both human and "
"bear alike."
msgstr ""

#. ~ Description of "pebble"
#: data/json/items/ammo.json
msgid ""
"A palm-sized stone about the right shape to be used as ammunition for a "
"sling."
msgstr ""

#. ~ Description of "RPG die"
#: data/json/items/ammo.json
msgid "A plastic die used to play various role-playing games."
msgstr ""

#. ~ Description of "liquid bandage"
#: data/json/items/ammo.json
msgid ""
"A polymer dissolved in solvent, with antiseptic added, for topical treatment "
"of minor cuts and scrapes."
msgstr ""

#. ~ Description of "RA10K stimulant module"
#: data/json/items/ammo.json
msgid ""
"A pressurized multi-chamber glass vial filled with powerful chemical "
"stimulants which can only be activated by a Rivtech stimulant delivery "
"system."
msgstr ""
"Ciśnieniowa wielokomorowa kapsuła szklana wypełniona chemicznymi "
"stymulantami, które mogą być dozowane wyłącznie systemem dozowania "
"stymulantów marki Rivtech."

#. ~ Description of "large pistol primer"
#: data/json/items/ammo.json
msgid "A primer from a large-caliber pistol round."
msgstr ""

#. ~ Description of "large rifle primer"
#: data/json/items/ammo.json
msgid "A primer from a large-caliber rifle round."
msgstr ""

#. ~ Description of "shotgun primer"
#: data/json/items/ammo.json
msgid "A primer from a shotgun shell."
msgstr ""

#. ~ Description of "small pistol primer"
#: data/json/items/ammo.json
msgid "A primer from a small-caliber pistol round."
msgstr ""

#. ~ Description of "small rifle primer"
#: data/json/items/ammo.json
msgid "A primer from a small-caliber rifle round."
msgstr ""

#. ~ Description of "flare pyrotechnic"
#: data/json/items/ammo.json
msgid "A pyrotechnic chemical used in flares."
msgstr "Chemikalia pirotechniczne używane w flarach."

#. ~ Description of "duct tape"
#: data/json/items/ammo.json
msgid "A roll of incredibly strong tape.  Its uses are innumerable."
msgstr ""
"Rolka niezwykle wytrzymałej taśmy klejącej. Jej zastosowania są niezliczone."

#. ~ Description of "medical tape"
#: data/json/items/ammo.json
msgid ""
"A roll of semi-opaque medical tape, intended to hold bandages in place.  Not "
"as versatile as duct tape."
msgstr ""

#. ~ Description of "rubber slug"
#: data/json/items/ammo.json
msgid ""
"A rubber slug from a shotgun beanbag round.  You could use it to make a new "
"beanbag round."
msgstr ""

#. ~ Description of "chainmail link"
#: data/json/items/ammo.json
msgid "A set of small metal rings, suitable for constructing chainmail."
msgstr ""

#. ~ Description of "aluminum foil"
#: data/json/items/ammo.json
msgid ""
"A sheet of thin foil made of aluminum.  Sometimes called 'tin foil' due to "
"being made of tin in the past."
msgstr ""

#. ~ Description of "thread"
#: data/json/items/ammo.json
msgid "A small quantity of thread that could be used for sewing."
msgstr ""

#. ~ Description of "BB"
#: data/json/items/ammo.json
msgid ""
"A small steel ball that can be fired from a BB gun.  Deals virtually no "
"damage."
msgstr ""

#. ~ Description of "match"
#: data/json/items/ammo.json
msgid ""
"A small stick with a red part at the end.  Strike it against a matchbook to "
"light it."
msgstr ""
"Patyczek z czerwoną końcówką. Przeciągnij po opakowaniu zapałek, aby "
"rozpalić."

#. ~ Description of "filter mask cartridge"
#: data/json/items/ammo.json
msgid "A small, replaceable filter cartridge for an air filtration mask."
msgstr ""

#. ~ Description of "candle wax"
#: data/json/items/ammo.json
msgid "A solid flammable substance, used to make candles."
msgstr ""

#. ~ Description of "ball bearing"
#: data/json/items/ammo.json
msgid "A steel ball bearing, useful as ammunition for a slingshot."
msgstr ""

#. ~ Description of "rock"
#: data/json/items/ammo.json
msgid "A stone about the size of a baseball."
msgstr ""

#. ~ Description of "rolling paper"
#: data/json/items/ammo.json
msgid ""
"A thin paper strip intended for the rolling of cigarettes or other "
"smokeables."
msgstr ""

#. ~ Description of "air rifle target pellet"
#: data/json/items/ammo.json
msgid ""
"A tin of small cone-shaped pellets meant to be used in an air rifle.  These "
"are mostly only suitable for target practice."
msgstr ""

#. ~ Description of "air rifle hunting pellet"
#: data/json/items/ammo.json
msgid ""
"A tin of small cone-shaped pellets meant to be used in an air rifle.  These "
"might be suitable for hunting birds or squirrels."
msgstr ""

#. ~ Description of "RA21E medical ampoule"
#: data/json/items/ammo.json
msgid ""
"A tiny glass vial filled with advanced fast-healing chemicals which can only "
"be activated by a Rivtech jet injector device.  The packaged instructions "
"describe its efficacy in dealing with infections, wounds, intoxications, "
"envenomations, and general tiredness in enthusiastic detail.  A short safety "
"section at the end warns - in much smaller typeface - against using more "
"than two doses per hour."
msgstr ""

#. ~ Description of "sinew"
#: data/json/items/ammo.json
msgid "A tough sinew cut from a corpse, usable as thread."
msgstr "Wytrzymałe ścięgna wycięte z ciała, mogą zastąpić nici."

#. ~ Description of "cent"
#: data/json/items/ammo.json
msgid "A unit of currency equivalent to 0.01 US dollars."
msgstr "Jednostka monetarna równa 0,01 dolara amerykańskiego."

#. ~ Description of "insecticidal gas"
#: data/json/items/ammo.json
msgid "Aerosolized pesticides formulated to kill all sorts of arthropods."
msgstr ""

#. ~ Description of "clay sling bullet"
#: data/json/items/ammo.json
msgid "An oblong piece of hardened clay, designed for use as sling ammunition."
msgstr ""

#. ~ Description of "lead sling bullet"
#: data/json/items/ammo.json
msgid ""
"An oblong piece of lead, designed for use as sling ammunition.  As sling "
"ammo goes, these are about as accurate as it gets, and in the right hands "
"can be surprisingly effective."
msgstr ""

#. ~ Item name
#: data/json/items/ammo.json
msgid "BB"
msgid_plural "BBs"
msgstr[0] "kulka ze śrutu"
msgstr[1] "kulki ze śrutu"
msgstr[2] "kulek ze śrutu"
msgstr[3] "kulki ze śrutu"

#. ~ Description of "black pen ink"
#: data/json/items/ammo.json
msgid ""
"Carbon black pigment infused with polymers, stabilizers, and water to help "
"the ink flow properly."
msgstr ""

#. ~ Description of "green pen ink"
#: data/json/items/ammo.json
msgid ""
"Chlorophyll pigment infused with polymers, stabilizers, and water to help "
"the ink flow properly."
msgstr ""

#. ~ Description of "hydrogen"
#: data/json/items/ammo.json
msgid "Compressed hydrogen."
msgstr ""

#. ~ Description of "oxygen"
#: data/json/items/ammo.json
msgid "Compressed medical oxygen."
msgstr "Skompresowany tlen medyczny."

#. ~ Description of "nitrogen"
#: data/json/items/ammo.json
msgid "Compressed nitrogen."
msgstr ""

#. ~ Description of "radioisotope thermoelectric generator"
#: data/json/items/ammo.json
msgid ""
"Did your neighbors brag about their cool beta-decay-powered nightlights?  Do "
"them one better!  The CuppaTech 4 radioisotope thermoelectric generator is a "
"three kilogram chunk of metal - mostly lead - with a slug of cerium-244 "
"encased within.  It is capable of generating somewhere between 100-150 Watts "
"of thermal energy, although its electrical generation capacity is minimal at "
"only 2 Watts.  Careful!  Curium is great at making heat, and also releases "
"deadly gamma radiation.  Keep away from cellular life forms."
msgstr ""

#. ~ Description of "red pen ink"
#: data/json/items/ammo.json
msgid ""
"Eosin dye infused with polymers, stabilizers, and water to help the ink flow "
"properly."
msgstr ""

#. ~ Description of "smokeless overbore rifle powder"
#: data/json/items/ammo.json
msgid "Firearm-quality gunpowder intended for use in large rifle ammunition."
msgstr ""
"Proch strzelniczy używany w dużych pociskach przeznaczonych do broni typu "
"overbore."

#. ~ Description of "smokeless magnum powder"
#: data/json/items/ammo.json
msgid "Firearm-quality gunpowder intended for use in magnum pistol ammunition."
msgstr ""
"Proch strzelniczy używany w pociskach przeznaczonych do broni typu magnum."

#. ~ Description of "smokeless pistol powder"
#: data/json/items/ammo.json
msgid "Firearm-quality gunpowder intended for use in pistol ammunition."
msgstr ""

#. ~ Description of "smokeless rifle powder"
#: data/json/items/ammo.json
msgid "Firearm-quality gunpowder intended for use in rifle ammunition."
msgstr "Proch strzelniczy używany w pociskach przeznaczonych do karabinów."

#. ~ Description of "smokeless shotgun powder"
#: data/json/items/ammo.json
msgid "Firearm-quality gunpowder intended for use in shotgun shells."
msgstr ""

#. ~ Description of "mixed smokeless gunpowder"
#: data/json/items/ammo.json
msgid ""
"Firearm-quality gunpowder, mixed without concern for composition, burn rate, "
"or shape, making it thoroughly useless for reloading ammunition.  It has "
"been slightly ground to make its properties more uniform."
msgstr ""

#. ~ Description of "coal"
#: data/json/items/ammo.json
msgid ""
"Flammable black chunks of carbon-based material, commonly used for cooking "
"and heating."
msgstr ""

#. ~ Description of "tinder"
#: data/json/items/ammo.json
msgid "Flammable material, finely divided for easy combustion."
msgstr "Palny materiał, drobno rozdrobniony, dla łatwego rozpalenia."

#. ~ Description of "rebreather scrubbing filler"
#: data/json/items/ammo.json
msgid ""
"Granulated mixture of slaked lime, potassium hydroxide and/or sodium "
"hydroxide that is used as CO2 scrubbing agent in rebreathers."
msgstr ""

#. ~ Description of "graphite"
#: data/json/items/ammo.json
msgid ""
"Graphite powder mixed with a clay binder.  Produces gray or black marks that "
"are easily erased, but otherwise resistant to moisture, most chemicals, "
"ultraviolet radiation, and natural aging."
msgstr ""

#. ~ Description of "betavoltaic cell"
#: data/json/items/ammo.json
msgid ""
"Harness the power of radiation in your own home!  It looks similar to a D-"
"cell battery, but actually contains folded layers of radioactive material "
"inside.  It can produce electricity for several years at a steady voltage… "
"but it's barely enough to power a small LED, and these batteries were worth "
"hundreds of dollars.  Mostly they're a good way to brag to your neighbors "
"that you have a nuclear power source in your house."
msgstr ""

#. ~ Description of "plutonium slurry"
#. ~ Description of "watery plutonium slurry"
#: data/json/items/ammo.json
msgid ""
"Highly-radioactive slurry.  It is probably best to get far away from this."
msgstr ""

#. ~ Description of "permanent ink"
#: data/json/items/ammo.json
msgid ""
"Ink comprised of a main carrier solvent, a glyceride, a pyrrolidone, a "
"resin, and a colorant, making it water resistant."
msgstr ""

#. ~ Description of "quill ink"
#: data/json/items/ammo.json
msgid "Ink made from a variety of sources for use in quill style pens."
msgstr ""

#. ~ Description of "nicotine liquid"
#: data/json/items/ammo.json
msgid ""
"Liquid made up of propylene glycol, vegetable glycerin, flavorings, and "
"nicotine.  Intended for use in an advanced electronic cigarette."
msgstr ""

#. ~ Description of "rubber sealant"
#: data/json/items/ammo.json
msgid ""
"Liquid rubber that comes in a sealed, pressurized container and is released "
"in an aerosol spray when a valve button is depressed.  It dries in air, and "
"can be used to waterproof items or repair leaks."
msgstr ""

#. ~ Description of "aerosol paint"
#: data/json/items/ammo.json
msgid ""
"Paint that comes in a sealed, pressurized container and is released in an "
"aerosol spray when a valve button is depressed."
msgstr ""

#. ~ Description of "rebreather oxygen regenerator filler"
#: data/json/items/ammo.json
msgid ""
"Potassium superoxide powder, used as oxygen regenerating agent in "
"rebreathers.  Keep away from water."
msgstr ""

#. ~ Description of "lye powder"
#: data/json/items/ammo.json
msgid "Powdered caustic soda, also known as sodium hydroxide."
msgstr ""

#. ~ Description of "blue pen ink"
#: data/json/items/ammo.json
msgid ""
"Prussian blue, crystal violet, and phthalocyanine blue pigments infused with "
"polymers, stabilizers, and water to help the ink flow properly."
msgstr ""

#. ~ Item name
#: data/json/items/ammo.json
