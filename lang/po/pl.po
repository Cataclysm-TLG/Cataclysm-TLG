#: data/json/npcs/Backgrounds/fema_evacuee_1.json
msgid ""
"That's a tall order.  I guess the short version is that I got evacuated to a "
"FEMA camp for my so-called safety, but luckily I made it out."
msgstr ""
"Dużo byś chciał. Jak sądzę krótka wersja sprowadza do tego że ewakuowano "
"mnie do obozu FEMA, w niby bezpieczne miejsce, ale szczęśliwie się stamtąd "
"wyrwałem."

#. ~ Response to NPC dialogue
#: data/json/npcs/Backgrounds/fema_evacuee_1.json
msgid "What about all the other stuff?"
msgstr "A co z resztą tego wszystkiego?"

#. ~ Response to NPC dialogue
#: data/json/npcs/Backgrounds/fema_evacuee_1.json
msgid "What happened after that?"
msgstr "Co się wydarzyło potem?"

