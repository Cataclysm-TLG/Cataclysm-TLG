msgstr "taran z drewna"

#. ~ Vehicle part name
#: data/json/vehicleparts/rams.json
msgid "wooden spike"
msgstr "drewniany kolec"

#. ~ Description of vehicle part ""
#: data/json/vehicleparts/rotor.json
msgid ""
"A set of aerofoil helicopter rotors, when spun at high speed, they generate "
"thrust via lift."
msgstr ""
"Zestaw aerodynamicznych wirników helikoptera, które obracając się z dużą "
"prędkością wytwarzają siłę ciągu poprzez unoszenie."

#. ~ Description of vehicle part "heavy-duty military rotors"
#. ~ Description of vehicle part "small helicopter rotors"
#: data/json/vehicleparts/rotor.json
msgid ""
"A set of four military-grade helicopter rotor blades, used to provide lift "
"by rotation."
msgstr ""
"Zestaw czterech łopat wirnika śmigłowca klasy wojskowej, wykorzystywany do "
"zapewnienia unoszenia przez obrót."

#. ~ Description of vehicle part "heavy-duty military Osprey rotors"
#: data/json/vehicleparts/rotor.json
msgid ""
"A set of three military-grade helicopter rotor blades, used to provide lift "
"by rotation."
msgstr ""
"Zestaw trzech łopat wirnika śmigłowca klasy wojskowej, wykorzystywany do "
"zapewnienia unoszenia przez obrót."

#. ~ Vehicle part name
#: data/json/vehicleparts/rotor.json
msgid "heavy-duty military Blackhawk rotors"
msgstr "wysokowydajne wojskowe wirniki Blackhawk"

#. ~ Vehicle part name
#: data/json/vehicleparts/rotor.json
msgid "heavy-duty military Osprey rotors"
msgstr "wysokowydajne wojskowe wirniki Osprey"

#. ~ Vehicle part name
#: data/json/vehicleparts/rotor.json
msgid "small helicopter rotors"
msgstr "wirniki do małych śmigłowców"

