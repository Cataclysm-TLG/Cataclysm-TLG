#~ msgid "You gain the strength of an ogre."
#~ msgstr "Zyskujesz siłę ogra."

#~ msgid "You get pins and needles all over."
#~ msgstr "Czujesz mrowienie całego ciała."

#~ msgid "You get ready to battle."
#~ msgstr "Przygotowujesz się do walki"

#~ msgid ""
#~ "You get up feeling horrible, as if something was messing with your body."
#~ msgstr "Wstajesz czując się okropnie, jakby coś się działo z twoim ciałem."

#~ msgid "You get up with a bit of a scratch in your throat."
#~ msgstr "Budzisz się z lekkim drapaniem w gardle."

#~ msgid "You go limp and collapse as the sunesthesia knocks you senseless."
#~ msgstr ""
#~ "Czujesz odrętwienie i nagłe słabnięcie wszystkich zmysłów. Tracisz "
#~ "przytomność."

#~ msgid "You gonna give me orders?"
#~ msgstr "Zamierzasz wydać mi polecenia?"

#~ msgid "You got a bad feeling about this flaming eye's intentions."
#~ msgstr "Masz złe przeczucia co do zamiarów tego płonącego oka."

#~ msgid "You got my body yet?"
#~ msgstr "Masz już dla mnie ciało?"

