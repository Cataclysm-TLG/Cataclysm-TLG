#. ~ Description of "monomolecular blade"
#: data/json/items/melee/fake.json
msgid ""
"A foot-long blade made from high-tech alloy and edged with bonded "
"nanocrystals."
msgstr ""
"Trzydziestocentymetrowe ostrze z zaawansowanego technicznie polimeru o "
"ostrzu z przyklejonych nanokryształów."

#. ~ Item name
#: data/json/items/melee/fake.json
