msgstr "taran z ciężkiej stali"

#. ~ Vehicle part name
#: data/json/vehicleparts/rams.json
msgid "military composite ram"
msgstr "taran z wojskowego kompozytu"

#. ~ Vehicle part name
#: data/json/vehicleparts/rams.json
msgid "spiked ram"
msgstr "naszpikowany taran"

#. ~ Vehicle part name
#: data/json/vehicleparts/rams.json
msgid "steel ram"
msgstr "taran ze stali"

#. ~ Vehicle part name
#: data/json/vehicleparts/rams.json
