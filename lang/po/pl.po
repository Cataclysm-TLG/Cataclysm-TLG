#: data/json/items/comestibles/carnivore.json
msgid "animal blood"
msgid_plural "animal blood"
msgstr[0] "zwierzęca krew"
msgstr[1] "porcje zwierzęcej krwi"
msgstr[2] "porcji zwierzęcej krwi"
