msgstr "Proste metalowe koło."

#. ~ Description of "16" racing tire"
#: data/json/items/vehicle/wheel.json
msgid "A slick 16\" racing car tire for fitting to a medium steel rim."
msgstr ""
"Smukła opona wyścigowa 16″ do montażu na średniej wielkości feldze stalowej."

#. ~ Description of "wheelbarrow wheel"
#: data/json/items/vehicle/wheel.json
