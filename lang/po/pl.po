msgstr[0] "wielkokalibrowy karabin wyborowego"
msgstr[1] "wielkokalibrowe karabiny wyborowe"
msgstr[2] "wielkokalibrowych karabinów wyborowych"
msgstr[3] "wielkokalibrowego karabinu wyborowego"

