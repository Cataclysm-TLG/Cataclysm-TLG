msgctxt "u:n"
msgid "How are you here?  Are you one of them, somehow?  What's going on?"
msgstr "どうやってここへ？まさか、奴らの仲間なのか？どういうことだ？"

#. ~ NPC dialogue line
#: data/json/npcs/prisoners/mi-go_prisoners.json
msgid "I can't believe my eyes.  Thank you, thank you!"
msgstr "幻覚じゃないよな。ありがとう、ありがとう！"

#. ~ Response to NPC dialogue
#: data/json/npcs/prisoners/mi-go_prisoners.json
msgid "I've no use for weaklings.  Run.  Now."
msgstr "弱者は不要だ。さっさと逃げろ。"

#. ~ NPC dialogue line
#: data/json/npcs/prisoners/mi-go_prisoners.json
msgid ""
"My god, you've got to get me out of here.  The things… the things they've "
"done… please help."
msgstr "何てことだ、ここから出してくれ。奴ら...やりやがったな...助けてくれ。"

#. ~ NPC dialogue line
#: data/json/npcs/prisoners/mi-go_prisoners.json
msgid "Please, help me."
msgstr "お願いだ、助けて。"

#. ~ NPC dialogue line
#: data/json/npcs/prisoners/mi-go_prisoners.json
msgid "Who are you?  Are you real?"
msgstr "誰だ？幻覚じゃないのか？"

#. ~ NPC dialogue line
#: data/json/npcs/prisoners/mi-go_prisoners.json
msgid "You're… you're actually real!"
msgstr "君は...ちゃんと存在してるな！"

#. ~ Response to NPC dialogue
#: data/json/npcs/random_encounters/camper_van_traveler.json
msgid "Ah, that's nothing new to me.  Thanks anyway though."
msgstr "ああ、その話なら知ってるよ。でもありがとう。"

#. ~ Dialogue line in mission "Check out that cabin"
#. ~ Dialogue line in mission "Check out that desolate barn"
#. ~ Dialogue line in mission "Check out that collapsed house"
#: data/json/npcs/random_encounters/camper_van_traveler.json
msgid "Be careful.  Seems like a rough place to me."
msgstr "危険な場所だろうから、気を付けて行け。"

#. ~ Mission name
#: data/json/npcs/random_encounters/camper_van_traveler.json
msgid "Check out that collapsed house"
msgstr "朽ちかけた廃屋を調べる"

#. ~ Mission name
#: data/json/npcs/random_encounters/camper_van_traveler.json
msgid "Check out that desolate barn"
msgstr "荒れ果てた納屋を調べる"

#. ~ Response to NPC dialogue
#: data/json/npcs/random_encounters/camper_van_traveler.json
msgid "Do you have anything that you'd like to sell?"
msgstr "何か取り引きできる物資はある？"

#. ~ NPC dialogue line
#: data/json/npcs/random_encounters/camper_van_traveler.json
msgid "ERROR: DIRECTION PARAMETERS EITHER NOT PICKED OR OUT OF BOUNDS"
msgstr "エラー: 方向パラメータが選択されていないか範囲外です"

#. ~ NPC dialogue line
#: data/json/npcs/random_encounters/camper_van_traveler.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_visiting_scavenger.json
msgid "ERROR: out of bounds on randomize_directions."
msgstr "エラー: randomize_directionsの範囲外です。"

#. ~ Response to NPC dialogue
#: data/json/npcs/random_encounters/camper_van_traveler.json
msgid "Good to meet you too.  What are you doing out here?"
msgstr "こちらこそよろしく。ここで何をしているんだ？"

#. ~ Response to NPC dialogue
#: data/json/npcs/random_encounters/camper_van_traveler.json
msgid "Have you found anything out of the ordinary out in the wastes?"
msgstr "何か興味深いものには出くわしたか？"

#. ~ Response to NPC dialogue
#: data/json/npcs/random_encounters/camper_van_traveler.json
msgid "How do I get to that cabin?"
msgstr "その小屋へ行くにはどうしたらいい？"

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/Cataclysm-TLG/Cataclysm-
#. TLG/blob/master/doc/TRANSLATING.md#grammatical-gender
