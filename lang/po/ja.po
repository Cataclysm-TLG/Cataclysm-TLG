#: data/json/bionics.json
msgid "Blood Analysis"
msgstr "血液分析センサー"

#. ~ Name of a bionic
#: data/json/bionics.json
msgid "Blood Filter"
msgstr "血液ろ過システム"

#. ~ Name of a bionic
#: data/json/bionics.json
msgid "Cable Charger System"
msgstr "ケーブル充電システム"

