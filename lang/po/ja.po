msgstr "食材分類"

#. ~ Proficiency name
#: data/json/proficiencies/comestibles.json
msgid "Food Preservation"
msgstr "食品保存"

#. ~ Proficiency name
#: data/json/proficiencies/comestibles.json
msgid "Forager Cooking"
msgstr "野外料理"

#. ~ Proficiency name
#: data/json/proficiencies/comestibles.json
msgid "Fried Desserts"
msgstr "菓子フライ調理"

#. ~ Proficiency name
#: data/json/proficiencies/comestibles.json
msgid "Knife Skills"
msgstr "包丁技術"

#. ~ Proficiency name
#: data/json/proficiencies/comestibles.json
msgid "Lactofermentation"
msgstr "乳酸発酵"

#. ~ Proficiency name
#: data/json/proficiencies/comestibles.json
