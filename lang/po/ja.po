#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_chatting_veterans.json
msgid "[Join them in their heavy drinking.]"
msgstr "[盛大な酒宴の輪に加わる。]"

#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_chatting_veterans.json
msgid "[Join them with a story of your own.]"
msgstr "[声を掛け、自分の身の上を語る。]"

#. ~ Response to NPC dialogue
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_chatting_veterans.json
msgid "[Just move along.]"
msgstr "[放っておく。]"

