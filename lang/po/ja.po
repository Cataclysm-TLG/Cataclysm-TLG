#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Affirmative.\""
msgstr "「その通りだな」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"And that's supposed to comfort me?\""
msgstr "「で、それは私を満足させてくれるのかな？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"And what if all the backups fail?\""
msgstr "「予備もダメになったら？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Anything else?\""
msgstr "「他に何か？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you alone?\""
msgstr "「一人ですか？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you busy at the moment?\""
msgstr "「今忙しい？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you busy later?\""
msgstr "「このあと暇？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you busy tonight?\""
msgstr "「今夜ひま？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you feeling all right?\""
msgstr "「具合は大丈夫かい？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you free tonight?\""
msgstr "「今夜空いてる？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you going to help them?\""
msgstr "「あの人たちを助けようとしてるの？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you going to the party tonight?\""
msgstr "「今夜パーティーしない？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you hungry?\""
msgstr "「お腹が空いたのか？」"

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor,
#. mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Are you my mommy?\""
msgstr "「お母さん？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you seeing anyone?\""
msgstr "「君...付き合ってる人はいるか？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Are you sure?\""
msgstr "「本当ですか？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Area nineteen has a few in cold storage.\""
msgstr "「エリア19には、複数の冷蔵倉庫がある」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"At least we know they can die.\""
msgstr "「少なくともあいつらは殺すことができる」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Be careful out there.\""
msgstr "「あたりに注意して」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Be quiet.\""
msgstr "「静かにしろ」"

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Big Brother is watching you…\""
msgstr "「ビッグ・ブラザーがあなたを見守っている...」"

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor,
#. mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Blood… delicious.\""
msgstr "「血...おいしいね」"

#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go,
#. mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Burning… from the inside…\""
msgstr "「燃えている...体の中から...」"

