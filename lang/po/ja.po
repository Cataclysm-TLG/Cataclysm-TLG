msgid "bulk tank"
msgstr "バルクタンク"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "cloning vat"
msgstr "培養槽"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "conveyor belt"
msgstr "ベルトコンベア"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "covered salt water well"
msgstr "閉鎖塩水井戸"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "covered well"
msgstr "閉鎖井戸"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-manufactured.json
msgid "current transformer"
