#: data/json/items/book/chemistry.json
msgid "lab journal-Dionne"
msgid_plural "lab journals-Dionne"
msgstr[0] "本(学習/研究日誌(ディオンヌ))"

#. ~ Item name
#: data/json/items/book/chemistry.json
msgid "lab journal-Smythe"
msgid_plural "lab journals-Smythe"
msgstr[0] "本(学習/研究日誌(スマイス))"

