#: data/json/snippets/npc_story.json
msgid "the zombie men, and the zombie women and children too"
msgstr "男のゾンビと女のゾンビと子供のゾンビ"

#. ~ Snippet in category "<merc_story_subject>"
#: data/json/snippets/npc_story.json
msgid "their own damn shadow"
msgstr "自分自身の恐ろしい影"

#. ~ Snippet in category "<merc_story_subject>"
#: data/json/snippets/npc_story.json
msgid "their own dark nature"
msgstr "自分自身の闇"

#. ~ Snippet in category "<merc_story_subject>"
#: data/json/snippets/npc_story.json
msgid "weird dogs"
msgstr "奇妙な犬"

#. ~ Snippet in category "<merc_story_context>"
#: data/json/snippets/npc_story.json
msgid "while a portal storm raged outside"
msgstr "外でポータルの嵐が吹き荒れる中起きた、"

#. ~ Snippet in category "<merc_story_context>"
#: data/json/snippets/npc_story.json
msgid "while all hell broke loose"
msgstr "この世の地獄のような場所で起きた、"

#. ~ Snippet in category "<merc_story_context>"
#: data/json/snippets/npc_story.json
msgid "while chilling like it was Tuesday"
msgstr "普通の火曜日って感じのくつろいだ日に起きた、"

#. ~ Snippet in category "<merc_story_context>"
#: data/json/snippets/npc_story.json
msgid "while dead drunk"
msgstr "泥酔していた時に起きた、"

#. ~ Snippet in category "<merc_story_context>"
#: data/json/snippets/npc_story.json
