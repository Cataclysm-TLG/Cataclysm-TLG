#. ~ Mission name
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_jabberwock.json
msgid "\"God\"-Slayer"
msgstr "「神」殺し"

#. ~ NPC dialogue line
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_jabberwock.json
msgid ""
"&<mypronoun> seems completely lost to the present, but you can't help but "
"notice <mypossesivepronoun> gear is caked with mud and broken twigs.  It "
"doesn't look like you'll be getting much conversation from this one."
msgstr ""
"&<mypronoun>は心ここにあらずといった様子です。<mypossesivepronoun>着ている装備は泥まみれで、あちこちに小枝が挟まっているのが嫌でも目につきます。とても会話が弾みそうな状態ではありません。"

#. ~ NPC dialogue line
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_jabberwock.json
msgid "&<mypronoun> silently points at your maps with a trembling hand."
msgstr "&<mypronoun>は震える手で、マップの一点を指さしました。"

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/Cataclysm-TLG/Cataclysm-
