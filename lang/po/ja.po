msgid "Not at the moment, check back later perhaps."
msgstr "今の所は何もないな、また今度寄ってくれ。"

#. ~ Response to NPC dialogue
#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
msgid "Sure…"
msgstr "そうか..."

#. ~ Response to NPC dialogue
#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
#: data/json/npcs/campus/NPC_campus_guard_generic.json
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
