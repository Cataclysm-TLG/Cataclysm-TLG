#. ~ Memorial message of mutation class "Chimera" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "United disunity."
msgstr "合一化しました。"

#. ~ Memorial message of mutation class "Chimera" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "United disunity."
msgstr "合一化しました。"

#. ~ "mutagen_message" of mutation class "Lagomorph"
#: data/json/mutations/mutation_category.json
msgid "Walking is overrated.  It's time to start hopping."
msgstr "歩行は過大評価されています。そろそろホッピングの出番ですね。"

#. ~ Memorial message of mutation class "Piscine" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Went deep."
msgstr "深淵に到達しました。"

#. ~ Memorial message of mutation class "Piscine" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Went deep."
msgstr "深淵に到達しました。"

#. ~ Memorial message of mutation class "Canine" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Wolfed out."
msgstr "本能に身を任せました。"

#. ~ Memorial message of mutation class "Canine" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Wolfed out."
msgstr "本能に身を任せました。"

#. ~ "mutagen_message" of mutation class "Piscine"
#: data/json/mutations/mutation_category.json
msgid "You are overcome by an overwhelming longing for the ocean."
msgstr "海が恋しくて、恋しくて、たまりません。"

#. ~ "mutagen_message" of mutation class "Medical"
#: data/json/mutations/mutation_category.json
msgid ""
"You can feel the blood rushing through your veins and a strange, medicated "
"feeling washes over your senses."
msgstr "静脈を駆け抜ける血液と、その中に混じる奇妙な薬物の感触を味わいました。"

#. ~ "mutagen_message" of mutation class "Murine"
#: data/json/mutations/mutation_category.json
msgid "You feel a desire to curl up in a nice, warm pile of… shredded paper."
msgstr "細かく破った紙の山の中で丸くなりたい欲求に駆られました。"

#. ~ "mutagen_message" of mutation class "Rattine"
#: data/json/mutations/mutation_category.json
msgid "You feel a momentary nausea."
msgstr "一時的に吐き気を催しました。"

#. ~ "mutagen_message" of mutation class "Canine"
#: data/json/mutations/mutation_category.json
msgid "You feel an urge to mark your territory.  But then it passes."
msgstr "自分の縄張りをマーキングしたい衝動に駆られました。が、治まりました。"

#. ~ "mutagen_message" of mutation class "Ursine"
#: data/json/mutations/mutation_category.json
msgid "You feel an urge to… patrol?  The forests?"
msgstr "衝動を感じました...森を...パトロールしなければ！"

#. ~ "mutagen_message" of mutation class "Aranean"
#: data/json/mutations/mutation_category.json
msgid "You feel insidious, and your vision fragments for a moment."
msgstr "狡猾な思考が頭に浮かび、視界が一瞬乱れました。"

#. ~ "mutagen_message" of mutation class "Plant"
#: data/json/mutations/mutation_category.json
msgid "You feel much closer to nature.  Your breath and thoughts slow."
msgstr "自然をより身近に感じます。呼吸も思考も鈍化しています。"

#. ~ "mutagen_message" of mutation class "Any"
#: data/json/mutations/mutation_category.json
msgid "You feel strange."
msgstr "奇妙な感覚に襲われました。"

#. ~ "mutagen_message" of mutation class "Human"
#: data/json/mutations/mutation_category.json
msgid "You feel the aberrance fade."
msgstr "肉体の異常が薄れていくのを感じます。"

#. ~ "mutagen_message" of mutation class "Alpha"
#: data/json/mutations/mutation_category.json
msgid "You feel… better.  Somehow."
msgstr "何故だか...とても良い気分です。"

#. ~ "mutagen_message" of mutation class "Insect"
#: data/json/mutations/mutation_category.json
msgid "You hear buzzing, and feel your body harden."
msgstr "騒音が聞こえると同時に身体に緊張が走りました。"

#. ~ "mutagen_message" of mutation class "Chimera"
#: data/json/mutations/mutation_category.json
msgid "You need to roar, bask, bite, and flap.  NOW."
msgstr "ああ、吠えて、日なたぼっこして、咬み付いて、ひっぱたきたい、今すぐに！"

#. ~ "mutagen_message" of mutation class "Crustacean"
#: data/json/mutations/mutation_category.json
msgid ""
"You suddenly want to burrow under some sand or find some nice rocky alcove "
"to hide behind."
msgstr "ふと、砂に埋もれたり、岩の隙間に隠れたりしたくなりました。"

#. ~ "mutagen_message" of mutation class "Troglobite"
#: data/json/mutations/mutation_category.json
msgid "You yearn for a cool, dark place to hide."
msgstr "涼しくて暗い、隠れられる場所を渇望しています。"

#. ~ "mutagen_message" of mutation class "Theropod"
#: data/json/mutations/mutation_category.json
msgid "You're struck by a primordial flashback… and then it passes."
msgstr "一瞬、頭の中に古代の光景が浮かび...そして、消えました。"

#. ~ "mutagen_message" of mutation class "Feline"
#: data/json/mutations/mutation_category.json
msgid "Your back arches and the hair stands up on the back of your neck."
msgstr "背骨が曲がり、首の後ろの毛が逆立ちました。"

#. ~ "mutagen_message" of mutation class "Avian"
#: data/json/mutations/mutation_category.json
msgid "Your body lightens and you long for the sky."
msgstr "体が軽くなり、空を飛びたくなりました。"

#. ~ "mutagen_message" of mutation class "Slime"
#: data/json/mutations/mutation_category.json
msgid "Your body loses all rigidity for a moment."
msgstr "一瞬、体が硬度を失って完全な液体になりました。"

#. ~ "mutagen_message" of mutation class "Chiropteran"
#: data/json/mutations/mutation_category.json
msgid "Your ears ring and you taste iron."
msgstr "耳鳴りが聞こえ、口の中で鉄の味がします。"

#. ~ "mutagen_message" of mutation class "Beast"
#: data/json/mutations/mutation_category.json
msgid "Your heart races and you see blood for a moment."
msgstr "鼓動が速まり、一瞬、視界が血の色に染まりました。"

