#: src/player_hardcoded_effects.cpp:215
msgid "You feel nauseous."
msgstr "吐き気を催しています。"

#: src/player_hardcoded_effects.cpp:219
msgid ""
"The back of your throat is filled with a musty smell that you can almost "
"taste."
msgstr ""

#: src/player_hardcoded_effects.cpp:225
msgid "You spasm suddenly!"
msgstr "急に身体が痙攣を起こしました！"

#: src/player_hardcoded_effects.cpp:230
msgid "You vomit a thick, gray goop."
msgstr "嘔吐しました、おえっ。"

#: src/player_hardcoded_effects.cpp:231
