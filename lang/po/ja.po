msgstr[0] "節足変異体"

#. ~ Monster name
#: data/json/monsters/mutant.json
msgid "bestial mutant"
msgid_plural "bestial mutants"
msgstr[0] "獣化変異体"

#. ~ Monster name
#: data/json/monsters/mutant.json
msgid "camouflaged mutant"
