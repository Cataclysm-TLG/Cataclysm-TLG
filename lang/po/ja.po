msgid_plural "stone axe heads"
msgstr[0] "斧頭(石)"

#. ~ Item name
#: data/json/items/melee/axes.json
msgid "street sign"
msgid_plural "street signs"
msgstr[0] "街灯"

#. ~ Item name
