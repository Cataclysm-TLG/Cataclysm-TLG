#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard,
#. mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Dad-a-chuk?\""
msgstr "「ダド・ア・チュック？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Damn it!\""
msgstr "「しまった！」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Damn it.\""
msgstr "「しまった」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Destroy the specimen if it begins to interact with the lock.\""
msgstr "「施錠部分に接触しようとした場合、速やかに処分すること」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi-go_surgeon
#: data/json/speech.json
msgid "\"Did you see what they did to him?\""
msgstr "「奴らが彼にした事を見ただろ？」"

#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard,
#. mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Did-a-chak?\""
msgstr "「ディド・ア・チャック？」"

#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard,
#. mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Did-a-chuk?\""
msgstr "「ディド・ア・チュック？」"

#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard,
#. mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Did-a-chum?\""
msgstr "「ディド・ア・チャム？」"

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor,
#. mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Die for me!\""
msgstr "「死んでよ！」"

#. ~ Speech from speaker mon_civilian_zombiefighter
#: data/json/speech.json
msgid "\"Die!\""
msgstr "「死ね！」"

#. ~ Speech from speaker mon_civilian_zombiefighter
#: data/json/speech.json
msgid "\"Die, zombie scum!\""
msgstr "「死ね、糞ゾンビ！」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Do not reach for your pockets!\""
msgstr "「ポケットに手を近づけるな！」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_surgeon
#: data/json/speech.json
msgid "\"Do they even have sex?\""
msgstr "「そもそも性別があるの？」"

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Do you really need that much honey?\""
msgstr "「ハチミツ入れすぎじゃない？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Do you smoke?\""
msgstr "「タバコは吸うかい？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Do you understand what I'm saying?\""
msgstr "「私の言っていることが分かりますか？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Does it scare you?\""
msgstr "「怖がってる？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Don't do that.\""
msgstr "「やめてよ」"

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Don't look at the sky!\""
msgstr "「空を見るな！」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Don't worry about it.\""
msgstr "「それについては心配要りませんよ」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Don't worry, it can't hurt us.\""
msgstr "「大丈夫、私たちに危害は与えないよ」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid ""
"\"Don't worry, it isn't like anything could teleport out of the containment "
"cells.\""
msgstr "「心配する必要はありません。こいつは、格納容器からテレポートで脱出するような代物ではありませんよ」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Don't worry.\""
msgstr "「大丈夫です」"

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Down here, they ALL float!\""
msgstr "「おりてきなよ、みんなこっちに浮かんでるよ！」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"EMERGENCY, EMERGENCY!\""
msgstr "「緊急事態発生、緊急事態発生！」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Every man has got a breaking point.\""
msgstr "「だれにだって限界がある」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Excellent.\""
msgstr "「素晴らしいな」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Excuse me.\""
msgstr "「ちょっとすみません」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Experiments to determine extent of cognitive abilities still underway.\""
msgstr "「認知能力の程度を調べる実験が進行中です」"

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor,
#. mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"FUCK YOU!\""
msgstr "「ファッキュー！」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Fantastic.\""
msgstr "「最高だ」"

#. ~ Speech from speaker mon_feral_sapien_spear
#: data/json/speech.json
msgid "\"Food!\""
msgstr "「クイモノ！」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Forget it.\""
msgstr "「気にしないでくれ」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"From time to time.\""
msgstr "「時々な」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Fuck!\""
msgstr "「くそったれが！」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Fuck.\""
msgstr "「くそっ」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Fuckin' piece of garbage.\""
msgstr "「くそったれ、このゴミ屑が」"

#. ~ Speech from speaker mon_feral_cop, mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"GET ON THE GROUND, NOW!\""
msgstr "「今すぐ地面に伏せろ！」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"GET WELL SOON!\""
msgstr "「早くよくなってね！」"

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Get it OFF ME!\""
msgstr "「追い払え！」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Get me the White House.\""
msgstr "「ホワイトハウスに連れて行ってくれ」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Get on the ground!  Now!\""
msgstr "「地面に伏せなさい！今すぐに！」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Get on your knees!\""
msgstr "「跪け！」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Give me a call later.\""
