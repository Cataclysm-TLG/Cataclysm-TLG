#: src/player_hardcoded_effects.cpp:355
msgctxt "bleed_message"
msgid "Blood"
msgstr "血液"

#: src/player_hardcoded_effects.cpp:359
#, c-format
msgid "%1s drips from your %2s."
msgstr "%1sが%2sから滴りました。"

#: src/player_hardcoded_effects.cpp:360
#, c-format
msgid "%1s leaks from your %2s."
msgstr "%1sが%2sから漏れました。"

#: src/player_hardcoded_effects.cpp:361
#, c-format
