msgid "Who are you?"
msgstr "あなたは誰だ？"

#. ~ NPC dialogue line
#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "Yes, friend?"
msgstr "友よ、どうしました？"

#. ~ Response to NPC dialogue
#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "Yes… yes I have."
msgstr "ああ...そうだった。"

#. ~ NPC dialogue line
#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "Your travels be fruitful, friend."
msgstr "友よ、あなたの旅は実りあるものになりますよ。"

#. ~ Response to NPC dialogue
#: data/json/npcs/TALK_MARLOSS_VOICE.json
msgid "[Take Marloss berry.] Thank you."
msgstr "[マーロスベリーを受け取る] ありがとう。"

#. ~ Response to NPC dialogue
#: data/json/npcs/TALK_NC_FARMER.json
msgid "A daring trader?  Yes.  Let's trade items."
msgstr "斬新な商人だな？よし。物資の取り引きをしよう。"

#. ~ Response to NPC dialogue
#: data/json/npcs/TALK_NC_FARMER.json
msgid "Are you all right?"
msgstr "あなたは大丈夫なのか？"

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/Cataclysm-TLG/Cataclysm-
#. TLG/blob/master/doc/TRANSLATING.md#grammatical-gender
#: data/json/npcs/TALK_NC_FARMER.json
msgctxt "u:f"
msgid "Are you one of them?"
msgstr "あんたは奴らの仲間なのか？"

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/Cataclysm-TLG/Cataclysm-
#. TLG/blob/master/doc/TRANSLATING.md#grammatical-gender
