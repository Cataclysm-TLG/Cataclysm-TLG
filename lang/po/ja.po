#. mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"C-can't…\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Call an ambulance.\""
msgstr "「救急車を呼んでくれ」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Call me.\""
msgstr "「電話してね」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Call the police.\""
msgstr "「警察を呼んでくれ」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Can I help you?\""
msgstr "「何か手伝えることは？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Can I see your phone?\""
msgstr "「ちょっと携帯電話見せて？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can you help me?\""
msgstr "「手伝ってくれるかな？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can you repeat that?\""
msgstr "「もう一度言ってくれる？」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can you swim?\""
msgstr "「君は泳げるかい？」"

#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_abductor
#: data/json/speech.json
msgid "\"Can't… breathe…\""
msgstr "「息が...できな...」"

#. ~ Speech from speaker mon_civilian_zombiefighter
#: data/json/speech.json
msgid "\"Come get some!\""
msgstr "「こっちだ！」"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Come here!\""
msgstr "「来てくれ！」"

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Come on, come on, they can help us!\""
msgstr "「ねえ、ほら、きっと助けてもらえる！」"

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Come on, wake up…\""
msgstr "「さあ、起きて」"

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Cover your head, everyone!\""
msgstr "「みんな伏せて！」"

#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard,
#. mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Dad-a-chak?\""
msgstr "「ダド・ア・チャック？」"

#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard,
#. mon_mi_go_myrmidon
#: data/json/speech.json
