#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "bathtub"
msgstr "浴槽"

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-plumbing.json
msgid "family–sized water heater"
msgstr "家庭用給湯器"

