#. ~ Description of vehicle part "refrigerated tank (100 L)"
#: data/json/vehicleparts/tanks.json
msgid ""
"A 100 L refrigerated tank.  When turned on, it will cool the liquid inside, "
"extending the time until the food spoils."
msgstr ""

#. ~ Description of vehicle part "heated tank (60 L)"
#: data/json/vehicleparts/tanks.json
msgid ""
"A 60 L heated tank.  When turned on, it will prevent the contents from "
"freezing."
msgstr ""

#. ~ Description of vehicle part "refrigerated tank (60 L)"
#: data/json/vehicleparts/tanks.json
msgid ""
"A 60 L refrigerated tank.  When turned on, it will cool the liquid inside, "
"extending the time until the food spoils."
msgstr ""

