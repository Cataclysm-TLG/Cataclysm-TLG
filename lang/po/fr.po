msgid ""
"MY PC.\n"
" You are logged in as: ADMINISTRATOR.\n"
"\n"
"  WARNING!  ERROR IN POWER SUPPLY DETECTED.  RESERVE POWER ACTIVATED.  SAVE "
"ALL WORK AND SAFELY SHUT DOWN THIS DEVICE IMMEDIATELY!"
msgstr ""
