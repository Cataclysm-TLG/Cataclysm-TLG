#. ~ Response to NPC dialogue
#: data/json/npcs/Backgrounds/prepper_1.json
msgid "I had no idea.  It's <the_cataclysm>.  I was just trying to survive."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/Backgrounds/prepper_1.json
