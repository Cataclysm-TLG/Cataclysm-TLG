#. ~ Description of "mp3 player (on)"
#: data/json/items/tool/electronics.json
msgid ""
"Small enough to fit in your pocket, this device includes a pair of earbuds "
"that allow you to listen to music without anyone else hearing."
msgstr ""

#. ~ "need_charges_msg" action message of item "cellphone"
#: data/json/items/tool/electronics.json
msgid "The cellphone's batteries need more charge."
msgstr "La batterie du téléphone a besoin de plus de charge."

