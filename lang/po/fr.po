#. ~ Apply message of effect type "glowy_led"
#: data/json/effects.json
msgid "A bionic LED is glowing softly beneath your skin."
msgstr "Une LED bionique brille doucement en dessous de votre peau."

#. ~ Apply message of effect type "Disabled"
#: data/json/effects.json
msgid "A body part has been critically injured!"
msgstr ""

#. ~ Apply message of effect type "Mild Opioid Withdrawal, Moderate Opioid Withdrawal, Severe Opioid Withdrawal"
#: data/json/effects.json
msgid "A chill runs through your body."
msgstr ""

#. ~ Apply message of effect type "Mild Smoke Inhalation, Smoke Inhalation, Major Smoke Inhalation, Severe Smoke Inhalation"
#: data/json/effects.json
msgid "A dense cloud of smoke enters your lungs."
msgstr "Un nuage de fumée épaisse s'infiltre dans vos poumons."

#. ~ Apply message of effect type "Distracting Wound, Painful Wound, Searing Wound"
#: data/json/effects.json
msgid "A dull pain starts spreading from the wound!"
msgstr "Une douleur sourde ce repends de la blessure!"

#. ~ Description of effect type "Early Iron Deficiency"
#: data/json/effects.json
msgid ""
"A lack of iron in your diet has hampered the efficiency and regeneration of "
"your red blood cells."
msgstr ""
"Une carence de fer commence à compromettre l'équilibre entre le "
"renouvellement et la sénescence de vos cellules rouges."

#. ~ Description of effect type "Early Scurvy, Scurvy, Bad Scurvy"
#: data/json/effects.json
msgid ""
"A lack of vitamin C in your diet will result in progressively worse symptoms "
"of scurvy."
msgstr ""
"Un manque de vitamine C dans votre alimentation va aggraver les symptômes du "
"scorbut progressivement."

#. ~ Description of effect type "Laser-targeted"
#: data/json/effects.json
msgid "A laser sight is targeting you!"
msgstr "Une visée laser vous cible!"

#. ~ Description of effect type "Skunk Spray Neutralized"
#: data/json/effects.json
msgid "A solution that neutralizes skunk odors."
msgstr ""

#. ~ Description of effect type "Counting Down"
#: data/json/effects.json
msgid "AI tag for monster's counting down.  This is a bug if you have it."
msgstr ""

#. ~ Description of effect type "Dragging"
#: data/json/effects.json
msgid ""
"AI tag for when a monster is dragging you behind it.  This is a bug if you "
"have it."
msgstr ""
"Balise d'IA pour les monstres qui vous traînent derrière eux. C'est un bug "
"si vous l'avez."

#. ~ Description of effect type "Operating"
#: data/json/effects.json
msgid ""
"AI tag for when a monster is operating on you.  This is a bug if you have it."
msgstr ""
"Balise d'IA lorsque qu'un monstre vous exploite. C'est un bug si vous l'avez."

#. ~ Description of effect type "Well Fed"
#: data/json/effects.json
msgid ""
"AI tag for when critter has had enough to eat.  This is a bug if you have it."
msgstr ""
"Étiquette d'IA indiquant qu'un animal a eu assez à manger. C'est un bug si "
"vous l'avez."

#. ~ Description of effect type "Underfed"
#: data/json/effects.json
msgid ""
"AI tag for when critter has not had enough to eat.  This is a bug if you "
"have it."
msgstr ""
"Tag IA pour les créatures qui n'ont pas eu assez à manger. Il s'agit d'un "
"bug si vous l'avez."

#. ~ Description of effect type "Harnessed"
#: data/json/effects.json
msgid ""
"AI tag for when critter is being harnessed by a vehicle.  This is a bug if "
"you have it."
msgstr ""
"Tag d'IA pour les créatures attelées à un véhicule. C'est un bug si vous "
"l'avez."

#. ~ Description of effect type "Ridden"
#: data/json/effects.json
msgid "AI tag for when critter is being ridden.  This is a bug if you have it."
msgstr ""
"Tag d'IA pour savoir si l'animal est monté. C'est un bug si vous l'avez."

#. ~ Description of effect type "Hit-and-run Running"
#: data/json/effects.json
msgid ""
"AI tag for when hit-and-run monsters run away.  This is a bug if you have it."
msgstr ""
"Balise d'IA pour les monstres qui s'enfuient en courant. C'est un bug si "
"vous l'avez."

#. ~ Description of effect type "Controlled Monster"
#: data/json/effects.json
msgid ""
"AI tag for when monsters are being controlled by another.  This is a bug if "
"you have it."
msgstr ""
"Tag d'IA pour les monstres contrôlés par un autre. C'est un bug si vous "
"l'avez."

#. ~ Description of effect type "Hit By Player"
#: data/json/effects.json
msgid ""
"AI tag for when monsters are hit by player.  This is a bug if you have it."
msgstr ""
"Tag d'IA pour les monstres qui sont touchés par le joueur. C'est un bug si "
"vous l'avez."

#. ~ Description of effect type "Docile Monster"
#: data/json/effects.json
msgid "AI tag for when monsters are tamed.  This is a bug if you have it."
msgstr "Tag d'IA pour les monstres apprivoisés. C'est un bug si vous l'avez."

#. ~ Description of effect type "Cornered Fighter Recently Spooked"
#: data/json/effects.json
msgid ""
"AI tag to allow CORNERED_FIGHTER monsters to turn and fight.  This is a bug "
"if you have it."
msgstr ""
"Étiquette d'IA pour permettre aux monstres CORNERED_FIGHTER de retourner "
"combattre. C'est un bug si vous l'avez."

#. ~ Description of effect type "Cornered Fighter Spooked"
#: data/json/effects.json
msgid ""
"AI tag to let CORNERED_FIGHTER monsters try to flee.  This is a bug if you "
"have it."
msgstr ""
"Étiquette d'IA pour laisser les monstres CORNERED_FIGHTER essayer de "
"s'enfuir. C'est un bug si vous l'avez."

#. ~ Description of effect type "Being Led by Leash"
#: data/json/effects.json
msgid ""
"AI tag used for critters forced to follow using a leash.  This is a bug if "
"you have it."
msgstr ""
"Un tag d'IA utilisé pour marquer une créature portant une laisse étant "
"forcée de vous suivre. C'est un bug si vous l'avez."

#. ~ Description of effect type "Has Bag"
#: data/json/effects.json
msgid ""
"AI tag used for critters holding your bags.  This is a bug if you have it."
msgstr ""
"Un tag d'IA utilisé pour marquer une créature portant vos sacs. C'est un bug "
"si vous l'avez."

#. ~ Description of effect type "Has Leash"
#: data/json/effects.json
msgid ""
"AI tag used for critters wearing a leash.  This is a bug if you have it."
msgstr ""
"Un tag d'IA utilisé pour marquer une créature portant une laisse. C'est un "
"bug si vous l'avez."

#. ~ Description of effect type "Has Saddle"
#: data/json/effects.json
msgid ""
"AI tag used for critters wearing a saddle.  This is a bug if you have it."
msgstr ""
"Un tag d'IA utilisé pour marquer une créature portant une selle. C'est un "
"bug si vous l'avez."

#. ~ Description of effect type "Has Armor"
#: data/json/effects.json
msgid "AI tag used for critters wearing armor.  This is a bug if you have it."
msgstr ""
"Un tag d'IA utilisé pour marquer une créature portant de l'armure. C'est un "
"bug si vous l'avez."

#. ~ Description of effect type "Pushed"
#: data/json/effects.json
msgid ""
"AI tag used for monsters pushing each other.  This is a bug if you have it."
msgstr ""
"Un tag d'IA utilisé pour marquer des monstres se poussant les uns les "
"autres. C'est un bug si vous l'avez."

#. ~ Description of effect type "Heard Sound"
#: data/json/effects.json
msgid ""
"AI tag used for monsters responding to sound.  This is a bug if you have it."
msgstr ""

#. ~ Description of effect type "Pacified"
#: data/json/effects.json
msgid "AI tag used for pacified critters.  This is a bug if you have it."
msgstr ""
"Un tag d'IA utilisé pour marquer une créature que vous avez pacifiée. C'est "
"un bug si vous l'avez."

#. ~ Description of effect type "Paid"
#: data/json/effects.json
msgid "AI tag used for paid critters.  This is a bug if you have it."
msgstr ""
"Un tag d'IA utilisé pour marquer un PNJ que vous avez payé(e). C'est un bug "
"si vous l'avez."

#. ~ Description of effect type "Pet"
#: data/json/effects.json
msgid "AI tag used for pet critters.  This is a bug if you have it."
msgstr ""
"Un tag d'IA utilisé pour marquer un animal de compagnie. C'est un bug si "
"vous l'avez."

#. ~ Description of effect type "Mechanical Fluid Dripping"
#: data/json/effects.json
msgid ""
"AI tag used for robot monsters losing mechanical fluid.  This is a bug if "
"you have it."
msgstr ""
"Un tag d'IA utilisé pour les monstres robotiques ayant une fuite de fluide "
"mécanique. C'est un bug si vous l'avez."

#. ~ Description of effect type "Worked On"
#: data/json/effects.json
msgid "AI tag used for robots being disabled.  This is a bug if you have it."
msgstr ""
"Un tag d'IA utilisé pour marquer un robot étant désactivé. C'est un bug si "
"vous l'avez."

#. ~ Description of effect type "Shrieking"
#: data/json/effects.json
msgid "AI tag used for screecher sounds.  This is a bug if you have it."
msgstr "Un tag d'IA pour les monstres hurleurs. C'est un bug si vous l'avez."

#. ~ Description of effect type "Infection"
#: data/json/effects.json
msgid "AI tag used for the infected NPC quest.  This is a bug if you have it."
msgstr ""
"Un tag d'IA utilisé dans la quête du PNJ infecté. C'est un bug si vous "
"l'avez."

#. ~ Description of effect type "Tied Up"
#: data/json/effects.json
msgid "AI tag used for tied up critters.  This is a bug if you have it."
msgstr ""
"Un tag d'IA utilisé pour marquer une créature ayant été attachée. C'est un "
"bug si vous l'avez."

#. ~ Description of effect type "Turret Is Targeted"
#: data/json/effects.json
msgid "AI tag used for turret targeting sounds.  This is a bug if you have it."
msgstr ""
"Un tag d'IA utilisé pour déclencher les bruits de ciblage de tourelle. C'est "
"un bug si vous l'avez."

#. ~ Description of effect type "No Ammo"
#: data/json/effects.json
msgid ""
"AI tag used to stop a monster reviving with ammo.  This is a bug if you have "
"it."
msgstr ""
"Un tag d'IA utilisé pour empêcher un monstre de ressusciter avec des "
"munitions. C'est un bug si vous l'avez."

