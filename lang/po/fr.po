msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/hub01/NPC_Cranberry_Foster.json
msgid "Good to have some company."
msgstr "Ça fait du bien d'avoir de la compagnie."

#. ~ NPC dialogue line
#: data/json/npcs/hub01/NPC_Cranberry_Foster.json
msgid "Got some gold for me?"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/hub01/NPC_Cranberry_Foster.json
msgid "Have something to say?"
msgstr "Vous avez quelque chose à dire?"

