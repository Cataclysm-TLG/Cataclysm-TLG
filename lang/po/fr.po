msgstr ""
"Vous mettez en place l'entonnoir, il est prêt à collecter l'eau de pluie."

#. ~ "done_message" action message of item "leather funnel"
#: data/json/items/tool/raincatchers.json
msgid "You place the leather funnel, waiting to collect rain."
