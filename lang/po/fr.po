#: data/json/npcs/tacoma_ranch/NPC_ranch_scavenger.json
msgid ""
"Lightweight gear that can easily be repaired is in high demand.  Could you "
"make us some suits of leather armor?  The life expectancy of my scavengers "
"would drastically increase if you did."
msgstr ""

#. ~ Mission name
#: data/json/npcs/tacoma_ranch/NPC_ranch_scavenger.json
msgid "Make 12 Molotov Cocktails"
msgstr "Fabriquez 12 Cocktails Molotov"

#. ~ Mission name
