#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ETHEREAL"
#: data/json/flags/flags.json
msgid ""
"You feel like you would keep all your items if you somehow became "
"incorporeal."
msgstr ""

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "TREE_COMMUNION_PLUS"
#: data/json/flags/flags.json
msgid ""
"You gain greatly enhanced effects from the Mycorrhizal Communion mutation"
msgstr ""

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "HIDDEN"
#: data/json/flags/flags.json
msgid "You have marked this article to not display a sprite when worn."
msgstr ""

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "SNOWWALKING"
#: data/json/flags/flags.json
msgid "Your movement is not slowed regardless of snow depth."
msgstr ""

#. ~ This is custom prefix added to item name. "REPLICA_EQUIPMENT"
#: data/json/flags/flags.json
msgid "replica "
msgstr ""

#. ~ Description of terrain "spatial compressor"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid ""
"A dizzyingly complex series of devices and readouts is on the outside of "
"this machine's casing.  You imagine the inside would be incomprehensible."
msgstr ""

#. ~ Description of terrain "precision laser emitter"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid ""
"A huge casing for a device that generates and focuses a laser of an "
"incredibly precise wavelength."
msgstr ""

#. ~ Description of terrain "laser chamber"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid ""
"A large section of metal tubing, balanced on spring supports to prevent any "
"vibration from affecting the laser inside."
msgstr ""

#. ~ Description of terrain "card reader"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid "A smartcard reader.  It bears the letters LIXA in proud silver."
msgstr ""

#. ~ Description of terrain "card reader"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid ""
"A smartcard reader.  It is a forbidding black, with no symbols of any sort "
"to identify it."
msgstr ""

#. ~ Description of terrain "rewired card reader"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid "A smartcard reader.  The casing is damaged, and repaired with tape."
msgstr ""

#. ~ Description of terrain "PPE lockup card reader"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid "A smartcard reader.  The label above it reads 'SECURE PPE LOCKER'."
msgstr ""

#. ~ Description of furniture "whiteboard"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid ""
"A wide space of whiteboard, for writing on with washable markers.  No one "
"has washed it in a long time, though; it is covered in dense scrawls of "
"equations and waveform diagrams."
msgstr ""

#. ~ Description of terrain "industrial green carpet"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid ""
"Firm, low-pile, high-durability carpet in a green color, for laying down on "
"bare concrete, with a still-functioning light attached to the ceiling above."
msgstr ""

#. ~ Description of furniture "wall of flat space"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid ""
"From a distance, this looks like where the chamber ends; a flat wall, with a "
"very detailed painting of a tunnel behind it.  But as you get closer, you "
"can see how it ripples, like lazy water, and notice angles of the space "
"beyond that a flat image could never give."
msgstr ""

#. ~ Description of terrain "leaking laser chamber"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid ""
"Gobbets of congealed light drip from the gash in the side of this chamber "
"like hot marmalade."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid "PPE lockup card reader"
msgstr ""

#. ~ Query message for terrain "card reader"'s examine action
#. ~ Query message for terrain "rewired card reader"'s examine action
#. ~ Query message for terrain "PPE lockup card reader"'s examine action
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "Swipe your ID card?"
msgstr "Passer votre carte d'identification dans le lecteur?"

#. ~ Message when terrain "card reader"'s examine action would be redundant
#. ~ Message when terrain "rewired card reader"'s examine action would be redundant
#. ~ Message when terrain "PPE lockup card reader"'s examine action would be redundant
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "The nearby doors are already opened."
msgstr "Les portes à proximité sont déjà ouvertes."

#. ~ Description of furniture "unfolded machinery"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid ""
"This inscrutable device is filled with wires, boards, and connections.  You "
"can see every one of them, and it gives you a headache."
msgstr ""

#. ~ Description of terrain "fractal compressor"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid ""
"This space is infinite, and has no beginning or end.  But you can see both "
"right here, in this churning mass of angles."
msgstr ""

#. ~ Description of terrain "concrete floor"
#. ~ Description of terrain "reinforced concrete wall"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid ""
"You can see every side of every crack in this worn concrete, all the way "
"down.  You can't look at it for too long."
msgstr ""

#. ~ Description of terrain "unfolded laser chamber"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid ""
"You can see the inside surface of this tube, and what it contains.  Thick, "
"slimy red light oozes within it."
msgstr ""

#. ~ Description of furniture "photonic conduit"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid ""
"You can see through the metal casing of this tube, into the blazing light "
"coursing through it."
msgstr ""

#. ~ Message when terrain "card reader"'s examine action succeeds
#. ~ Message when terrain "rewired card reader"'s examine action succeeds
#. ~ Message when terrain "PPE lockup card reader"'s examine action succeeds
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"You insert your ID card.\n"
"<color_light_green>The nearby doors unlock.</color>"
msgstr ""
"Vous insérez votre carte d'identification.\n"
"<color_light_green>Des portes dans les environs se déverouillent.</color>"

#. ~ Bashing sound of terrain "unfolded laser chamber"
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
msgid ""
"a hollow pop, followed by a sickly wet squelching as congealed light slowly "
"leaks out of the tube."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/LIXA_furniture_and_terrain.json
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid "card reader"
msgstr "lecteur de carte"

