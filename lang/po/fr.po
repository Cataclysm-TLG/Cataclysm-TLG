msgstr ""
"\"WBLF 970 a cessé d'émettre il y a trois jours. Il n'y a aucune autre "
"station qui a continué a émettre après ça. Je ferais tout aussi bien de "
"jeter cette foutue radio...\""

#. ~ Snippet in category "note"
#: data/json/snippets/survivor_notes.json
msgid "\"WE WERE RIGHT THE GOVERNMENT DID IT\""
msgstr "\"ON AVAIT RAISON  LE GOUVERNEMENT ÉTAIT DERRIÈRE TOUT\""

#. ~ Snippet in category "note"
#: data/json/snippets/survivor_notes.json
msgid "\"WE'RE GOING TO SAIL TO CANADA, BITCHES!\""
msgstr "\"ON VA NAVIGUER JUSQU'AU CANADA, À PLUS LES SALOPES."

#. ~ Snippet in category "note"
#: data/json/snippets/survivor_notes.json
msgid "\"WHY DO ALL THE DEAD CHILDREN GO TO SCHOOL\""
msgstr "\"POURQUOI EST-CE QUE TOUT LES GAMINS MORTS VONT TOUJOURS À L'ÉCOLE\""

#. ~ Snippet in category "note"
#: data/json/snippets/survivor_notes.json
msgid "\"We have Landed our Comet.  The Sky is Ablaze.\""
msgstr ""

#. ~ Snippet in category "note"
#: data/json/snippets/survivor_notes.json
