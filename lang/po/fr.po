msgstr "Pilotage de Bateau"

#. ~ Description of proficiency "Offroad Driving"
#: data/json/proficiencies/vehicles.json
msgid ""
"Driving offroad is especially difficult, but you can handle it better than "
"most."
msgstr ""

#. ~ Proficiency name
#: data/json/proficiencies/vehicles.json
msgid "Helicopter Piloting"
msgstr "Pilotage d'Hélicoptère"

#. ~ Proficiency name
#: data/json/proficiencies/vehicles.json
msgid "Offroad Driving"
msgstr ""

#. ~ Description of proficiency "Helicopter Piloting"
#: data/json/proficiencies/vehicles.json
msgid "You are able to operate helicopters of all shapes and sizes."
msgstr ""

#. ~ Description of proficiency "Boat Piloting"
#: data/json/proficiencies/vehicles.json
msgid ""
"You're familiar with the control and operation of boats and other marine "
"vehicles."
msgstr ""

