"guess."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/Backgrounds/prepper_1.json
msgid "Something bigger?  You mean you think someone did this intentionally?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/Backgrounds/prepper_1.json
msgid "Sorry, I won't ask again."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/Backgrounds/prepper_1.json
msgid "So… are you down to kick some alien ass with me?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/Backgrounds/prepper_1.json
