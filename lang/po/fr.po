msgstr ""

#. ~ Dialogue line in mission "Make 12 Molotov Cocktails"
#: data/json/npcs/tacoma_ranch/NPC_ranch_scavenger.json
msgid "Do you have the Molotov cocktails?"
msgstr "Vous avez les cocktails Molotov?"

#. ~ Dialogue line in mission "Make 5 Headlamps"
#: data/json/npcs/tacoma_ranch/NPC_ranch_scavenger.json
msgid "Do you have the headlamps?"
msgstr "Vous avez les lampes frontales?"

#. ~ Dialogue line in mission "Make 3 Suits of Leather Armor"
#: data/json/npcs/tacoma_ranch/NPC_ranch_scavenger.json
msgid "Do you have the leather armor?"
msgstr ""

#. ~ Dialogue line in mission "Make 6 Fire-Hardened Wooden Spears"
#: data/json/npcs/tacoma_ranch/NPC_ranch_scavenger.json
msgid "Do you have the wooden spears?"
msgstr ""

#. ~ Dialogue line in mission "Make 6 Fire-Hardened Wooden Spears"
#: data/json/npcs/tacoma_ranch/NPC_ranch_scavenger.json
msgid ""
"I can usually use additional survival gear to kit out the new recruits.  The "
"most basic weapon that everyone gets is a fire-hardened wooden spear… "
"They're not the best weapons, but we need people who are used to making do.  "
"Could you make me a half dozen of them?  I may need more later, but that "
"should help the first few teams."
msgstr ""

#. ~ NPC dialogue line
