msgid_plural "survivor harnesses"
msgstr[0] "Harnais de survivant"
msgstr[1] "Harnais de survivant"
msgstr[2] "Harnais de survivant"

#. ~ Description of "plastic cephalopod sleeves"
#: data/json/items/armor/boots.json
msgid ""
"A bunch of slender tubes of plastic sheeting.  These could be used to keep "
"the many arms of a cephalopod reasonably safe from environmental hazards."
msgstr ""

#. ~ Description of "cephalopod socks"
#: data/json/items/armor/boots.json
msgid ""
"A collection of thigh socks sewn too slender for human legs, but ideal for "
"keeping the many arms of a cephalopod warm."
msgstr ""

#. ~ Description of "steel-toed sneakers"
#: data/json/items/armor/boots.json
msgid ""
"A descendant of the classic steeltoed boot, this modern footwear has become "
"popular amongst working class people over the last couple of decades."
msgstr ""
"Une descendante de la chaussure de sécurité classique, ces baskets modernes "
"sont devenues populaires parmi la classe ouvrière durant les dernières "
"décennies."

#. ~ Description of "geta"
#: data/json/items/armor/boots.json
msgid ""
"A pair of Japanese clogs consisting of solid wooden soles and toe straps to "
"hold them on."
msgstr ""

#. ~ Description of "chitin sollerets"
#: data/json/items/armor/boots.json
msgid ""
"A pair of bizarre-looking boot covers made from overlapping layers of giant "
"arthropod shell."
msgstr ""

#. ~ Description of "biosilicified chitin sollerets"
#: data/json/items/armor/boots.json
msgid ""
"A pair of bizarre-looking boot covers made from overlapping layers of giant "
"arthropod shell.  The material seems unusually hard, with an almost glassy "
"sheen."
msgstr ""

#. ~ Description of "tabi"
#: data/json/items/armor/boots.json
msgid "A pair of black tabi, as worn with traditional Japanese clothes."
msgstr ""
"Paire de tabis noires, ainsi que porté dans les costumes japonais "
"traditionnels."

#. ~ Description of "bag socks"
#: data/json/items/armor/boots.json
msgid "A pair of disposable plastic bags, adapted to be used as socks."
msgstr "Des sacs plastiques en guise de chaussettes."

#. ~ Description of "motorcycle boots"
#: data/json/items/armor/boots.json
msgid "A pair of durable boots used by dirt bikers and motorcyclists."
msgstr ""
"Une paire de bottes solides utilisées par les motards et motocyclistes."

#. ~ Description of "bowling shoes"
#: data/json/items/armor/boots.json
msgid "A pair of flat-soled shoes for use in bowling alleys."
msgstr ""

#. ~ Description of "heels"
#: data/json/items/armor/boots.json
msgid "A pair of high heeled shoes, impractical for running or fighting."
msgstr ""

#. ~ Description of "rollerblades"
#: data/json/items/armor/boots.json
msgid ""
"A pair of inline skates.  Very fast on flat floors, but they make it hard to "
"move on rough terrain, take hits, or dodge effectively."
msgstr ""

#. ~ Description of "rubber boots"
#: data/json/items/armor/boots.json
msgid ""
"A pair of rubber work boots, often used while cleaning with caustic "
"materials."
msgstr ""

#. ~ Description of "heelys (off)"
#: data/json/items/armor/boots.json
msgid ""
"A pair of sneakers with integrated wheels hidden in their very thick soles.  "
"Currently the wheels are retracted, making these almost normal lace-up "
"athletic shoes."
msgstr ""

#. ~ Description of "heelys (on)"
#: data/json/items/armor/boots.json
msgid ""
"A pair of sneakers with integrated wheels, currently the wheels are out, "
"allowing you to swiftly roll around on flat terrain.  You should probably "
"pop them back in before you try fighting or going off-road."
msgstr ""

#. ~ Description of "turnout boots"
#: data/json/items/armor/boots.json
msgid "A pair of steel-toed rubber boots, the sort worn by firefighters."
msgstr ""
"Une paire de bottes en caoutchouc renforcées normalement portées par des "
"pompiers."

#. ~ Description of "gi tabi"
#: data/json/items/armor/boots.json
msgid "A pair of white tabi, as used by martial arts practitioners."
msgstr "Une paire de tabis blancs, porté par les pratiquants d'arts martiaux."

#. ~ Description of "boots"
#: data/json/items/armor/boots.json
msgid "A relatively lightweight pair of leather boots."
msgstr ""

#. ~ Description of "flame-resistant socks"
#: data/json/items/armor/boots.json
msgid ""
"A snug-fitting pair of stockings made from thin and lightweight Nomex fabric."
msgstr ""

#. ~ Description of "fur moccasins"
#: data/json/items/armor/boots.json
msgid "A type of traditional Native American footwear sewn out of fur."
msgstr ""

#. ~ Description of "moccasins"
#: data/json/items/armor/boots.json
msgid "A type of traditional Native American footwear sewn out of leather."
msgstr ""

#. ~ Description of "plate sollerets"
#: data/json/items/armor/boots.json
msgid ""
"Also known as sabatons, these steel boot covers are meant to be strapped on "
"over a pair of shoes."
msgstr ""

#. ~ Description of "rollerskates"
#: data/json/items/armor/boots.json
msgid ""
"An old-fashioned pair of leather rollerskates with steel frames.  While "
"quite fast on flat floors, they make it difficult to take hits or to move on "
"rough terrain."
msgstr ""

#. ~ Description of "EOD foot protectors"
#: data/json/items/armor/boots.json
msgid ""
"Armored foot protectors constructed from steel and Nomex for use by "
"explosive ordnance disposal technicians."
msgstr ""
"Une paire de bottes blindées en acier et Nomex utilisées pour protéger les "
"professionnels du déminage."

#. ~ Description of "sneakers"
#: data/json/items/armor/boots.json
msgid "Athletic shoes, designed for running."
msgstr ""

#. ~ Description of "faux fur boots"
#: data/json/items/armor/boots.json
msgid "Boots made of durable nylon duck with faux fur lining for warmth."
msgstr ""

#. ~ Description of "knee-high boots"
#: data/json/items/armor/boots.json
msgid ""
"Boots with a cuff that extends up to the knee.  Their heels are sensibly "
"low, but still don't look terribly suited to running away from monsters "
"during the end of the world."
msgstr ""

#. ~ Description of "disposable bowling socks"
#: data/json/items/armor/boots.json
msgid ""
"Cheap socks designed to be worn once and then thrown away.  They keep your "
"feet clean, but are too thin to give any protection."
msgstr ""
"Une paire de chaussettes jetables bon marché conçues pour n'être portées "
"qu'une seule fois et garder les surfaces sur lesquelles vous marchez assez "
"propre. L'épaisseur est trop fine pour vous protéger de quoi que ce soit."

#. ~ Description of "motorcycle police boots"
#: data/json/items/armor/boots.json
msgid ""
"Custom-made knee-high leather boots issued to motor officers.  Warm, durable "
"and quite tough."
msgstr ""
"Une paire de bottes customisées fournies aux motards de police. Durable, "
"chaudes et résistantes."

#. ~ Item name
#: data/json/items/armor/boots.json
msgid "EOD foot protectors"
msgid_plural "pairs of EOD foot protectors"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ "menu_text" action message of item "heelys (off)"
#: data/json/items/armor/boots.json
msgid "Extend wheels"
msgstr "Étendre les roues"

#. ~ Description of "dress shoes"
#: data/json/items/armor/boots.json
msgid "Fancy leather shoes, not designed for running."
msgstr ""

#. ~ Description of "faux fur foot wraps"
#: data/json/items/armor/boots.json
msgid ""
"Faux fur patches tied around your feet.  Not much of an improvement over "
"being barefoot, but still better than nothing."
msgstr ""

#. ~ Description of "wool foot wraps"
#: data/json/items/armor/boots.json
msgid ""
"Felt patches tied around your feet.  Not much of an improvement over being "
"barefoot, but still better than nothing."
msgstr ""
"Des morceaux de feutres roulés autour de vos pieds. C'est mieux que rien, "
"étonnamment comfortable, mais ça ne vaut pas de vraies chaussures."

#. ~ Description of "fur foot wraps"
#: data/json/items/armor/boots.json
msgid ""
"Fur pelts tied around your feet.  Not much of an improvement over being "
"barefoot, but still better than nothing."
msgstr ""
"Des morceaux de fourrure roulés autour de vos pieds. C'est mieux que rien, "
"garde vos pieds assez chauds, mais ça ne vaut pas des vraies chaussures."

#. ~ Description of "clown shoes"
#: data/json/items/armor/boots.json
msgid ""
"Gigantic shoes fit for a clown.  They would be very difficult to run in, and "
"fighting in them seems like a terrible idea."
msgstr ""

#. ~ Description of "steel-toed boots"
#: data/json/items/armor/boots.json
msgid ""
"Heavy boots made of chemical-resistant treated leather with steel toecaps.  "
"Great for the jobsite or for stomping the undead"
msgstr ""

#. ~ Description of "thigh-high boots"
#: data/json/items/armor/boots.json
msgid ""
"High-heeled boots that extend all the way up past the knees, these are the "
"sort of thing you would have seen on a stripper or at a halloween party."
msgstr ""

#. ~ Description of "wooden clogs"
#: data/json/items/armor/boots.json
msgid ""
"Known as klompen in the Netherlands and sabots in France, these wooden shoes "
"have endured through the ages due to their simple design and durability."
msgstr ""
"Connus sous le nom de Klompen aux Pays-Bas et sabots en France, ces "
"chaussures en bois ont enduré toutes les époques grâce à leur conception "
"simple et à leur solidité."

#. ~ Description of "fur boots"
#: data/json/items/armor/boots.json
msgid "Leather boots, lined with fur for warmth."
msgstr ""

#. ~ Description of "leather foot wraps"
#: data/json/items/armor/boots.json
msgid ""
"Leather patches tied around your feet.  Not much of an improvement over "
"being barefoot, but still better than nothing."
msgstr ""
"Des lanières de cuir roulées autour de vos pieds. C'est mieux que rien, mais "
"ça ne vaut pas de vraies chaussures."

#. ~ Description of "slip-on shoes"
#: data/json/items/armor/boots.json
msgid "Lightweight cloth shoes with no ties, meant to be worn without socks."
msgstr ""

#. ~ Description of "cord sandals"
#: data/json/items/armor/boots.json
msgid ""
"Lightweight sandals made from wound cord.  They offer little in the way of "
"protection, but keep you cool during warmer months."
msgstr ""
"Des sandales légères faites de corde enroulée. Elles protègent peu, mais "
"vous rafraîchiront durant les mois chauds."

#. ~ Description of "lowtop tennis shoes"
#: data/json/items/armor/boots.json
msgid "Lightweight shoes made of cloth and rubber."
msgstr "Des chaussures légères faites en tissu et caoutchouc."

#. ~ Description of "thigh socks"
#: data/json/items/armor/boots.json
msgid "Long socks that reach above the knees."
msgstr ""

#. ~ Item name
#: data/json/items/armor/boots.json
msgid "Nomex foot wraps"
msgid_plural "pairs of Nomex foot wraps"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""

#. ~ Description of "foot wraps"
#: data/json/items/armor/boots.json
msgid ""
"Rags tied around your feet.  Not much of an improvement over being barefoot, "
"but still better than nothing."
msgstr ""
"Des chiffons roulés autour de vos pieds. C'est mieux que rien, mais ça ne "
"vaut pas des vraies chaussures."

#. ~ "menu_text" action message of item "heelys (on)"
#: data/json/items/armor/boots.json
msgid "Retract wheels"
msgstr "Rétracter les roues"

#. ~ Description of "straw sandals"
#: data/json/items/armor/boots.json
msgid ""
"Sandals made from straw cordage.  Not very comfortable, but can keep your "
"feet safe."
msgstr ""

#. ~ Description of "ankle socks"
#: data/json/items/armor/boots.json
msgid ""
"Short socks, commonly used for sports.  These are designed to protect your "
"feet from friction, not temperature."
msgstr ""
"Une paire de chaussettes courtes et bien aérées appréciées par les sportifs "
"pour protéger leurs pieds de la friction, mais celles-ci ne vous protégeront "
"pas vraiment du froid."

#. ~ Description of "flip-flops"
#: data/json/items/armor/boots.json
msgid "Simple sandals.  Somewhat difficult to run in."
msgstr "Des sandales, bien aérées mais assez difficiles de courir avec."

#. ~ Description of "birchbark shoes"
#: data/json/items/armor/boots.json
msgid ""
"Simple shoes woven from strips of flexible bark from a birch tree.  They're "
"not especially comfortable, but might be better than going barefoot."
msgstr ""

#. ~ Description of "golf shoes"
#: data/json/items/armor/boots.json
msgid "Snug sport shoes with hard ridges on the bottom."
msgstr ""

#. ~ Description of "socks"
#: data/json/items/armor/boots.json
msgid "Socks.  Put 'em on your feet."
msgstr "Une paire de chaussettes. Mettez les à vos pieds."

#. ~ Description of "slippers"
#: data/json/items/armor/boots.json
msgid ""
"Soft indoor shoes that keep your feet warm.  They're not great for much else."
msgstr ""

#. ~ Description of "combat boots"
#: data/json/items/armor/boots.json
msgid ""
"Solid but surprisingly lightweight boots made from a combination of suede "
"and nylon duck.  Possibly the most important part of a service member's "
"uniform."
msgstr ""

#. ~ Description of "cleats"
#: data/json/items/armor/boots.json
msgid ""
"Sport shoes with hard undersides and studs on the bottom designed to dig "
"into grass."
msgstr ""

#. ~ Description of "western boots"
#: data/json/items/armor/boots.json
msgid ""
"Stiff leather cowboy boots with pointed toes and a low heel.  The wide cuffs "
"could be used as ad hoc pockets, or maybe even holsters."
msgstr ""

#. ~ Description of "Nomex foot wraps"
#: data/json/items/armor/boots.json
msgid ""
"Strips of fireproof fabric that can be tied around the feet.  These leave a "
"lot to be desired, but they might be better than nothing."
msgstr ""

#. ~ Description of "leather sandals"
#: data/json/items/armor/boots.json
msgid ""
"Sturdy leather hiking sandals with a heel strap, suitable for outdoor "
"adventuring in warm weather."
msgstr ""

#. ~ Description of "expensive flip-flops"
#: data/json/items/armor/boots.json
msgid ""
"These flip-flops are branded with a designer logo.  It does not make them "
"any easier to run in."
msgstr ""

#. ~ Description of "hiking boots"
#: data/json/items/armor/boots.json
msgid ""
"Tough yet light boots made of leather facing over sythetic uppers, intended "
"for outdoor activity."
msgstr ""

#. ~ Description of "wool socks"
#: data/json/items/armor/boots.json
msgid "Warm socks made of wool."
msgstr "Des chaussettes chaudes en laine."

#. ~ Description of "winter boots"
#: data/json/items/armor/boots.json
msgid "Wool-lined boots designed for warmth."
msgstr "Des bottes doublées en laine conçues pour conserver la chaleur."

#. ~ "msg" action message of item "heelys (on)"
#: data/json/items/armor/boots.json
msgid "You pop the wheels back in."
msgstr "Vous rentrez les roues."

#. ~ "msg" action message of item "heelys (off)"
#: data/json/items/armor/boots.json
msgid "You pop the wheels out."
msgstr "Vous sortez les roues."

