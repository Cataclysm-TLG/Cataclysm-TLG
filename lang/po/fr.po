#. ~ NPC dialogue line
#: data/json/npcs/old_guard/NPC_Old_Guard_FOB_Soldier_1.json
msgid "Stay safe out there."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/old_guard/NPC_Old_Guard_FOB_Soldier_1.json
msgid "Welcome to camp Arabella"
msgstr "Bienvenue au camp Arabella"

#. ~ Response to NPC dialogue
#: data/json/npcs/old_guard/NPC_Old_Guard_FOB_officer.json
