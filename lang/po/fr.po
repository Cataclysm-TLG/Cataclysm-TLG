msgstr ""

#. ~ Snippet in category "<LIXA_personal_snip_4>"
#: data/json/snippets/LIXA_snippets.json
msgid ""
"This is a saved file that opens in a digital painting program.  It is a "
"crude cartoon of a woman in a suit with a manic expression, and a word "
