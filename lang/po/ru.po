msgid_plural "Henry Golden Boy rifles"
msgstr[0] "Винтовка Генри Голден Бой"
msgstr[1] "Винтовка Генри Голден Бой"
msgstr[2] "Винтовка Генри Голден Бой"

#. ~ Variant name of gun ".22 six-shooter"
#. ~ Variant name of item ".22 six-shooter"
