#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid ""
"\"If I was in there I'd sure as hell be trying to talk my way out, but it's "
"just standing there.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Individual specimens of U-O Seven-Seven-Three-Four.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Is everything all right?\""
