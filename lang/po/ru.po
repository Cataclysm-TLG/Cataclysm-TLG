#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "CANT_HEAL_EVERYONE"
#: data/json/flags/flags.json
msgid "This med can't be used by everyone, it requires a special mutation."
msgstr ""
