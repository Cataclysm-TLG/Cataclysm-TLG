msgstr "%s не может добраться до начального тайла."

#: src/activity_actor.cpp:8631 src/activity_item_handling.cpp:2626
#, c-format
msgid "%s sorted out every item possible."
msgstr "%s заканчивает сортировать все доступные предметы."

#: src/activity_actor.cpp:8650
#, c-format
