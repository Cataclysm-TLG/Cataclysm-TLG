msgstr "Требуется для работы подключённого генератора."

#. ~ Description of fault "Faulty starter motor"
#: data/json/faults/faults_vehicles.json
msgid "Required to initially start the engine."
msgstr "Требуется для запуска двигателя."

#. ~ Description of fault "Faulty diesel pump"
#: data/json/faults/faults_vehicles.json
msgid "Required to pump and pressurize diesel from a vehicle's tank."
msgstr ""
"Требуется для подкачки дизеля из топливного бака автомобиля и нагнетания "
"давления."

#. ~ Description of fault "Faulty fuel pump"
#: data/json/faults/faults_vehicles.json
msgid "Required to pump gasoline from a vehicle's tank."
msgstr "Требуется для перекачки бензина из бака автомобиля."

#. ~ Name of a fault
#: data/json/faults/faults_vehicles.json
msgid "Worn drive belt"
msgstr "Изношенный приводной ремень"

#. ~ Prefix for item's name "Worn drive belt"
