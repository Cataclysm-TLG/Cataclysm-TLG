#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Mission success!  I don't know what else to say."
msgstr "Миссия выполнена! Тут и говорить нечего."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Never mind, I'm not interested."
msgstr "Неважно, мне не интересно."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "No.  I'll get back to it, bye!"
msgstr "Нет. Я скоро этим займусь, пока!"

#. ~ Snippet in category "<acknowledged>"
#. ~ Generic acknowledgment of a command.  Comes up a lot and could use more variety.
#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/talk_tags.json
msgid "Not a problem."
msgstr "Нет проблем."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_drugs.json
#: data/json/npcs/hub01/robofac_intercom/robofac_intercom_missions.json
#: data/json/npcs/random_encounters/refugee_caravans.json
msgid "Not interested."
msgstr "Не интересует."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/refugee_center/surface_staff/NPC_free_merchant_guard1.json
msgid "Oh, okay."
msgstr "Ну, ладно."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Sounds good, thanks."
msgstr "Хорошо, спасибо."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Sounds good.  Bye!"
msgstr "Хорошо. Пока!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Sure, here you go!"
msgstr "Конечно, бери!"

#. ~ Response to NPC dialogue
#. ~ Dialogue line in mission "Retrieve the fertility supplements"
#. ~ Dialogue line in mission "Find cactus seeds"
#. ~ Dialogue line in mission "Fishy Business"
#. ~ Dialogue line in mission "Mathematical Measures"
#. ~ Dialogue line in mission "Plumbing Maintenance"
#. ~ Dialogue line in mission "Planning Planers"
#. ~ Dialogue line in mission "Purging Heresy"
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
#: data/json/npcs/hub01/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_jabberwock.json
#: data/json/npcs/hub01/robofac_intercom/robofac_intercom_missions.json
#: data/json/npcs/necc/godco_missions.json
#: data/json/npcs/necc/members/NPC_Helena_Misinter.json
#: data/json/npcs/necc/members/NPC_Maria_Serrano.json
#: data/json/npcs/other/homeless/group_camp/TALK_homeless_broker.json
msgid "Thank you."
msgstr "Спасибо."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Thanks, bye."
msgstr "Спасибо, пока."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "We're here!"
msgstr "Мы здесь!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Well, um, sorry."
msgstr "Ну… эмм… прости."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "What about it?"
msgstr "Что насчёт него?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "What's the matter?"
msgstr "В чём дело?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Whatever.  Bye."
msgstr "Неважно. Пока."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Which job?"
msgstr "Какое задание?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "You're not working on anything for me now."
msgstr "Ты сейчас на меня не работаешь."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_MISSION.json
msgid "Yup!  Here it is!"
msgstr "Ага! Вот оно!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "<no>, and if you ask again, <ill_kill_you>!"
msgstr "<no>, и если будешь переспрашивать, <ill_kill_you>!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "<no><punc> <fuck_you>!"
msgstr "<no><punc> <fuck_you>!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Ah, okay."
msgstr "Ну, ладно."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, let's begin."
msgstr "Хорошо, приступим."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, let's go."
msgstr "Да, пошли."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, show me how it's done."
msgstr "Ладно, покажи мне, как это делается."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright, who should participate?"
msgstr "Ладно, кто будет участвовать?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Alright.  You can lead now."
msgstr "Хорошо. Веди нас."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Any tips?"
msgstr "Есть какие-нибудь советы?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "At least we've got shelter."
msgstr "По крайней мере у нас есть убежище."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Awesome!"
msgstr "Шикарно!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Because I'm holding a thermal detonator!"
msgstr "Потому что у меня в руке термальный детонатор!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Because I'm your friend!"
msgstr "Потому что мы друзья!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Don't try and talk yourself out of this, drop it now."
msgstr "Не пытайся заговорить мне зубы, бросай сейчас же."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Eh, never mind."
msgstr "Эх, неважно."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/holdouts/Rural-Cowboy_Nihilist.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_barber.json
msgid "Fine."
msgstr "Хорошо."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Focus on the road, mate!"
msgstr "Смотри на дорогу!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Give it to me, or else!"
msgstr "Отдавай по-хорошему!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Good.  Something else…"
msgstr "Хорошо. Кое-что ещё…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Hmm, okay."
msgstr "Хмм, ладно."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "How much further?"
msgstr "Далеко ещё?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I can keep you safe."
msgstr "Со мной ты будешь в безопасности."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I don't know, look for supplies and other survivors I guess."
msgstr "Я не знаю. Искать припасы и других выживших, полагаю."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I don't think it's safe enough to do any teaching here."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I have some reason for not telling you."
msgstr "У меня есть причины не рассказывать тебе об этом."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "I need you to come with me."
msgstr "Тебе нужно пойти со мной."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I really don't feel comfortable doing so…"
msgstr "Мне действительно это неудобно…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid ""
"I suppose getting a car up and running would be really be useful if we have "
"to move."
msgstr "Если бы нам пришлось сваливать, то лучше найти машину и уехать на ней."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I understand…"
msgstr "Я понимаю…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I would prefer not to."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'd like to lead for a while."
msgstr "Я бы хотел стать лидером на какое-то время."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'll give it back!"
msgstr "Я всё верну обратно!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'll give you some space."
msgstr "Ладно, я не буду настаивать."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'll kill you if you don't."
msgstr "Я убью тебя, если ты не сделаешь этого."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm driving here!"
msgstr "За рулём я, окей!"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm on watch."
msgstr "Я на страже."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "I'm sorry.  Look, I already dropped it, okay?"
msgstr "Мне жаль. Слушай, я уже бросаю, лады?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid ""
"I'm willing to pay <topic_item_price> per batch for a total of "
"<topic_item_your_total_price>."
msgstr ""
"Я могу заплатить <topic_item_price> за штуку, всего "
"<topic_item_your_total_price>."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Just this once, you can keep it.  Don't tell anyone else."
msgstr "Забирай, но только на этот раз. Никому не говори."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Let's see…"
msgstr "Посмотрим…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "Let's talk."
msgstr "Давайте поговорим."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Look, I really need this.  Please let me have it."
msgstr "Слушай, мне правда очень нужно. Пожалуйста, отдай."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/other/meteorologist.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_old_guard_representative.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_crop_overseer.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_woodcutter1.json
msgid "Maybe later."
msgstr "Может позже."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Maybe we should start boarding up this place."
msgstr "Возможно, нам стоит начать баррикадировать это место."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Never mind, I'll do without.  Bye."
msgstr "Не бери в голову. И так справлюсь. Пока."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "No, I'm keeping it.  Try and take it off me, I dare you."
msgstr "Нет, теперь это моё. Только попробуй отобрать."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Not a chance, I'm going to get left behind!"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, I'm dropping it…"
msgstr "Хорошо, я бросаю…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, fine, bye."
msgstr "Ладно, хорошо, пока."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, fine."
msgstr "Ладно, хорошо."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, here you go."
msgstr "Ладно, держи."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, let's go!"
msgstr "Ладно, пошли!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, okay, sorry."
msgstr "Ладно, ладно, извини."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, okay, this is all a misunderstanding.  Sorry, I'll drop it now."
msgstr "Ладно, ладно, у нас просто недопонимание. Извини, я это брошу."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Okay, okay."
msgstr "Ладно, ладно."

#. ~ Snippet in category "<acknowledged>"
#. ~ Generic acknowledgment of a command.  Comes up a lot and could use more variety.
#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/island_prison/prisoners.json
#: data/json/npcs/necc/members/foodguard.json data/json/npcs/talk_tags.json
msgid "Okay."
msgstr "Ладно."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "On second thought, never mind."
msgstr "А впрочем, неважно."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Pleasure doing business!"
msgstr "Приятно иметь с тобой дело!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Right, right, I'll ask later."
msgstr "Да, точно. Я спрошу позже."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Right… I don't want any trouble."
msgstr "Верно… Мне не нужны неприятности."

#. ~ Response to NPC dialogue
#. ~ Affirmative response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/holdouts/Rural-Cowboy_Nihilist.json
#: data/json/npcs/holdouts/Rural-Cowboy_Trader.json
#: data/json/npcs/hub01/robofac_ancilla_npcs/NPC_ANCILLA_HQ_GUARD.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "See you around."
msgstr "Увидимся."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Seriously, give me more stuff!"
msgstr "Я не шучу, дай мне что-нибудь!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Smart choice."
msgstr "Разумный выбор."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Step aside.  I'm leader now."
msgstr "В сторону. Теперь я лидер."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/refugee_center/surface_refugees/NPC_Draco_Dune.json
msgid "Thanks!"
msgstr "Спасибо!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Thanks!  But can I have some more?"
msgstr "Спасибо! А могу ли я получить ещё?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Thanks, see you later!"
msgstr "Спасибо, позже увидимся!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/necc/members/NPC_Aunt_Theresa.json
#: data/json/npcs/necc/members/NPC_Helena_Misinter.json
#: data/json/npcs/necc/members/cook.json
#: data/json/npcs/other/TALK_NPC_PREPPER_SURVIVOR.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_old_guard_representative.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_foreman.json
msgid "Thanks."
msgstr "Спасибо."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Understood.  I'll get those antibiotics."
msgstr "Понятно. Я достану антибиотики."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Want to share some useful items with me?"
msgstr "Хочешь поделиться со мной полезными вещами?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/other/meteorologist.json
msgid "Want to travel with me?"
msgstr "Хочешь пойти со мной?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid ""
"We could look for a farm.  They should have food and tools, and they aren't "
"close to cities."
msgstr ""
"Мы могли бы поискать ферму. У них должна быть еда и инструменты, и они "
"находятся недалеко от городов."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid ""
"We should probably stay away from cities, even if they have lots of supplies."
msgstr ""
"Лучше держаться подальше от городов, хоть в них и есть много продовольствия."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Well, I am helping you out…"
msgstr "Ну, я же тебе помогаю…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Well, I guess it's just us."
msgstr "Что ж, похоже только ты да я."

#. ~ NPC dialogue line
#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
#: data/json/npcs/refugee_center/surface_visitors/NPC_old_guard_representative.json
#: data/json/npcs/tacoma_ranch/NPC_ranch_foreman.json
msgid "What is it?"
msgstr "В чём дело?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "What should we do now?"
msgstr "Что нам теперь делать?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "What, this?  It's not the same one, you are mistaken."
msgstr "Что, вот это? Ты ошибся, это другое."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Why should I share my equipment with you?"
msgstr "С какой стати я буду делиться с тобой своим имуществом?"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Why should I travel with you?"
msgstr "Зачем мне идти с тобой?"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Works for me."
msgstr "Сойдёт."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "Yeah… I don't think so."
msgstr "Да? Я так не думаю."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You can keep me safe."
msgstr "С тобой я буду в безопасности."

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You got it, I'm with you!"
msgstr "Точно, я с тобой!"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You might be seeing more of me…"
msgstr "Думаю, мы ещё встретимся…"

#. ~ NPC dialogue line
#: data/json/npcs/common_chat/TALK_COMMON_OTHER.json
msgid "You picked up something that does not belong to you…"
msgstr "Ты берёшь кое-что чужое…"

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_FRIEND_CONVERSATION.json
#: data/json/npcs/your_followers/luo_follower.json
msgid "<chitchat_player_responses>"
msgstr "<chitchat_player_responses>"

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/Cataclysm-TLG/Cataclysm-TLG/blob/master/doc/TRANSLATING.md#grammatical-gender
#: data/json/npcs/common_chat/TALK_FRIEND_CONVERSATION.json
msgctxt "u:f"
msgid ""
"Are you sure?  This doesn't seem like a particularly safe place for small "
"talk…"
msgstr "Ты уверена? Тут похоже, не особо безопасно, чтобы просто болтать…"

#. ~ NPC dialogue line
#. ~ You don't need to translate genders that aren't in your language
#. ~ Check: https://github.com/Cataclysm-TLG/Cataclysm-TLG/blob/master/doc/TRANSLATING.md#grammatical-gender
#: data/json/npcs/common_chat/TALK_FRIEND_CONVERSATION.json
msgctxt "u:m"
msgid ""
"Are you sure?  This doesn't seem like a particularly safe place for small "
"talk…"
