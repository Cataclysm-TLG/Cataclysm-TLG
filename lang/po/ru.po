msgstr "За 5 минут до (%s)"

#: src/crafting.cpp:1287 src/crafting.cpp:1329
#, c-format
msgid "%s is ready."
msgstr "%s готов."

#: src/crafting.cpp:1330
#, c-format
msgid "Your timer goes off: %s"
msgstr "Ваш таймер сработал: %s"

#: src/crafting.cpp:1606
#, c-format
