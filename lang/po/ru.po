msgid_plural "allosaurus plushies"
msgstr[0] "плюшевый аллозавр"
msgstr[1] "плюшевых аллозавра"
msgstr[2] "плюшевых аллозавров"

#. ~ Variant name of item "plush toy"
#: data/json/items/toy.json
msgid "alpaca plushie"
msgid_plural "alpaca plushies"
msgstr[0] "плюшевая альпака"
msgstr[1] "плюшевые альпаки"
msgstr[2] "плюшевых альпак"

#. ~ Variant name of item "large figurine"
#: data/json/items/toy.json
msgid "anime figurine"
msgid_plural "anime figurines"
msgstr[0] "фигурка аниме персонажа"
msgstr[1] "фигурки аниме персонажа"
msgstr[2] "фигурок аниме персонажа"

#. ~ Variant name of item "plush toy"
#: data/json/items/toy.json
msgid "ankylosaurus plushie"
msgid_plural "ankylosaurus plushies"
msgstr[0] "плюшевый анкилозавр"
msgstr[1] "плюшевых анкилозавра"
msgstr[2] "плюшевых анкилозавров"

#. ~ Variant name of item "plush toy"
#: data/json/items/toy.json
msgid "ant plushie"
msgid_plural "ant plushies"
msgstr[0] "плюшевый муравей"
msgstr[1] "плюшевых муравья"
msgstr[2] "плюшевых муравьёв"

#. ~ Variant name of item "plush toy"
#: data/json/items/toy.json
msgid "aphid plushie"
msgid_plural "aphid plushies"
msgstr[0] "плюшевая тля"
msgstr[1] "плюшевые тли"
msgstr[2] "плюшевых тлей"

#. ~ Variant name of item "plush toy"
#: data/json/items/toy.json
msgid "archaeopteryx plushie"
