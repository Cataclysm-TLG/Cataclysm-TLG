#: src/iexamine.cpp:5585
msgid "ERROR NO SPACE AVAILABLE.  Operation impossible.  Exiting."
msgstr "ОШИБКА — НЕТ СВОБОДНОГО МЕСТА. Операция невозможна. Завершение работы."

#: src/iexamine.cpp:5590
msgid "Personality_Override"
msgstr "Personality_Override"

#: src/iexamine.cpp:5592
msgid "C0RR#PTED?D#TA"
msgstr "ДА#НЫЕ?П0ВР#ЖДЕНЫ"

#: src/iexamine.cpp:5594 src/iexamine.cpp:5749 src/wish.cpp:419
msgid "Choose bionic to uninstall"
msgstr "Выберите бионику для удаления"

