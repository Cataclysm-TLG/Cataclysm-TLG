#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "HELMET_FRONT_ATTACHMENT"
#: data/json/flags/flags.json
msgid "This item is attachable in the front of <info>military helmets</info>."
msgstr ""
