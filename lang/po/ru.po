msgstr "Вам не хватает материалов для улучшения."

#: src/faction_camp.cpp:1665 src/faction_camp.cpp:2461
msgid "responds to the emergency recall…"
msgstr "реагирует на экстренный отзыв…"

#: src/faction_camp.cpp:1672
#, c-format
msgid "You abandon %s."
msgstr "Вы забросили лагерь (%s)."

#: src/faction_camp.cpp:1724
