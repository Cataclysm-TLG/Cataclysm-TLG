msgid_plural "FN 1910 .380 pistols"
msgstr[0] "пистолет FN 1910 .380"
msgstr[1] "пистолета FN 1910 .380"
msgstr[2] "пистолетов FN 1910 .380"

#. ~ Variant name of gun ".380 ACP pistol-caliber carbine"
#. ~ Variant name of item ".380 ACP pistol-caliber carbine"
#: data/json/items/gun/380.json
