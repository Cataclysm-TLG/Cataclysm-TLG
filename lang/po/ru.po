msgstr "У вас нет необходимых компонентов для продолжения изготовления!"

#: src/crafting.cpp:2569
msgid "<npcname> don't have the required components to continue crafting!"
msgstr ""
"<npcname> не имеет необходимых компонентов для продолжения изготовления!"

