#: data/json/npcs/refugee_center/surface_visitors/NPC_scavenger_mercenary.json
msgid "Well, bye."
msgstr "Ладно, пока."

#. ~ Response to NPC dialogue
#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
msgid "Why do you still use cash?"
msgstr "Почему ты ещё пользуешься деньгами?"

#. ~ NPC dialogue line
#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
msgid ""
"Why not?  Everyone else does, so I suppose that's all that matters.  My ATM "
"over there still works, connected to the bank servers and everything."
msgstr ""
"Почему бы нет? Все ими пользуются, так что, думаю, это главное. Мой банкомат "
"вон там все ещё работает, он соединен с банковскими серверами и прочим."

#. ~ Response to NPC dialogue
#: data/json/npcs/bunker_shop/TALK_BUNKER_MERCHANT.json
msgid "You're a trader?"
msgstr "Ты торговец?"

#. ~ Job description of "Merchant" NPC class
#: data/json/npcs/bunker_shop/classes.json
msgid "I sell things to make a living."
msgstr "Я зарабатываю на жизнь, продавая вещи."

