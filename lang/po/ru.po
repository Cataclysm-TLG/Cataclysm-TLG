msgstr "Расплескивает застывший свет по земле в виде конуса."

#. ~ Spell name
#: data/json/monsters/LIXA_monsters.json
msgid "Spread Light"
msgstr "Распространение света"

#. ~ Spell name
#: data/json/monsters/LIXA_monsters.json
