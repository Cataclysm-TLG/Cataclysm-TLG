msgstr "Нападай только на врагов, до которых можно достать без передвижения."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Be angry (+10 anger)."
msgstr "Разозлись (+10 гнев)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
