#: src/messages.cpp:891
#, c-format
msgid "< Press %s to filter, %s to reset >"
msgstr "< Нажмите %s чтобы отфильтровать, %s для сброса >"

#: src/messages.cpp:1010
#, c-format
msgid ""
"<color_light_gray>The default is to search the entire message log.  Use "
"message-types as prefixes followed by (:) to filter more specific.\n"
"Valid message-type values are:</color> %s\n"
"\n"
"<color_white>Examples:</color>\n"
"  <color_light_green>good</color><color_white>:mutation\n"
"  :you pick up: 1</color>\n"
"  <color_light_red>bad</color><color_white>:</color>\n"
"\n"
msgstr ""
"<color_light_gray>По умолчанию поиск идет по всему логу сообщений. "
"Используйте типа сообщений как префикс, ставя после них (:) для "
"дополнительных фильтров.\n"
"Корректные запросы:</color>%s\n"
"\n"
"<color_white>Примеры:</color>\n"
" <color_light_green>хороший:</color><color_white>мутация\n"
":вы поднимаете:1</color>\n"
"<color_light_red>плохой</color><color_white>:</color>\n"
"\n"

#. ~ the 2nd %s is a type name, this is used to format a list of type names
