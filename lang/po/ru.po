#, c-format
msgid ""
"You must select a target from %d to %d range.  Your selection was range %d."
msgstr ""
"Вы должны выбрать цель в промежутке между %d и %d тайлами от базы. "
"Расстояние: %d"

#: src/faction_camp.cpp:3223
