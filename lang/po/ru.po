msgstr "Вы ошибаетесь и теряете %d%% прогресса."

#: src/crafting.cpp:2317
#, c-format
msgid "<npcname> messes up and loses %d%% progress."
msgstr "<npcname> ошибается и теряет %d%% прогресса."

#: src/crafting.cpp:2321
msgid "Ugh, this should be EASY with how smart you are!"
msgstr "Ох, это же должно быть так ПРОСТО с вашими-то мозгами!"

#: src/crafting.cpp:2322
msgid "<npcname> seems to get really upset over this."
msgstr "<npcname>, кажется, расстраивается из-за этого."

#: src/crafting.cpp:2448
#, c-format
