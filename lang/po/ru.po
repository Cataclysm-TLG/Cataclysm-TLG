#, c-format
msgid "Add more %s to the vat"
msgstr "Добавить ещё %s в чан"

#: src/iexamine.cpp:3465
#, c-format
msgid "Remove %s from the vat"
msgstr "Убрать содержимое (%s) из чана"

#: src/iexamine.cpp:3466
msgid "Start fermenting cycle"
msgstr "Начать цикл ферментирования"

#: src/iexamine.cpp:3498
#, c-format
msgid "Set %s in the vat."
msgstr "Вы поместили сусло (%s) в чан."

#: src/iexamine.cpp:3499
#, c-format
msgid "The keg now contains %s (%d), %0.f%% full."
msgstr "Теперь кег содержит: %s(%d), %0.f%% наполнения."

#: src/iexamine.cpp:3506
msgid "Start fermenting cycle?"
msgstr "Начать цикл брожения?"

#: src/iexamine.cpp:3513
msgid "The vat is full, so you close the lid and start the fermenting cycle."
msgstr "Бак полон, так что можете закрыть крышку и начать цикл ферментации."

#: src/iexamine.cpp:3515
msgid "You close the lid and start the fermenting cycle."
msgstr "Вы закрываете крышку и начинаете цикл ферментации."

#: src/iexamine.cpp:3532
#, c-format
msgid "You remove %s from the vat."
msgstr "Вы сливаете продукт (%s) из чана."

#: src/iexamine.cpp:3547
#, c-format
msgid "There's a vat of %s set to ferment there."
msgstr "Чан с ферментирующимся продуктом (%s)."

#: src/iexamine.cpp:3555
msgid "It will finish brewing in less than an hour."
msgstr "Брожение закончится менее, чем через час."

#: src/iexamine.cpp:3557
#, c-format
msgid "It will finish brewing in about %d hour."
msgid_plural "It will finish brewing in about %d hours."
msgstr[0] "Брожение закончится через %d час."
msgstr[1] "Брожение закончится через %d часа."
msgstr[2] "Брожение закончится через %d часов."

#: src/iexamine.cpp:3564
msgid "Finish brewing?"
msgstr "Закончить брожение?"

#: src/iexamine.cpp:3577
#, c-format
msgid "The %s is now ready for bottling."
msgstr "Продукт (%s) готов для розлива."

#: src/iexamine.cpp:3580
#, c-format
msgid "You remove the %s from the vat."
msgstr "Вы удаляете (%s) из чана."

#: src/iexamine.cpp:3594
#, c-format
msgid "There's a vat of fermented %s there."
msgstr "Чан с ферментированным продуктом (%s)."

#: src/iexamine.cpp:3649
msgid "This tank is empty."
msgstr "Кег пуст."

#: src/iexamine.cpp:3653
msgid "You have no biomass to ferment."
msgstr "У вас нет сусла для брожения."

#: src/iexamine.cpp:3669
msgid "Use which biomass?"
msgstr "Какой предмет использовать?"

#: src/iexamine.cpp:3671
#, c-format
msgid "Set %s in the tank?"
msgstr "Залить сусло (%s) в чан?"

#: src/iexamine.cpp:3686
#, c-format
msgid "This tank contains %s (%d), %0.f%% full."
msgstr "Кег содержит: %s (%d), %0.f%% наполнения."

#: src/iexamine.cpp:3692
#, c-format
msgid "Add more %s to the tank"
msgstr "Добавить ещё %s в чан"

#: src/iexamine.cpp:3694
#, c-format
msgid "Remove %s from the tank"
msgstr "Убрать содержимое (%s) из чана"

#: src/iexamine.cpp:3695
msgid "Start anaerobic digestion"
msgstr "анаэробный варочный котел"

#: src/iexamine.cpp:3727
#, c-format
msgid "Set %s in the tank."
msgstr "Вы поместили сусло (%s) в чан."

#: src/iexamine.cpp:3728
#, c-format
msgid "The tank now contains %s (%d), %0.f%% full."
msgstr "Теперь кег содержит: %s(%d), %0.f%% наполнения."

#: src/iexamine.cpp:3735
msgid "Start anaerobic digestion?"
msgstr "анаэробный варочный котел"

#: src/iexamine.cpp:3742
msgid "The tank is full, so you close the lid and start anaerobic digestion."
msgstr "Бак полон, так что можете закрыть крышку и начать цикл ферментации."

#: src/iexamine.cpp:3744
msgid "You close the lid and start anaerobic digestion."
msgstr "Вы закрываете крышку и начинаете цикл ферментации."

#: src/iexamine.cpp:3766
#, c-format
msgid "You remove %s from the tank."
msgstr "Вы вытаскиваете содержимое (%s) из коптильни."

#: src/iexamine.cpp:3786
#, c-format
msgid "There's a tank of %s set to ferment there."
msgstr "Чан с ферментирующимся продуктом (%s)."

#: src/iexamine.cpp:3795
msgid "It will finish fermenting in less than an hour."
msgstr "Брожение закончится менее, чем через час."

#: src/iexamine.cpp:3797
#, c-format
msgid "It will finish fermenting in about %d hour."
msgid_plural "It will finish fermenting in about %d hours."
msgstr[0] "Брожение закончится через %d час."
msgstr[1] "Брожение закончится через %d часа."
msgstr[2] "Брожение закончится через %d часов."

#: src/iexamine.cpp:3801
#, c-format
msgid "It will finish fermenting in about %d day."
msgid_plural "It will finish fermenting in about %d days."
msgstr[0] "Брожение закончится через %d час."
msgstr[1] "Брожение закончится через %d часа."
msgstr[2] "Брожение закончится через %d часов."

#: src/iexamine.cpp:3806
msgid "Gather biogas?  Can't stop once releasing started."
msgstr "Собирать биогаз?  Не могу остановиться, как только начался релиз."

#: src/iexamine.cpp:3811
msgid "No biogas gathered."
msgstr "Здесь нет двери."

#: src/iexamine.cpp:3820 src/iexamine.cpp:3855
msgid "You released some biogas from the tank."
msgstr "Вы выпустили немного биогаза из резервуара."

#: src/iexamine.cpp:3824 src/iexamine.cpp:3859
#, c-format
msgid "Gathered %s units of biogas."
msgstr "Собрано %s единиц биогаза."

#: src/iexamine.cpp:3829
#, c-format
msgid "Biogas generating process started for about %d day."
msgid_plural "Biogas generating process started for about %d days."
msgstr[0] "Процесс выработки биогаза продолжался примерно %d день"
msgstr[1] "Процесс выработки биогаза продолжался примерно %d дня"
msgstr[2] "Процесс выработки биогаза продолжался примерно %d дней"

