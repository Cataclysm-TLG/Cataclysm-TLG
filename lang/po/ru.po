#. ~ NPC dialogue line
#: data/json/npcs/hub01/ROBOFAC_SURFACE_FREEMERCHANT.json
msgid "Around <interval>, if the caravan doesn't run into trouble."
msgstr "Где-то через <interval>, если караван не попадёт в беду."

#. ~ Name of an NPC class
#. ~ This is a unique NPC who doesn't get randomly selected background traits
#: data/json/npcs/hub01/ROBOFAC_SURFACE_FREEMERCHANT.json
