msgstr[0] "Лутый ППМ"
msgstr[1] "Лутый ППМ"
msgstr[2] "Лутый ППМ"

#. ~ Description of gun "SIG Pro pistol"
#. ~ Description of "SIG Pro pistol"
#: data/json/items/gun/40.json
msgid ""
"Originally marketed as a lightweight and compact alternative to older SIG "
"handguns, the Pro .40 is popular among European police forces."
msgstr ""
"Позиционируется как лёгкая и компактная альтернатива предыдущим моделям "
"пистолетов SIG. Pro .40 популярен среди европейских правоохранительных "
"структур."

#. ~ Item name
#. ~ Name of a gun
#: data/json/items/gun/40.json data/json/items/gun/9mm.json
