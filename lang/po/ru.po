msgstr ""

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "PALS_LARGE"
#: data/json/flags/flags.json
msgid ""
"This item will <good>attach directly</good> to <info>load bearing vests</"
