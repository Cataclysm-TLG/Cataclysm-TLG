msgstr "Брось все предметы, которые не используешь."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Favor me (+10 favors)."
msgstr "Симпатизируй мне (+10 симпатии)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Fear me (+10 fear)."
msgstr "Бойся меня (+10 страха)."

