#, c-format
msgctxt "furniture, item"
msgid "Not enough space on the %1$s. You drop the %2$s on the ground."
msgstr "Недостаточно места на (%1$s). Вы бросаете предмет (%2$s) на землю."

#: src/crafting.cpp:874
#, c-format
msgctxt "furniture, item"
msgid "Not enough space on the %1$s. <npcname> drops the %2$s on the ground."
msgstr ""
