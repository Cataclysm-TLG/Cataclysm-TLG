"Risk: Very High\n"
"Intensity: Brisk\n"
"Time: Travel\n"
"Positions: %d/3\n"
msgstr ""

#: src/faction_camp.cpp:1023
msgid " Recover Combat Patrol"
msgstr " Вернуть патруль"

#: src/faction_camp.cpp:1033
msgid ""
"Notes:\n"
"Plow any spaces that have reverted to dirt or grass.\n"
"\n"
msgstr ""
