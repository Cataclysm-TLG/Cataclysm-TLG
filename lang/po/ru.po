#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Do a seminar."
msgstr "Проведи тренировочное занятие."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Do not be angry (-10 anger)."
msgstr "Не злись (-10 гнев)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Do not favor me (-10 favors)."
msgstr "Не симпатизируй мне (-10 симпатии)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Do not fear me (-10 fear)."
msgstr "Не бойся меня (-10 страха)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
msgid "Do not owe me (-10 owed)."
msgstr "У тебя нет долга передо мной (-10 чувство долга)."

#. ~ Response to NPC dialogue
#: data/json/npcs/common_chat/TALK_COMMON_ALLY.json
