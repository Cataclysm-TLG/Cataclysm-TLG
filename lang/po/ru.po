msgstr "Вы кладёте (%1$s) на рабочую поверхность (%2$s)."

#: src/crafting.cpp:863 src/crafting.cpp:885
#, c-format
msgctxt "item, furniture"
msgid "<npcname> puts the %1$s on the %2$s."
msgstr "<npcname> кладёт (%1$s) на рабочую поверхность (%2$s)."

