msgstr "Вы заканчиваете вспахивать участок земли."

#: src/activity_actor.cpp:7808
#, c-format
msgid "You clear up the %s."
msgstr "Вы расчистили завал (%s)."

#: src/activity_actor.cpp:8011 src/activity_actor.cpp:8025
#, c-format
