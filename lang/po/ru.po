#. ~ Said when a hostile NPC completes mugging the player
#: data/json/npcs/talk_tags.json
msgid "Thanks for the cash, <name_b>!"
msgstr "Спасибо за наличку, <name_b>!"

#. ~ Snippet in category "<done_mugging>"
#. ~ Said when a hostile NPC completes mugging the player
#: data/json/npcs/talk_tags.json
