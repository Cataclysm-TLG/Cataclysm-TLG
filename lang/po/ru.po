#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid ""
"\"A fisherman hauled it in.  Lucky for us, he called the coast guard.  Yeah, "
"I'd hate to be him right about now.\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Affirmative.\""
msgstr "«Подтверждаю.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"And that's supposed to comfort me?\""
msgstr "«Этим ты хотел меня успокоить?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Anything else?\""
msgstr "«Что-нибудь ещё?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you alone?\""
msgstr "«Ты одинок или есть кто?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you busy at the moment?\""
msgstr "«Ты сейчас занят?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you busy later?\""
msgstr "«Чуть позже ты освободишся?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you busy tonight?\""
msgstr "«Ты занят сегодня вечером?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you feeling all right?\""
msgstr "«С тобой всё в порядке?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you free tonight?\""
msgstr "«Ты свободен сегодня вечером?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you going to help them?\""
msgstr "«Вы собираетесь помочь им?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you going to the party tonight?\""
msgstr "«Может потусуемся вечерком?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you hungry?\""
msgstr "«Ты голоден?»"

#. ~ Speech from speaker talking_doll, mon_mi_go, mon_mi_go_abductor, mon_mannequin_decoy
#: data/json/speech.json
msgid "\"Are you my mommy?\""
msgstr "«Ты моя мамочка?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you seeing anyone?\""
msgstr "«С кем-нибудь встречаешься?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Are you sure?\""
msgstr "«Уверен?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Area nineteen has a few in cold storage.\""
msgstr "«В зоне девятнадцать есть несколько, в холодильнике.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"At least we know they can die.\""
msgstr "«По крайней мере, мы знаем, что они могут сдохнуть.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Be careful out there.\""
msgstr "«Будь осторожнее.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Be quiet.\""
msgstr "«Тихо.»"

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Big Brother is watching you…\""
msgstr "«Большой Брат следит за тобой…»"

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Blood… delicious.\""
msgstr "«Кровь… Вкуснятина.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Boss wants you.\""
msgstr ""

#. ~ Speech from speaker mon_mutant_experimental, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Burning… from the inside…\""
msgstr "«Горю… изнутри…»"

#. ~ Speech from speaker mon_shoggoth, mon_mi_go, mon_mi_go_abductor, mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"C-can't…\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Call an ambulance!\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Call an ambulance.\""
msgstr "«Вызовите скорую помощь.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Call an ambulance…But not for me!\""
msgstr ""

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Call me.\""
msgstr "«Позвони мне.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Call the police.\""
msgstr "«Позвоните в полицию.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can I help you?\""
msgstr "«Вам помочь?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can I see your phone?\""
msgstr "«Можно глянуть на твой телефон?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can you help me?\""
msgstr "«Можешь мне помочь?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can you repeat that?\""
msgstr "«Можешь повторить?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can you swim?\""
msgstr "«Ты можешь плыть?»"

#. ~ Speech from speaker mon_broken_cyborg, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Can't… breathe…\""
msgstr "«Не могу… дышать…»"

#. ~ Speech from speaker mon_civilian_zombiefighter
#: data/json/speech.json
msgid "\"Come get some!\""
msgstr "«Приходи, возьми!»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Come here!\""
msgstr "«Иди сюда!»"

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Come on, come on, they can help us!\""
msgstr "«Давай, давай, они помогут нам!»"

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Come on, wake up…\""
msgstr "«Ну давай, просыпайся…»"

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Cover your head, everyone!\""
msgstr "«Все, прикройте головы!»"

#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Dad-a-chak?\""
msgstr "«Дад-а-чак?»"

#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Dad-a-cham?\""
msgstr "«Дад-а-чам?»"

#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Dad-a-chuk?\""
msgstr "«Дад-а-чук?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Damn it!\""
msgstr "«Чёрт возьми!»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Damn it.\""
msgstr "«Чёрт возьми.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi-go_surgeon
#: data/json/speech.json
msgid "\"Did you see what they did to him?\""
msgstr "«Ты видел, что они с ним сделали?»"

#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Did-a-chak?\""
msgstr "«Дид-а-чак?»"

#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Did-a-chuk?\""
msgstr "«Дид-а-чук?»"

#. ~ Speech from speaker mon_mi_go_surgeon, mon_mi_go_guard, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Did-a-chum?\""
msgstr "«Дид-а-чам?»"

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Die for me!\""
msgstr "«Умри за меня!»"

#. ~ Speech from speaker mon_civilian_zombiefighter
#: data/json/speech.json
msgid "\"Die!\""
msgstr "«Умри!»"

#. ~ Speech from speaker mon_civilian_zombiefighter
#: data/json/speech.json
msgid "\"Die, zombie scum!\""
msgstr "«Сдохни, зомбированная мразь!»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Do not reach for your pockets!\""
msgstr "«Уберите руки от карманов!»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_surgeon
#: data/json/speech.json
msgid "\"Do they even have sex?\""
msgstr "«Они вообще могут трахаться?»"

#. ~ Speech from speaker creepy_doll, mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Do you really need that much honey?\""
msgstr "«Тебе точно нужно столько мёда?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Do you smoke?\""
msgstr "«Ты куришь?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Do you understand what I'm saying?\""
msgstr "«Ты понимаешь, что я говорю?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Does it scare you?\""
msgstr "«Это вас пугает?»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Don't do that.\""
msgstr "«Не делай так.»"

#. ~ Speech from speaker mon_memory
#: data/json/speech.json
msgid "\"Don't look at the sky!\""
msgstr "«Не смотри на небо!»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
#: data/json/speech.json
msgid "\"Don't worry, it can't hurt us.\""
msgstr "«Не беспокойся, оно не может причинить нам вреда.»"

#. ~ Speech from speaker mon_mi_go, mon_mi_go_abductor, mon_mi_go_myrmidon
