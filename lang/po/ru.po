#: src/computer_session.cpp:1471
msgid "Backup power status: STANDBY MODE."
msgstr "Статус резервного источника энергии: РЕЖИМ ОЖИДАНИЯ."

#: src/computer_session.cpp:1512 src/computer_session.cpp:1522
msgid "The console shuts down."
msgstr "Консоль выключается."

#: src/computer_session.cpp:1544
msgid "Manhacks drop from compartments in the ceiling."
msgstr "Мэнхаки вылетают из отсеков в потолке."

#: src/computer_session.cpp:1554
msgid "A secubot emerges from a compartment in the floor."
msgstr "Робохраны поднимаются из люков в полу."

#: src/computer_session.cpp:1560
