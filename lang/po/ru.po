#: data/json/furniture_and_terrain/special_use/bullet_trailer.json
msgid "trailer bed"
msgstr "кровать для трейлера"

#. ~ Furniture name
#: data/json/furniture_and_terrain/special_use/bullet_trailer.json
msgid "trailer cabinets"
msgstr "шкафы для прицепов"

#. ~ Furniture name
#: data/json/furniture_and_terrain/special_use/bullet_trailer.json
msgid "trailer sink"
msgstr "мойка прицепа"

#. ~ Furniture name
