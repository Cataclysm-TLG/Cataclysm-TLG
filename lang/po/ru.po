#. ~ Name of a gun
#: data/json/items/gun/762.json
msgid "Mk47 Mutant rifle"
msgid_plural "Mk47 Mutant rifles"
msgstr[0] "винтовка Mk47 Mutant"
msgstr[1] "винтовки Mk47 Mutant"
msgstr[2] "винтовок Mk47 Mutant"

#. ~ Description of gun "AKM rifle"
#. ~ Description of "AKM rifle"
#: data/json/items/gun/762.json
msgid ""
"One of the most recognizable assault rifles ever made, the AKM is renowned "
"for its durability even under the worst conditions."
msgstr ""
"Один из наиболее узнаваемых автоматов, АКМ славится своей способностью "
"сохранять работоспособность в самых суровых условиях."

#. ~ Item name
#. ~ Name of a gun
#: data/json/items/gun/762.json
msgid "SKS rifle"
msgid_plural "SKS rifles"
msgstr[0] "винтовка СКС"
msgstr[1] "винтовки СКС"
msgstr[2] "винтовок СКС"

