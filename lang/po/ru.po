msgstr "Таймер экспедиции"

#. ~ Clause text "safe_at_home" of UI widget "sky_island_expedition_timer"
#: data/mods/Sky_Island/ui.json
msgid "HOME SAFE"
msgstr "ДОМАШНИЙ СЕЙФ"

#. ~ Clause text "over_deadline_four" of UI widget "sky_island_expedition_timer"
#: data/mods/Sky_Island/ui.json
