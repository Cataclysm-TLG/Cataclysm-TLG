#: data/json/items/tool/woodworking.json
msgid "This chainsaw is on and making a lot of noise.  Use it to turn it off."
msgstr ""
"Бензопила включена и создаёт много шума. Активируйте её, чтобы выключить."

#. ~ Description of "electric chainsaw (on)"
#: data/json/items/tool/woodworking.json
msgid ""
"This electric chainsaw is on and making a lot of noise.  Use it to turn it "
"off."
msgstr ""
"Электропила включена и создаёт много шума. Активируйте её, чтобы выключить."

#. ~ Description of "pole saw (on)"
#: data/json/items/tool/woodworking.json
msgid "This pole saw is on and making a lot of noise.  Use it to turn it off."
msgstr ""
"Шестовая пила включена и издает много шума. Используйте её, чтобы выключить."

#. ~ value of variable 'success_message' in effect in EoC "EOC_toolweapon_activate__circsaw" in use action of item "circular saw (off)"
#: data/json/items/tool/woodworking.json
msgid "With a loud buzz, the <npc_name> roars to life!"
msgstr "<npc_name> оживает с громким визгом!"

#. ~ Player makes sound in effect in EoC "EOC_toolweapon_activate__chainsaw" in use action of item "chainsaw (off)"
#. ~ Player message in effect in EoC "EOC_toolweapon_activate__chainsaw" in use action of item "chainsaw (off)"
#. ~ Player makes sound in effect in EoC "EOC_toolweapon_activate__polesaw" in use action of item "pole saw (off)"
#. ~ Player message in effect in EoC "EOC_toolweapon_activate__polesaw" in use action of item "pole saw (off)"
