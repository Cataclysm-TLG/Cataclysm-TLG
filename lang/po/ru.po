msgstr "Вы не смогли установить модификацию (%s) и повредили оружие (%s)!"

#: src/activity_actor.cpp:8121
#, c-format
msgid "You failed at installing the %s."
msgstr "Вы не смогли установить модификацию (%s)."

#: src/activity_actor.cpp:8187
msgid "You finish salvaging."
msgstr "Вы закончили собирать добычу."

#: src/activity_actor.cpp:8427 src/activity_item_handling.cpp:2353
#, c-format
