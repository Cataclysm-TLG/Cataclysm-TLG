msgid "Thanks, I used it."
msgstr "Спасибо, я воспользуюсь этим."

#: src/dialogue_chatbin.h:149
msgid "Changed your mind?"
msgstr "Окей, проехали."

#: src/dialogue_chatbin.h:150
msgid "Are you <swear> insane!?"
msgstr "Ты, <swear>, совсем ку-ку?!"

#: src/dialogue_chatbin.h:151
msgid "Thanks, I'll wield that now."
msgstr "Спасибо, я буду использовать это в бою."

#: src/dialogue_chatbin.h:152
msgid "My current weapon is better than this.\n"
msgstr "Моё текущее оружие лучше, чем это.\n"

#: src/dialogue_chatbin.h:153
msgid "Thanks, I'll carry that now."
msgstr "Спасибо, я возьму это с собой."

#: src/dialogue_chatbin.h:154
msgid "I have no space to store it."
msgstr "У меня нету места для хранения."

#: src/dialogue_chatbin.h:155
#, c-format
msgid "I can only store %s %s more."
msgstr "Я могу взять ещё только %s %s."

#: src/dialogue_chatbin.h:157
msgid "…or to store anything else for that matter."
msgstr "… или хранить что-нибудь ещё, если на то пошло."

#: src/dialogue_chatbin.h:158
msgid "It is too heavy for me to carry."
msgstr "Это слишком тяжело для меня."

#: src/dialogue_chatbin.h:161
msgid "Thanks, I'll wear that now."
msgstr "Спасибо, я надену это."

