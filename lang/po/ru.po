#: src/iexamine.cpp:5614
#, c-format
msgid "The Autodoc is working on %s."
msgstr "Автодок работает. Пациент: %s."

#: src/iexamine.cpp:5619
msgid "Autodoc Mk. XI.  Status: Online.  Please choose operation"
msgstr "Автодок Mk. XI. Статус: В работе. Пожалуйста, выберите операцию."

#: src/iexamine.cpp:5623
