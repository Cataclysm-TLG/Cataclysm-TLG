msgstr "резиновая мульча"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "stone masonry floor"
msgstr "пол из каменной кладки"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
msgid "upturned dirt"
msgstr "вскопанная земля"

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-floors-outdoors.json
